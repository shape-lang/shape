// ADR-020 §3.3 (#224): void calls interleaved with value-returning calls.
// The returned slot must survive the void call untouched — this is the
// bit-equality-on-returned-slots case for the unit step.
fn note(x: int) { print(x) }
fn twice(x: int) -> int {
    note(x)
    return x * 2
}
fn run(n: int) -> int {
    let mut acc = 0
    let mut i = 0
    while i < n {
        note(i)
        acc = acc + twice(i)
        note(acc)
        i = i + 1
    }
    return acc
}
print(run(4))
