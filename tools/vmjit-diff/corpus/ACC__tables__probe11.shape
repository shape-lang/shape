from std::core::queryable use { Queryable }
type Event { id: int, value: number, tag: string }
impl Queryable for Table {
    method orderBy(key_fn, direction) { self.orderBy(key_fn, direction) }
    method forEach(f) { self.forEach(f) }
    method execute() { self }
}
fn main() {
  let events: Table<Event> =
      [3, 120.0, "gamma"],
      [1, 50.0,  "alpha"],
      [2, 75.5,  "beta"]
  let mut acc: Vec<number> = []
  events.orderBy(|row| row.value, "desc").forEach(|row| acc.push(row.value))
  print(acc)
}
main()
