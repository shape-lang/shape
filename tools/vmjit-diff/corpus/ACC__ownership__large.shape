//                                MAIN
// =====================================================================

scenario_copy()
scenario_clone_independence()
scenario_call_share()
scenario_references()
scenario_store()
scenario_timeline()
scenario_pipeline()
scenario_contrast()
scenario_strings()
scenario_checksum()
scenario_snapshot()
scenario_clone_chain()
scenario_functional()
scenario_ledger()

print(f"PASS={g_pass} FAIL={g_fail}")
if g_fail == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print("SOME_CHECKS_FAILED")
}
