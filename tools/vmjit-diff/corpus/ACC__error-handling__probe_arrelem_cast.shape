from std::core::intrinsics use { Result, Option, AnyError, Ok, Err }

// Probe: does `as int?` work on a string read directly from Array<string>?
let arr: Array<string> = ["42", "x"];

// direct array element, book-faithful: (elem as int?)
fn conv(tok: string) -> Result<int> {
    return (tok as int?);
}

match conv(arr[0]) {
    Ok(v) => print(f"arr0 ok {v}"),
    Err(e) => print("arr0 err"),
}
match conv(arr[1]) {
    Ok(v) => print(f"arr1 ok {v}"),
    Err(e) => print("arr1 err"),
}

// also: iterate and cast directly
for piece in arr {
    match (piece as int?) {
        Ok(v) => print(f"iter ok {v}"),
        Err(e) => print("iter err"),
    }
}
