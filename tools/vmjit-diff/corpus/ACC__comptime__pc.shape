comptime fn gcd(a: int, b: int) -> int {
  let mut x = a
  let mut y = b
  while y != 0 {
    let t = y
    y = x % y
    x = t
  }
  x
}
comptime fn is_prime(n: int) -> bool {
  if n < 2 { return false }
  let mut i = 2
  while i * i <= n {
    if n % i == 0 { return false }
    i = i + 1
  }
  true
}
comptime fn build_csv(n: int) -> string {
  let mut s = ""
  let mut i = 1
  while i <= n {
    if i > 1 { s = s + "," }
    s = s + f"{i}"
    i = i + 1
  }
  s
}
let G = comptime { gcd(48, 36) }
let P = comptime { is_prime(97) }
let P2 = comptime { is_prime(91) }
let C = comptime { build_csv(5) }
print(f"G={G}")
print(f"P={P}")
print(f"P2={P2}")
print(f"C={C}")
