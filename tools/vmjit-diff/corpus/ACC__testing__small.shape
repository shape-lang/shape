// small.shape — Slice: testing
// Book-primary source: stdlib/core/testing.mdx
//
// Exercises the core of the testing chapter: assert, assert_eq, assert_ne,
// assert_approx. We build a tiny embedded "suite": each check returns a
// Result<bool,string> (testing.mdx lines 9-11), and we count Ok vs Err to
// prove the determinism strategy for this slice ("assert pass/fail counts of
// an embedded suite").
//
// NOTE on idiom: the book's "Test Suite" example (testing.mdx 89-107) places
// assertions INSIDE `fn test_*()` bodies. That form does not run on this build
// (imported assertion fns are "Undefined" in a fn body / value position — see
// REPORT.md BOOK-WRONG #2). The forms used here — bare top-level
// expression-statements with `?`, and inspecting the returned Result by name —
// are the working subset taught by testing.mdx lines 9-11 + 76-85.

from std::core::utils::testing use { assert, assert_eq, assert_ne, assert_approx }

// ---- domain under test: a couple of pure helpers ----
fn add(a: int, b: int) -> int { a + b }
fn classify(n: int) -> string {
    if n < 0 { "neg" } else if n == 0 { "zero" } else { "pos" }
}

// ---- embedded suite: collect each assertion's Result, then count ----
// testing.mdx 9-11: each assertion returns Ok(true) on success, Err(msg) on
// failure. We exploit that to make a deterministic pass-count proof.
let checks: Array<Result<bool, string>> = [
    assert(add(2, 3) > 0, "sum positive"),          // Ok
    assert_eq(add(2, 3), 5, "addition works"),      // Ok  (book line 37)
    assert_eq(classify(-4), "neg"),                 // Ok
    assert_eq(classify(0), "zero"),                 // Ok
    assert_eq(classify(7), "pos"),                  // Ok
    assert_ne(add(1, 1), 3, "must differ"),         // Ok  (book line 46)
    assert_approx(10.0 / 3.0, 3.3333, 0.001),       // Ok  (book line 56, tol form 57)
    assert_eq(add(2, 2), 5, "intentional fail"),    // Err — deliberately wrong
]

var passed = 0
var failed = 0
for c in checks {
    if c.isOk() { passed = passed + 1 } else { failed = failed + 1 }
}

// Expected values derived BEFORE running, from book semantics:
//   7 assertions hold (Ok), 1 deliberately fails (Err).
assert_eq(passed, 7, "passed count")?
assert_eq(failed, 1, "failed count")?

// The default tolerance for assert_approx is 1e-10 (book line 53): a tighter
// pair must still hold within an explicit small tolerance.
assert_approx(0.1 + 0.2, 0.3, 0.0000001)?

print(f"suite: {passed} passed, {failed} failed (expected 7 / 1)")
print("ALL_CHECKS_PASSED")
