trait Display {
  fn display() -> string;
}

type User { name: string }

impl Display for User {
  method display() -> string { self.name }
}

fn print_all(items: Vec<dyn Display>) {
  for item in items {
    print(item.display())
  }
}

let users = [User { name: "Alice" }, User { name: "Bob" }]
print_all(users)
