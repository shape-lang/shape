# Rust
/target/
**/target/

# Generated extension artifacts (.so / .dylib)
**/*.so
**/*.dylib

# Node / frontend
**/node_modules/
**/dist/
**/.astro/
# Symlink into ../shape-web/book/book-site/node_modules — the `**/node_modules/`
# pattern above only matches directories, so the symlink needs its own rule.
/node_modules

# Python bytecode from scripts/
**/__pycache__/

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local env
.env
.env.*

# Claude Code workspace state — agent worktrees and runtime locks
.claude/worktrees/
.claude/scheduled_tasks.lock

# Locally-installed agent skills. `.agents/skills/` holds the payloads,
# `.claude/skills/` symlinks to them, `skills-lock.json` pins them — all three
# are per-machine tooling state, not project source.
/.agents/
/.claude/skills/
/skills-lock.json

# Hardening (4) Option B — per-worktree .envrc + direnv cache.
# Per-worktree infrastructure auto-generated by
# scripts/create-agent-worktree.sh; never committed.
.envrc
.direnv/

# shape-fuzz harness findings (W13) — per-run artifacts, not committed.
# Audit §6.4 picks GitHub Actions artifact upload (30-day retention) for
# nightly findings; local dev runs leave per-invocation files behind.
tools/shape-fuzz/findings/
