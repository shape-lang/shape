/// Mark a function as a cached technical indicator.
///
/// Indicator functions compute technical-analysis values from price data.
/// This annotation registers the function in the indicator registry and enables
/// memoization across repeated calls with the same arguments.
///
/// @note The annotation contributes lifecycle hooks, but the annotated
/// function remains the source of truth for its own API signature and docs.
/// @see std::finance::annotations::warmup::@warmup
/// @example
/// @indicator
/// @warmup(14)
/// pub fn rsi(data: Column<number>, period: number) -> number {
///     let gains = data.diff().map(d => d > 0 ? d : 0)
///     let losses = data.diff().map(d => d < 0 ? abs(d) : 0)
///     let avg_gain = gains.rolling(period).mean()
///     let avg_loss = losses.rolling(period).mean()
///     let rs = avg_gain / avg_loss
///     return 100 - (100 / (1 + rs))
/// }
// DARK WINDOW (ADR-009 C3-S6 / same class as C3-G14): the former `before`/
// `after` cache hooks rode the deleted legacy runtime-hook surface (`ctx`
// registry access + the cached-result before-short-circuit — the HookDecision
// protocol, E4's charter) and were REMOVED with the C3-S6 classification
// collapse. The memoization capability returns when E4 lands the typed
// HookDecision protocol — see GitHub issue #68. The `on_define` registry
// registration (`ctx`/`self` runtime-context family) is the same class and
// went dark with them. The lifecycle `metadata()` handler survives on the
// collapsed surface.
pub annotation indicator() {
    // Return static metadata
    metadata() {
        return {
            is_indicator: true,
            cacheable: false,
            pure: true
        }
    }
}
