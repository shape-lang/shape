/// @module std::serde::serialize
/// Derive-style JSON serialization at compile time.
///
/// `@to_json` reads a type's declared fields via comptime introspection and
/// generates a `to_json()` method on the type that serializes a value to a
/// JSON object string. The serializer is generated from the fields, so it can
/// never drift from the type.
///
/// # Example
///
/// ```shape
/// from std::serde::serialize use { @to_json }
///
/// @to_json()
/// type User { id: int, name: string }
///
/// let u = User { id: 1, name: "Ada" }
/// print(u.to_json())   // { "id": 1, "name": "Ada" }
/// ```

/// `@to_json` — generate a `to_json() -> string` method on the type that
/// serializes a value to a JSON object string. String fields are quoted;
/// `int` / `number` / `bool` fields are emitted bare. A field whose type has no
/// JSON representation is a compile error naming the field.
pub annotation to_json() on type {
    comptime post(target, ctx) {
        // ADR-009 E2 #18 slice 4.5 (E2-Q2/B): build a TYPED template for the
        // `extend_method` producer instead of generating source text. `segments`
        // are the literal JSON punctuation between splices; `field_splices` are
        // the field NAMES the producer emits as `{self.<field>}` holes (asserted
        // identifiers at the builtin boundary). `extend_method` assembles the
        // native f-string body `{ "f": {self.f}, ... }` and the extend-method AST
        // directly — no source string, no reparse. Strict interleave invariant:
        // segments.len() == field_splices.len() + 1.
        //
        // An EMPTY typed-array literal init (`let x: Array<string> = []`) is not
        // available in comptime ([C0001]); non-empty-init + `.push()` is. So both
        // arrays are SEEDED non-empty from the FIRST field's REAL data (captured
        // by iteration, no indexing) before the append loop — no placeholder ever
        // reaches `extend_method`. A 0-field type would need an empty
        // field_splices array and is rejected below (see the slice report; the
        // retired string-concat serializer produced `{  }` for it).
        let mut first_name = ""
        let mut first_type = ""
        let mut have_first = false
        for field in target.fields {
            let is_string = field.type == "string"
            if !is_string && field.type != "int" && field.type != "number" && field.type != "bool" {
                error(f"@to_json: field '{field.name}' has type '{field.type}', which has no JSON representation")
            }
            if !have_first {
                first_name = field.name
                first_type = field.type
                have_first = true
            }
        }
        if !have_first {
            error(f"@to_json on '{target.name}' requires at least one field")
        }

        // Seed from the first field's real data (never a sentinel): its leading
        // punctuation segment + its name splice.
        let first_is_string = first_type == "string"
        let mut seg = "{ "
        if first_is_string {
            seg = f"{seg}\"{first_name}\": \""
        } else {
            seg = f"{seg}\"{first_name}\": "
        }
        let mut segments = [seg]
        let mut field_splices = [first_name]
        // Punctuation AFTER the first splice starts the next segment.
        if first_is_string {
            seg = "\""
        } else {
            seg = ""
        }

        // Append every field AFTER the first (skipped by the flag, not by
        // indexing). Each contributes a `, ` separator + `"name": ` (+ opening
        // quote for a string), its name splice, then a closing quote or empty.
        let mut is_first = true
        for field in target.fields {
            if is_first {
                is_first = false
            } else {
                let is_string = field.type == "string"
                seg = f"{seg}, "
                if is_string {
                    seg = f"{seg}\"{field.name}\": \""
                } else {
                    seg = f"{seg}\"{field.name}\": "
                }
                segments.push(seg)
                field_splices.push(field.name)
                if is_string {
                    seg = "\""
                } else {
                    seg = ""
                }
            }
        }
        // Trailing segment: close the object.
        seg = f"{seg} \}"
        segments.push(seg)
        // Emit a `to_json()` method on the type (implicit `self` receiver), so
        // callers write `value.to_json()`.
        extend (extend_method(target.name, "to_json", "string", segments, field_splices))
    }
}
