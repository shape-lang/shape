/// @module std::core::remote
/// Remote Execution for Shape Serve
///
/// High-level API for executing Shape code on remote `shape serve` instances.
/// Handles wire protocol encoding, transport, and response decoding automatically.
///
/// Address strings keep the existing bare TCP form (`"host:port"`). To require
/// TLS, use `shape+tls://host:port?ca=/path/to/cert.pem`; pass
/// `server_name=name` when connecting to an IP address whose certificate is
/// issued for a DNS name. TLS calls always verify the certificate against the
/// supplied trust root; there is no insecure/skip-verify mode.
///
/// # Example
///
/// ```shape
/// let result = remote.execute("127.0.0.1:9527", "1 + 2 + 3")
/// match result {
///     Ok(r) => print(f"Result: {r["value"]}")
///     Err(e) => print(f"Error: {e}")
/// }
/// ```

/// Execute Shape source code on a remote `shape serve` instance.
///
/// Sends the code string to the server, which compiles and executes it,
/// returning the structured result value, any captured stdout, and
/// error information.
///
/// # Arguments
///
/// * `addr` - Server address as `host:port` (e.g. `"127.0.0.1:9527"`)
/// * `code` - Shape source code to execute remotely
///
/// # Returns
///
/// `Ok({ value, stdout, error })` on success, `Err(message)` on transport/protocol failure.
/// The `value` field contains the structured return value (not a string).
/// The `stdout` field contains any `print()` output (or null if none).
///
/// # Example
///
/// ```shape
/// let r = remote.execute("localhost:9527", "fn add(a, b) { a + b }\nadd(10, 32)")
/// match r {
///     Ok(result) => print(f"Value: {result["value"]}")  // 42
///     Err(e) => print(f"Failed: {e}")
/// }
/// ```
pub builtin fn execute(addr: string, code: string) -> Result<HashMap<string, _>, string>;

/// Ping a remote Shape server to check connectivity and get server info.
///
/// # Arguments
///
/// * `addr` - Server address as `host:port`
///
/// # Returns
///
/// `Ok({ shape_version, wire_protocol })` with server version info,
/// or `Err(message)` if the server is unreachable.
///
/// # Example
///
/// ```shape
/// match remote.ping("localhost:9527") {
///     Ok(info) => print(f"Server v{info["shape_version"]}")
///     Err(e) => print(f"Server down: {e}")
/// }
/// ```
pub builtin fn ping(addr: string) -> Result<HashMap<string, _>, string>;

/// Internal compiler-elaborated sibling of the public `remote::call` primitive
/// (Q35 / OQ-11). Retired name: `__call` — the `__` dunder marks this as
/// internal/compiler-generated machinery (like `__into_*`), reachable by the
/// `@remote` annotation's specialized before-hook but never documented as user
/// API. The public, recoverable-error primitive is `remote::call` (returns
/// `Result<R, RemoteError>`); this `_raising` sibling maps transport/protocol
/// failures onto an ordinary runtime error (Q26).
///
/// Low-level transport used by the `@remote` annotation. Serializes the
/// function reference (resolved to its content hash + minimal transitive blob
/// closure) and arguments via the wire protocol and sends them to the remote
/// `shape serve` node.
///
/// # Arguments
///
/// * `addr` - Server address as `host:port`
/// * `fn_ref` - Function reference to call remotely
/// * `args` - Arguments to pass to the remote function
///
/// Returns the callee's value directly (typed at the callee's declared return
/// type via compiler elaboration). Transport / protocol / remote failures raise
/// as an ordinary runtime error (Q26) rather than surfacing a `Result` — the
/// recoverable structured surface is the public `remote::call` primitive.
builtin fn __call_raising(addr: string, fn_ref: _, args: Array<_>) -> _;

/// Internal compiler-elaborated sibling backing the public, recoverable
/// `remote::call` primitive (Q26 / distributed §4.9 / FIX C). Like
/// `__call_raising` it performs the per-function transfer + wire round-trip,
/// but instead of raising on failure it returns a real `Result<R, RemoteError>`
/// value: success is `Ok(R)` (typed at the callee's declared return type via
/// the compiler's `remote::call` elaboration), and every transport / protocol
/// / remote failure is `Err(RemoteError::…)` per the §4.9 normative mapping.
///
/// User code never names this dunder directly — it writes
/// `remote::call(addr, fn, args…)`, which the compiler lowers to this builtin
/// and types at `Result<R, RemoteError>`.
builtin fn __call_result(addr: string, fn_ref: _, args: Array<_>) -> _;

/// Internal compiler-elaborated sibling backing the public
/// `remote::call_async` primitive. It starts the same recoverable remote call
/// as `__call_result` on the VM's external-completion scheduler and returns a
/// `Future<Result<R, RemoteError>>` handle immediately. User code never names
/// this dunder directly; it writes `remote::call_async(addr, fn, args…)`.
builtin fn __call_async_result(addr: string, fn_ref: _, args: Array<_>) -> _;

/// Structured error returned by the recoverable `remote::call` primitive
/// (Q26 / distributed §4.2). Every transport, protocol, permission, and remote
/// failure maps onto exactly one variant (the normative §4.9 mapping), so
/// userland retry / load-balancing / idempotency annotations `match` on
/// variants — they never parse error-message text.
///
/// The **pre-send / post-send split** is load-bearing (§4.9): `Transport` is a
/// PRE-send failure — the request frame was never fully written, so the call
/// provably did NOT execute and is retry-safe. `ConnectionLost` and `Timeout`
/// are POST-send — the frame went out before the reply was lost, so the call
/// MAY have executed and must never be auto-retried. A variant-trusting retry
/// annotation depends on this boundary to avoid re-running non-idempotent
/// calls.
enum RemoteError {
    /// PRE-SEND: connect refused / DNS failure / send failure / payload over
    /// the transport cap — the request was never fully sent; the call did NOT
    /// execute. Safe to retry.
    Transport { message: string },
    /// POST-SEND: the connection was closed or reset AFTER the request frame
    /// was fully written, before a reply arrived — the call MAY have executed.
    ConnectionLost { message: string },
    /// POST-SEND: sender-side read timeout — the call MAY have executed.
    Timeout { message: string },
    /// The receiver refused the function's required permissions against its
    /// own granted set. `missing` is the permission names the server does not
    /// grant (e.g. `["fs.write"]`).
    PermissionDenied { missing: Array<string> },
    /// The server requires authentication and the token was missing or
    /// rejected — a distinct, user-actionable class (pass / refresh a token).
    AuthRequired { message: string },
    /// The receiver could not find the named function.
    MissingFunction { name: string },
    /// Remote execution exceeded the receiver's `ResourceLimits`
    /// (incl. wall-time overrun, `limit == "wall_time"`).
    ResourceLimitExceeded { limit: string },
    /// Wire / call-format / protocol version mismatch.
    VersionSkew { server: int, client: int },
    /// A closure capture was refused. `name` is the captured VARIABLE name
    /// (never a slot index); `reason` states why plus a remediation.
    UnsupportedCapture { name: string, reason: string },
    /// Transfer-integrity class: blob hash mismatch, malformed request,
    /// retry-exhausted missing blobs, or a call-ABI (arity / arg-kind /
    /// return-kind) mismatch.
    Protocol { message: string },
    /// The callee's OWN runtime error surfaced back to the caller.
    Remote { message: string },
}

/// Ship execution to a remote `shape serve` node.
///
/// When applied to a function, calling that function will transparently
/// execute it on the specified remote server instead of locally.
///
/// # Example
///
/// ```shape
/// use std::core::remote
///
/// @remote("worker:9527")
/// fn compute(data) { /* ... */ }
///
/// let result = compute([1, 2, 3])
/// ```
pub annotation remote(addr) {
    targets: [function]
    before(args, ctx) {
        // §4.1.5 / OQ-12: `ctx.target` is a typed function value statically
        // bound to the annotated function's original implementation. No
        // stringly `ctx["__impl"]` lookup and NO `?? args[0]` fallback — an
        // unavailable target binding is an annotation-machinery bug that must
        // fail loudly, never silently misdispatch a call argument as the callee.
        let result = __call_raising(addr, ctx.target, args)
        { result: result }
    }
}
