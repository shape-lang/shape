// Charter workload: strings — build, split, case-fold, filter, re-join.
// Checksum: total length of the rebuilt records.
fn make_record(i: int) -> string {
    return f"id{i},name-{i},{i * 7},tag{i % 13}"
}

fn transform(rounds: int, per_round: int) -> int {
    let mut total = 0
    let mut r = 0
    while r < rounds {
        let mut i = 0
        while i < per_round {
            let rec = make_record(i)
            let fields = rec.split(",")
            let upper = fields[1].toUpperCase()
            let rebuilt = fields[0] + "|" + upper + "|" + fields[3]
            total = total + rebuilt.len()
            i = i + 1
        }
        r = r + 1
    }
    return total
}

print(transform(192, 2000))
