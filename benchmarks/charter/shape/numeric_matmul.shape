// Charter workload: numeric kernel — dense square matrix multiply over
// `Array<number>` (contiguous f64). Indexed reads/writes in a 3-deep loop nest.
// Checksum: trace of the product, rounded to an integer.
fn build(n: int, seed: number) -> Array<number> {
    let mut out: Array<number> = []
    let mut i = 0
    while i < n * n {
        out.push(((i % 17) as number) * seed + 1.0)
        i = i + 1
    }
    return out
}

fn matmul(n: int) -> number {
    let a = build(n, 0.5)
    let b = build(n, 0.25)
    let mut c: Array<number> = []
    let mut z = 0
    while z < n * n {
        c.push(0.0)
        z = z + 1
    }
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            let mut sum = 0.0
            let mut k = 0
            while k < n {
                sum = sum + a[i * n + k] * b[k * n + j]
                k = k + 1
            }
            c[i * n + j] = sum
            j = j + 1
        }
        i = i + 1
    }
    let mut trace = 0.0
    let mut d = 0
    while d < n {
        trace = trace + c[d * n + d]
        d = d + 1
    }
    return trace
}

print(matmul(260) as int)
