// Probe string features per book
let s = "hello world"
print(s.length)                       // 11
print(s.contains("world"))            // true
print(s.split(" ").length)            // 2
print(s.substring(0, 5))              // hello
print("  HI  ".trim())                // HI
print("abc".toUpperCase())            // ABC
print("ABC".toLowerCase())            // abc
print("a,b,c".replace(",", "-"))      // a-b-c
print(["x","y","z"].join(","))        // x,y,z
print(s[0])                            // h (char index)
let name = "Shape"
print(f"hi {name}")                   // hi Shape
let p = 12.3456
print(f"p={p:fixed(2)}")              // p=12.35
print(f"braces: {{value}}")           // braces: {value}
let tri = """
    line1
    line2
    """
print(tri)
