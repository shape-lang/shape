// small.shape — types-primitive slice
// Exercises the core of fundamentals/builtin-types.mdx + fundamentals/integer-types.mdx:
//   scalar types (int, number, bool, string), width-typed integer literals,
//   literal suffixes (incl. hex/bin/oct combos), and `as` bit-level casting.
//
// The book does not teach an `assert` builtin (confirmed: not in prelude), so we
// self-check with a `check` helper that prints CHECK_FAILED on any mismatch and
// only reaches ALL_CHECKS_PASSED if every check holds.

let mut failures = 0

fn check_int(got: int, want: int, name: string) {
  if got != want {
    print(f"CHECK_FAILED: {name} expected={want} got={got}")
    failures = failures + 1
  }
}

fn check_num(got: number, want: number, name: string) {
  if got != want {
    print(f"CHECK_FAILED: {name} expected={want} got={got}")
    failures = failures + 1
  }
}

fn check_bool(got: bool, want: bool, name: string) {
  if got != want {
    print(f"CHECK_FAILED: {name} expected={want} got={got}")
    failures = failures + 1
  }
}

// --- Scalar: int (i64, signed). builtin-types.mdx "Scalar Types"; integer-types.mdx "The int Type" ---
let x = 42            // int
let y = -1000         // int
check_int(x + y, -958, "int_add")

// integer-types.mdx: big literal within i64 range stores exactly
let big = 9000000000000000000
check_int(big - 9000000000000000000, 0, "int_big_exact")

// --- Scalar: number (f64). builtin-types.mdx "Scalar Types" ---
let n: number = 2.5
check_num(n + 1.0, 3.5, "number_add")

// --- Scalar: bool ---
let b: bool = true
check_bool(!b, false, "bool_not")

// --- Literal suffixes. integer-types.mdx "Literal Suffixes" ---
// Each width-typed literal is in-range, so its value equals the plain integer.
let a = 42i8
check_int(a as int, 42, "i8_suffix")
let c = 255u8
check_int(c as int, 255, "u8_suffix")
let d = 1000i16
check_int(d as int, 1000, "i16_suffix")
let e = 100i32
check_int(e as int, 100, "i32_suffix")
let f = 3000000u32
check_int(f as int, 3000000, "u32_suffix")

// Hex / binary / octal prefixes combine with suffixes. integer-types.mdx "Literal Suffixes"
let h = 0xFFu8        // 255
check_int(h as int, 255, "hex_suffix")
let bi = 0b1010i16    // 10
check_int(bi as int, 10, "bin_suffix")
let oc = 0o77u32      // 63
check_int(oc as int, 63, "oct_suffix")

// --- `as` bit-level casting. integer-types.mdx "Explicit Casting with as" ---
// "300 as i8" keeps low 8 bits -> 44 (book states this exact value).
let wide: int = 300
let narrow = wide as i8
check_int(narrow as int, 44, "cast_narrow_300_i8")

// "-1 as u8" reinterprets bits -> 255 (book states this exact value).
let signed: int = -1
let unsigned = signed as u8
check_int(unsigned as int, 255, "cast_signed_neg1_u8")

if failures == 0 {
  print("ALL_CHECKS_PASSED")
}
