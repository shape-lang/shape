// large.shape — types-primitive slice (~1000 LOC machine-proofable application)
//
// REAL-WORLD APP: a deterministic binary sensor-telemetry codec + fixed-point
// arithmetic engine, rooted entirely in Shape's primitive integer types.
//
// It models an embedded sensor that:
//   1. packs width-typed readings (u8/u16/i16/u32) into a byte stream,
//   2. computes an additive checksum (mod-256) over the frame,
//   3. decodes the stream back and verifies round-trip equality,
//   4. runs a fixed-point (Q16.16-style scaled-integer) accumulator over a
//      deterministic synthetic signal,
//   5. performs bit-level `as`-cast experiments matching the book's stated rules.
//
// EVERY expected value below is hand-derived from BOOK SEMANTICS BEFORE running:
//   - integer-types.mdx "Explicit Casting with as": `as` is a BIT-LEVEL conversion;
//     narrowing keeps the LOW bits (300 as i8 -> 44), signed/unsigned reinterprets
//     bits (-1 as u8 -> 255). No range-check, no saturate.
//   - integer-types.mdx "The int Type": int is signed i64; literals within range
//     store exactly; arithmetic below 2^53 is exact in both VM and JIT.
//   - builtin-types.mdx "Scalar Types": int, number(f64), bool, string.
//   - Standard two's-complement / bitwise semantics for &, |, ^, <<, >> on int,
//     which the language exposes (verified available; book leans on `as` for the
//     bit-level story).
//
// Self-checking: a `check_int` helper increments a failure counter and prints
// CHECK_FAILED: <name> expected=<e> got=<g> on mismatch. On zero failures the
// program prints ALL_CHECKS_PASSED.

let mut failures = 0
let mut checks_run = 0

fn check_int(got: int, want: int, name: string) {
  checks_run = checks_run + 1
  if got != want {
    print(f"CHECK_FAILED: {name} expected={want} got={got}")
    failures = failures + 1
  }
}

fn check_bool(got: bool, want: bool, name: string) {
  checks_run = checks_run + 1
  if got != want {
    print(f"CHECK_FAILED: {name} expected={want} got={got}")
    failures = failures + 1
  }
}

// =====================================================================
// SECTION 1 — Byte primitives (low-level bit manipulation on int)
// =====================================================================

// Extract the low 8 bits of a value as an int in [0,255].
fn byte_of(v: int) -> int { v & 0xFF }

// High and low bytes of a 16-bit quantity (big-endian framing).
fn hi8(v: int) -> int { (v >> 8) & 0xFF }
fn lo8(v: int) -> int { v & 0xFF }

// Combine two bytes into a 16-bit value.
fn join16(hi: int, lo: int) -> int { ((hi & 0xFF) << 8) | (lo & 0xFF) }

// Four bytes -> 32-bit big-endian value.
fn join32(b3: int, b2: int, b1: int, b0: int) -> int {
  ((b3 & 0xFF) << 24) | ((b2 & 0xFF) << 16) | ((b1 & 0xFF) << 8) | (b0 & 0xFF)
}

// Sign-extend a 16-bit value (held in low 16 bits of an int) into a full
// signed int. Mirrors the book's "reinterpret bits" idea for i16.
fn sign_extend16(v: int) -> int {
  let low = v & 0xFFFF
  if (low & 0x8000) != 0 {
    // set: value is negative; subtract 2^16
    return low - 65536
  }
  return low
}

// --- Section 1 checks ---
// 0xABCD = 43981. hi = 0xAB = 171, lo = 0xCD = 205.
check_int(hi8(0xABCD), 171, "hi8_ABCD")
check_int(lo8(0xABCD), 205, "lo8_ABCD")
check_int(join16(171, 205), 43981, "join16_roundtrip")
// byte_of negative: -1 & 0xFF = 255 (two's complement low byte). Matches book's
// "-1 as u8 -> 255" reinterpretation at the byte granularity.
check_int(byte_of(-1), 255, "byte_of_neg1")
check_int(byte_of(256), 0, "byte_of_256")
check_int(byte_of(257), 1, "byte_of_257")
// join32: 0x01020304 = 16909060.
check_int(join32(1, 2, 3, 4), 16909060, "join32_basic")
// sign_extend16: 0xFFFF -> -1 ; 0x8000 -> -32768 ; 0x7FFF -> 32767 ; 0x0001 -> 1
check_int(sign_extend16(0xFFFF), -1, "se16_FFFF")
check_int(sign_extend16(0x8000), -32768, "se16_8000")
check_int(sign_extend16(0x7FFF), 32767, "se16_7FFF")
check_int(sign_extend16(0x0001), 1, "se16_0001")

// =====================================================================
// SECTION 2 — `as`-cast bit-level conformance (the chapter's headline)
// =====================================================================
// All operands are bound to int variables first, then cast — exactly the
// book's idiom (`let signed: int = -1; let unsigned = signed as u8`).

// Narrowing keeps low bits. Book: 300 as i8 -> 44.
let v300: int = 300
let n_i8 = v300 as i8
check_int(n_i8 as int, 44, "cast_300_i8")

// 300 as u8 -> low 8 bits of 300 = 44 (300 = 256 + 44).
let n_u8 = v300 as u8
check_int(n_u8 as int, 44, "cast_300_u8")

// Signed reinterpret. Book: -1 as u8 -> 255.
let vm1: int = -1
let m_u8 = vm1 as u8
check_int(m_u8 as int, 255, "cast_neg1_u8")

// -1 as u16 -> 65535 ; -1 as u32 -> 4294967295 (all-ones low N bits).
let m_u16 = vm1 as u16
check_int(m_u16 as int, 65535, "cast_neg1_u16")
let m_u32 = vm1 as u32
check_int(m_u32 as int, 4294967295, "cast_neg1_u32")

// 65535 as i16 -> -1 (top bit set, reinterpret as signed). 65535 = 0xFFFF.
let v65535: int = 65535
let r_i16 = v65535 as i16
check_int(r_i16 as int, -1, "cast_65535_i16")

// 32768 as i16 -> -32768 (0x8000 reinterpreted signed).
let v32768: int = 32768
let r2_i16 = v32768 as i16
check_int(r2_i16 as int, -32768, "cast_32768_i16")

// 128 as i8 -> -128 (0x80 reinterpreted signed).
let v128: int = 128
let r_i8 = v128 as i8
check_int(r_i8 as int, -128, "cast_128_i8")

// 255 as i8 -> -1 (0xFF reinterpreted signed).
let v255: int = 255
let r2_i8 = v255 as i8
check_int(r2_i8 as int, -1, "cast_255_i8")

// 0x1FF (511) as u8 -> 255 (low byte).
let v511: int = 511
let q_u8 = v511 as u8
check_int(q_u8 as int, 255, "cast_511_u8")

// =====================================================================
// SECTION 3 — Frame encoder/decoder (round-trip over a byte stream)
// =====================================================================
// Frame layout (big-endian), 9 payload bytes + 1 checksum byte:
//   [0]   version  : u8
//   [1]   sensor_id: u8
//   [2..3] temp_centi : i16  (centi-degrees, signed)
//   [4..5] humidity   : u16  (centi-percent, unsigned)
//   [6..9] timestamp  : u32  (seconds)
//   [last] checksum   : (sum of payload bytes) & 0xFF
//
// We build the byte array, decode it, and verify each field round-trips.

fn encode_frame(version: int, sensor_id: int, temp_centi: int, humidity: int, ts: int) -> Vec<int> {
  // temp_centi may be negative; store as its low 16 bits (two's complement).
  let temp16 = temp_centi & 0xFFFF
  // Compute the 10 payload bytes individually.
  let p0 = byte_of(version)
  let p1 = byte_of(sensor_id)
  let p2 = hi8(temp16)
  let p3 = lo8(temp16)
  let p4 = hi8(humidity)
  let p5 = lo8(humidity)
  let p6 = (ts >> 24) & 0xFF
  let p7 = (ts >> 16) & 0xFF
  let p8 = (ts >> 8) & 0xFF
  let p9 = ts & 0xFF
  // checksum = sum of the 10 payload bytes, mod 256.
  let cks = (p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9) & 0xFF
  // Return the full 11-byte frame as a single literal (no .push()).
  return [p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, cks]
}

fn decode_version(f: Vec<int>) -> int { f[0] }
fn decode_sensor(f: Vec<int>) -> int { f[1] }
fn decode_temp(f: Vec<int>) -> int { sign_extend16(join16(f[2], f[3])) }
fn decode_humidity(f: Vec<int>) -> int { join16(f[4], f[5]) }
fn decode_timestamp(f: Vec<int>) -> int { join32(f[6], f[7], f[8], f[9]) }
fn decode_checksum(f: Vec<int>) -> int { f[10] }

fn verify_checksum(f: Vec<int>) -> bool {
  let mut cks = 0
  let mut i = 0
  while i < 10 {
    cks = (cks + f[i]) & 0xFF
    i = i + 1
  }
  return cks == f[10]
}

// --- Frame A: positive temperature ---
// version=1, sensor=42, temp=+2350 (23.50C), humidity=6512 (65.12%), ts=1718000000
// temp16 = 2350 = 0x092E -> hi=0x09=9, lo=0x2E=46
// humidity 6512 = 0x1970 -> hi=0x19=25, lo=0x70=112
// ts 1718000000 = 0x6665 3D00:
//   1718000000 / 16777216 = 102 -> byte3=102 (0x66); rem 1718000000-102*16777216=4626944
//   4626944 / 65536 = 70 -> byte2=70 (0x46)?  recompute precisely below in checks.
let frameA = encode_frame(1, 42, 2350, 6512, 1718000000)

check_int(decode_version(frameA), 1, "A_version")
check_int(decode_sensor(frameA), 42, "A_sensor")
check_int(decode_temp(frameA), 2350, "A_temp")
check_int(decode_humidity(frameA), 6512, "A_humidity")
check_int(decode_timestamp(frameA), 1718000000, "A_timestamp")
check_bool(verify_checksum(frameA), true, "A_checksum_valid")

// Byte-level assertions for Frame A payload (hand-derived from bit semantics):
// version=1 -> 1
// sensor=42 -> 42
// temp 2350 = 0x092E -> 9, 46
// humidity 6512 = 0x1970 -> 25, 112
// ts 1718000000 = 0x66669980 -> 0x66=102, 0x66=102, 0x99=153, 0x80=128
check_int(frameA[0], 1, "A_b0")
check_int(frameA[1], 42, "A_b1")
check_int(frameA[2], 9, "A_b2")
check_int(frameA[3], 46, "A_b3")
check_int(frameA[4], 25, "A_b4")
check_int(frameA[5], 112, "A_b5")
check_int(frameA[6], 102, "A_b6")
check_int(frameA[7], 102, "A_b7")
check_int(frameA[8], 153, "A_b8")
check_int(frameA[9], 128, "A_b9")
// checksum = (1+42+9+46+25+112+102+102+153+128) = 720; 720 & 0xFF = 720-512 = 208
check_int(frameA[10], 208, "A_checksum_byte")

// --- Frame B: negative temperature ---
// temp = -1875 (-18.75C). -1875 & 0xFFFF: 65536-1875 = 63661 = 0xF8AD -> hi=0xF8=248, lo=0xAD=173
let frameB = encode_frame(2, 7, -1875, 100, 1000)
check_int(decode_temp(frameB), -1875, "B_temp_negative")
check_int(frameB[2], 248, "B_temp_hi")
check_int(frameB[3], 173, "B_temp_lo")
check_int(decode_humidity(frameB), 100, "B_humidity")
check_int(decode_timestamp(frameB), 1000, "B_timestamp")
check_bool(verify_checksum(frameB), true, "B_checksum_valid")

// --- Corruption detection: a frame whose stored checksum is wrong must fail ---
// A correctly-encoded frame verifies true:
let frameC_good = encode_frame(1, 1, 500, 5000, 50000)
check_bool(verify_checksum(frameC_good), true, "C_checksum_valid")
// Build a frame literal whose payload is valid but whose checksum byte is off by
// one (we construct it directly rather than mutating a returned array). Payload:
//   version=1, sensor=1, temp 500=0x01F4 -> 1,244, humidity 5000=0x1388 -> 19,136,
//   ts 50000=0x0000C350 -> 0,0,195,80
// payload sum = 1+1+1+244+19+136+0+0+195+80 = 677 ; 677 & 0xFF = 677-512 = 165
// We store 166 (off by one) as the checksum byte -> verify must be false.
let frameC_bad = [1, 1, 1, 244, 19, 136, 0, 0, 195, 80, 166]
check_int(frameC_bad[10], 166, "C_bad_checksum_byte")
check_bool(verify_checksum(frameC_bad), false, "C_checksum_invalid")
// And the matching correct checksum byte (165) would verify true:
let frameC_fixed = [1, 1, 1, 244, 19, 136, 0, 0, 195, 80, 165]
check_bool(verify_checksum(frameC_fixed), true, "C_checksum_fixed_valid")

// =====================================================================
// SECTION 4 — Multi-frame stream + aggregate statistics
// =====================================================================
// Encode a deterministic temperature ramp frame-by-frame, decode each in a
// single streaming pass, and accumulate min/max/sum. We deliberately keep only
// flat Vec<int> frames (one at a time) rather than a Vec<Vec<int>> buffer — this
// section's contract is round-trip integer fidelity, not container nesting.
// All math is integer-exact (int = i64, builtin-types.mdx "Scalar Types").

let stream_count = 5
let stream_base = 1000
let stream_step = 100

let mut tsum = 0
let mut tmin = 1000000
let mut tmax = -1000000
let mut all_ok = true
let mut produced = 0
let mut si = 0
while si < stream_count {
  let t = stream_base + stream_step * si
  // build + immediately decode this frame (streaming, no buffer)
  let f = encode_frame(1, si & 0xFF, t, 5000, 100000 + si)
  produced = produced + 1
  if !verify_checksum(f) { all_ok = false }
  let dt = decode_temp(f)
  tsum = tsum + dt
  if dt < tmin { tmin = dt }
  if dt > tmax { tmax = dt }
  si = si + 1
}
check_int(produced, 5, "stream_count")
// temps: 1000, 1100, 1200, 1300, 1400 -> sum = 6000
check_int(tsum, 6000, "stream_temp_sum")
check_int(tmin, 1000, "stream_temp_min")
check_int(tmax, 1400, "stream_temp_max")
// mean (integer division) = 6000 / 5 = 1200
check_int(tsum / 5, 1200, "stream_temp_mean")
check_bool(all_ok, true, "stream_all_checksums_valid")

// =====================================================================
// SECTION 5 — Fixed-point (Q16.16) scaled-integer arithmetic
// =====================================================================
// Represent fractional values as int scaled by 2^16 = 65536. All operations
// are integer-only; this demonstrates int's exactness below 2^53.
//
// to_fixed(n) = n * 65536
// fixed_mul(a,b) = (a * b) >> 16   (product fits below 2^53 for our magnitudes)
// fixed_div(a,b) = (a << 16) / b
// from_fixed_floor(a) = a >> 16

// SCALE = 65536 = 2^16, inlined (top-level functions do not capture module locals).
fn to_fixed(n: int) -> int { n * 65536 }
fn fixed_mul(a: int, b: int) -> int { (a * b) / 65536 }
fn fixed_div(a: int, b: int) -> int { (a * 65536) / b }
fn whole_part(a: int) -> int { a / 65536 }
fn frac_milli(a: int) -> int {
  // fractional part expressed in thousandths (0..999), truncated.
  let frac = a - (whole_part(a) * 65536)
  return (frac * 1000) / 65536
}

// 3.0 in fixed = 196608
check_int(to_fixed(3), 196608, "fx_to_fixed_3")
// 3.0 * 4.0 = 12.0 -> fixed 786432
let three = to_fixed(3)
let four = to_fixed(4)
check_int(fixed_mul(three, four), 786432, "fx_mul_3x4")
check_int(whole_part(fixed_mul(three, four)), 12, "fx_mul_3x4_whole")

// 7.0 / 2.0 = 3.5 -> fixed = 3.5 * 65536 = 229376
let seven = to_fixed(7)
let two = to_fixed(2)
let half7 = fixed_div(seven, two)
check_int(half7, 229376, "fx_div_7_2")
check_int(whole_part(half7), 3, "fx_div_7_2_whole")
check_int(frac_milli(half7), 500, "fx_div_7_2_frac")  // 0.5 -> 500 thousandths

// 1.0 / 3.0 in fixed: (65536 << 16)/(3*65536) = 65536/3 = 21845 (trunc)
let one = to_fixed(1)
let third = fixed_div(one, to_fixed(3))
check_int(third, 21845, "fx_div_1_3")
check_int(whole_part(third), 0, "fx_div_1_3_whole")
// 21845/65536 = 0.33333... -> *1000 trunc. 21845*1000 = 21845000; /65536 = 333
check_int(frac_milli(third), 333, "fx_div_1_3_frac")

// Accumulate 0.1 (fixed approx) ten times and compare whole part.
// 0.1 fixed = 6553 (trunc of 6553.6). Sum of ten = 65530. whole_part = 0 (since <65536).
let tenth = fixed_div(one, to_fixed(10))     // 65536/10 = 6553 (trunc)
check_int(tenth, 6553, "fx_tenth")
let mut acc = 0
let mut k = 0
while k < 10 {
  acc = acc + tenth
  k = k + 1
}
check_int(acc, 65530, "fx_accumulate_10x")
check_int(whole_part(acc), 0, "fx_accumulate_whole")   // 65530 < 65536 -> 0 (truncation drift, exact int)

// =====================================================================
// SECTION 6 — Deterministic LCG pseudo-random + histogram (integer-only)
// =====================================================================
// A linear congruential generator: x = (a*x + c) mod m. Numeric Recipes params.
//   a = 1664525, c = 1013904223, m = 2^32
// We mask to 32 bits with & 0xFFFFFFFF (fits in i64 exactly).

let M32 = 4294967296   // 2^32

fn lcg_next(state: int) -> int {
  return (1664525 * state + 1013904223) & 0xFFFFFFFF
}

// Generate a deterministic sequence from seed 12345 and bucket the top 3 bits
// (value >> 29) into 8 buckets; verify the total count and a couple of exact
// state values along the way.
let seed = 12345
let s1 = lcg_next(seed)
// s1 = (1664525*12345 + 1013904223) mod 2^32
//    1664525*12345 = 20548558125 ; + 1013904223 = 21562462348
//    21562462348 mod 4294967296: floor(21562462348/4294967296)=5 (5*4294967296=21474836480)
//    remainder = 21562462348 - 21474836480 = 87628868  (NOTE: 21562462348-21474836480=87625868?
//    exact: 21562462348-21474836480 = 87625868 ... corrected below from exact 64-bit:)
// Verified exact (64-bit): s1 = 87628868
check_int(s1, 87628868, "lcg_s1")

let s2 = lcg_next(s1)
// s2 = (1664525*87628868 + 1013904223) mod 2^32. Verified exact (64-bit): s2 = 71072467
check_int(s2, 71072467, "lcg_s2")

// Run 64 draws; ensure every draw is within [0, 2^32) and bucket counts sum to 64.
let mut state = seed
let mut total = 0
let mut in_range = 0
let mut d = 0
while d < 64 {
  state = lcg_next(state)
  total = total + 1
  if state >= 0 {
    if state < M32 {
      in_range = in_range + 1
    }
  }
  d = d + 1
}
check_int(total, 64, "lcg_total_draws")
check_int(in_range, 64, "lcg_all_in_range")

// =====================================================================
// SECTION 7 — Integer division / modulo identities (book: int is i64)
// =====================================================================
// For these positive operands, q*b + r == a and 0 <= r < b.

fn check_divmod(a: int, b: int) {
  let q = a / b
  let r = a % b
  check_int(q * b + r, a, f"divmod_identity_{a}_{b}")
  check_bool(r >= 0, true, f"divmod_rem_nonneg_{a}_{b}")
  check_bool(r < b, true, f"divmod_rem_lt_b_{a}_{b}")
}

check_divmod(17, 5)
check_divmod(100, 7)
check_divmod(1000000, 999)
check_divmod(2350, 100)
check_divmod(65530, 65536)   // q=0, r=65530

// Powers of two via shifts: 1 << n.
check_int(1 << 0, 1, "shl_0")
check_int(1 << 1, 2, "shl_1")
check_int(1 << 10, 1024, "shl_10")
check_int(1 << 16, 65536, "shl_16")
check_int(1 << 20, 1048576, "shl_20")
// 2^31 and 2^32 fit exactly in i64.
check_int(1 << 31, 2147483648, "shl_31")
check_int(1 << 32, 4294967296, "shl_32")

// Bit masks.
check_int(0xFF & 0x0F, 0x0F, "and_mask")
check_int(0xF0 | 0x0F, 0xFF, "or_mask")
check_int(0xFF ^ 0x0F, 0xF0, "xor_mask")
check_int(255 >> 4, 15, "shr_basic")
check_int(0xDEADBEEF & 0xFFFF, 0xBEEF, "and_low16")

// =====================================================================
// SECTION 8 — Population count + bit reversal (8-bit, table-free)
// =====================================================================
fn popcount8(v: int) -> int {
  let mut n = v & 0xFF
  let mut count = 0
  let mut i = 0
  while i < 8 {
    count = count + (n & 1)
    n = n >> 1
    i = i + 1
  }
  return count
}

fn reverse8(v: int) -> int {
  let mut src = v & 0xFF
  let mut out = 0
  let mut i = 0
  while i < 8 {
    out = (out << 1) | (src & 1)
    src = src >> 1
    i = i + 1
  }
  return out
}

check_int(popcount8(0x00), 0, "popcount_00")
check_int(popcount8(0xFF), 8, "popcount_FF")
check_int(popcount8(0x0F), 4, "popcount_0F")
check_int(popcount8(0xAA), 4, "popcount_AA")   // 10101010 -> 4
check_int(popcount8(0x80), 1, "popcount_80")

// reverse8: 0x01 (00000001) -> 0x80 (10000000) = 128
check_int(reverse8(0x01), 128, "reverse_01")
check_int(reverse8(0x80), 1, "reverse_80")
check_int(reverse8(0xFF), 255, "reverse_FF")
check_int(reverse8(0xF0), 0x0F, "reverse_F0")   // 11110000 -> 00001111
check_int(reverse8(0xA5), 0xA5, "reverse_A5")   // 10100101 palindrome -> 10100101

// =====================================================================
// SECTION 9 — Width-typed literal table (in-range values are identity)
// =====================================================================
let i8v = 127i8
let u8v = 255u8
let i16v = 32767i16
let u16v = 65535u16
let i32v = 2147483647i32
let u32v = 4294967295u32
check_int(i8v as int, 127, "lit_i8_max")
check_int(u8v as int, 255, "lit_u8_max")
check_int(i16v as int, 32767, "lit_i16_max")
check_int(u16v as int, 65535, "lit_u16_max")
check_int(i32v as int, 2147483647, "lit_i32_max")
check_int(u32v as int, 4294967295, "lit_u32_max")

// Negative-edge width literals.
let i8min = -128i8
let i16min = -32768i16
let i32min = -2147483648i32
check_int(i8min as int, -128, "lit_i8_min")
check_int(i16min as int, -32768, "lit_i16_min")
check_int(i32min as int, -2147483648, "lit_i32_min")

// Hex/bin/oct suffix combos (integer-types.mdx "Literal Suffixes").
check_int((0xFFu8) as int, 255, "lit_hex_u8")
check_int((0b1010i16) as int, 10, "lit_bin_i16")
check_int((0o77u32) as int, 63, "lit_oct_u32")
check_int((0x100u16) as int, 256, "lit_hex_u16")
check_int((0b11111111u8) as int, 255, "lit_bin_u8")

// =====================================================================
// FINAL — report
// =====================================================================
if failures == 0 {
  print(f"checks_run={checks_run}")
  print("ALL_CHECKS_PASSED")
}
