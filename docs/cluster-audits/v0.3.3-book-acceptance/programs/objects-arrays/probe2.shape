let m = HashMap().set("a", 1).set("b", 2).set("c", 3)
print(m.get("b"))
print(m.has("a"))
print(m.len())
print(m.isEmpty())
let m2 = m.delete("a")
print(m2.len())
print(m2.has("a"))

