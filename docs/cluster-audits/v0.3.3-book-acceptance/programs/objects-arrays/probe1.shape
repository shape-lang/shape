let nums = [1, 2, 3, 4, 5]
print(nums[1..4])
print(nums.map(|x| x * 2))
print(nums.filter(|x| x % 2 == 0))
print(nums.first())
print(nums.last())
print(nums.len())
print(nums.includes(3))
print(nums.indexOf(4))
print(nums.findIndex(|x| x > 3))
print(nums.some(|x| x > 4))
print(nums.every(|x| x > 0))
print(nums.take(2))
print(nums.drop(2))
print(nums.slice(1, 3))
print(nums.reverse())
print(nums.concat([6, 7]))
