let mut xs = [1, 2, 3]
xs.push(4)
print(xs)
let popped = xs.pop()
print(popped)
print(xs)

let words = ["a", "b", "c"]
print(words.join("-"))

let nums = [1, 2, 3, 4]
print(nums.sum())
print(nums.max())
print(nums.min())

let m = HashMap().set("a", 1).set("b", 2)
let m2 = m.map(|k, v| v * 10)
print(m2.get("a"))
print(m2.get("b"))
let m3 = m.filter(|k, v| v > 1)
print(m3.len())
print(m3.has("b"))
