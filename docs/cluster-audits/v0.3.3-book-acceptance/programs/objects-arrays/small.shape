// small.shape — Objects and Vectors (book: fundamentals/objects-arrays.mdx)
// Exercises the chapter core: vector literals, indexing, slicing, common
// methods, objects, object merge, typed objects, and HashMap.
// Self-checking: every result asserted against a book-derived expected value;
// prints ALL_CHECKS_PASSED on success.
//
// NOTE: Shape's strict typing rejects direct `vecA == vecB` (operand types
// infer as `unknown`). The book never shows vector equality, so we compare
// element-wise via veq() below.

let mut failures = 0

fn check(cond: bool, label: string) {
  if !cond {
    print(f"CHECK_FAILED: {label}")
    failures = failures + 1
  }
}

fn veq(a: Array<int>, b: Array<int>) -> bool {
  let la = a.len()
  let lb = b.len()
  if la != lb { return false }
  let mut i = 0
  let mut ok = true
  while i < la {
    let av = a[i]
    let bv = b[i]
    if av != bv { ok = false }
    i = i + 1
  }
  return ok
}

// --- Vectors: literal + index access (book "Vectors" / "Index Access") ---
let nums = [1, 2, 3, 4]
check(nums[0] == 1, "index_first")
check(nums[3] == 4, "index_last")
check(nums.len() == 4, "len")
check(nums.first() == 1, "first")
check(nums.last() == 4, "last")

// --- Slicing: closed-range form (book "Slicing") ---
let five = [10, 20, 30, 40, 50]
check(veq(five[1..4], [20, 30, 40]), "slice_1_4")
check(veq(five[0..2], [10, 20]), "slice_0_2")

// --- Common operations (book "Common Operations") ---
let doubled = nums.map(|x| x * 2)
check(veq(doubled, [2, 4, 6, 8]), "map_double")
let evens = nums.filter(|x| x % 2 == 0)
check(veq(evens, [2, 4]), "filter_evens")

// --- More vector methods from the method table ---
check(nums.findIndex(|x| x == 3) == 2, "findIndex")
check(nums.some(|x| x > 3), "some")
check(nums.every(|x| x > 0), "every")
check(nums.includes(3), "includes")
check(nums.indexOf(4) == 3, "indexOf")
check(veq(nums.concat([5, 6]), [1, 2, 3, 4, 5, 6]), "concat")
check(veq(nums.take(2), [1, 2]), "take")
check(veq(nums.drop(2), [3, 4]), "drop")
check(veq(nums.slice(1, 3), [2, 3]), "slice_method")
check(veq(nums.reverse(), [4, 3, 2, 1]), "reverse")
check(nums.find(|x| x > 2) == 3, "find")
check(nums.sum() == 10, "sum")
check(nums.max() == 4, "max")
check(nums.min() == 1, "min")
let letters = ["a", "b", "c"]
check(letters.join("-") == "a-b-c", "join")

// --- push / pop on a mutable vector (book method table) ---
let mut stack = [1, 2, 3]
stack.push(4)
check(veq(stack, [1, 2, 3, 4]), "push")
let top = stack.pop()
check(top == 4, "pop_value")
check(veq(stack, [1, 2, 3]), "pop_remaining")

// --- Objects: anonymous (book "Objects" / "Nested Objects") ---
let user = { id: 1, name: "Ada" }
check(user.name == "Ada", "obj_name")
check(user.id == 1, "obj_id")
let cfg = { server: { host: "localhost", port: 9091 } }
check(cfg.server.host == "localhost", "nested_host")
check(cfg.server.port == 9091, "nested_port")

// --- Object merge with disjoint keys (book "Object Merge") ---
let a = { x: 1, y: 2 }
let b = { z: 3 }
let c = a + b
check(c.x == 1, "merge_x")
check(c.y == 2, "merge_y")
check(c.z == 3, "merge_z")

// --- Typed objects (book "Typed Objects") ---
type Point { x: int, y: int }
let p = Point { x: 3, y: 4 }
check(p.x == 3, "point_x")
check(p.y == 4, "point_y")
check(p.x + p.y == 7, "point_sum")

// --- HashMap: immutable chained build (book "HashMap") ---
// get returns Option<V>; the chapter is silent on unwrapping, so use ??.
let m = HashMap().set("a", 1).set("b", 2).set("c", 3)
check((m.get("b") ?? 0) == 2, "hm_get")
check(m.has("a"), "hm_has")
check(m.len() == 3, "hm_len")
check(!m.isEmpty(), "hm_nonempty")
let m2 = m.delete("a")
check(m2.len() == 2, "hm_delete_len")
check(!m2.has("a"), "hm_delete_gone")

if failures == 0 {
  print("ALL_CHECKS_PASSED")
}
