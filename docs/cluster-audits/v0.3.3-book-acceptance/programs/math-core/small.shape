// math-core small program: exercises the core of stdlib/core/math + native/math.
// Book sources:
//   stdlib/core/math.mdx  — sum, mean, std, variance
//   stdlib/native/math.mdx — bare globals (floor/ceil/round/abs/min/max/sqrt/pow),
//                            constants PI()/E()/TAU(), trig (radians), clamp, lerp, sign, degrees, radians
//
// Self-checking: each check returns 0 on pass, 1 (and prints CHECK_FAILED) on fail.
// The total is summed at the top level; ALL_CHECKS_PASSED is printed iff total == 0.

from std::core::math use { sum, mean, std, variance, PI, E, TAU, sin, cos, clamp, lerp, sign, degrees, radians }

// approximate equality for number results
fn close(got: number, expected: number) -> bool {
    abs(got - expected) < 0.000001
}

fn check_num(name: string, got: number, expected: number) -> int {
    if close(got, expected) {
        0
    } else {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
        1
    }
}

fn check_int(name: string, got: int, expected: int) -> int {
    if got == expected {
        0
    } else {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
        1
    }
}

let mut failures: int = 0

// --- Basic statistics (stdlib/core/math.mdx) ---
failures = failures + check_num("sum", sum([1.0, 2.0, 3.0, 4.0]), 10.0)
failures = failures + check_num("mean", mean([10.0, 20.0, 30.0]), 20.0)
failures = failures + check_num("std", std([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]), 2.0)
failures = failures + check_num("variance", variance([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]), 4.0)

// --- Bare global builtins (stdlib/native/math.mdx) ---
failures = failures + check_num("sqrt_hypot", sqrt(3.0 * 3.0 + 4.0 * 4.0), 5.0)
failures = failures + check_num("abs", abs(-7.0), 7.0)
failures = failures + check_int("floor", floor(3.7), 3)
failures = failures + check_int("ceil", ceil(3.2), 4)
failures = failures + check_int("round", round(3.5), 4)
failures = failures + check_num("min", min(3.0, 5.0), 3.0)
failures = failures + check_num("max", max(3.0, 5.0), 5.0)
failures = failures + check_num("pow", pow(2.0, 10.0), 1024.0)

// --- Constants (functions, call with ()) ---
failures = failures + check_num("PI", PI(), 3.141592653589793)
failures = failures + check_num("E", E(), 2.718281828459045)
failures = failures + check_num("TAU", TAU(), 6.283185307179586)
failures = failures + check_num("tau_is_2pi", TAU(), 2.0 * PI())

// --- Trigonometry (radians) ---
failures = failures + check_num("sin_half_pi", sin(radians(90.0)), 1.0)
failures = failures + check_num("cos_zero", cos(0.0), 1.0)

// --- Helpers ---
failures = failures + check_num("clamp_high", clamp(150.0, 0.0, 100.0), 100.0)
failures = failures + check_num("clamp_low", clamp(-5.0, 0.0, 100.0), 0.0)
failures = failures + check_num("clamp_mid", clamp(42.0, 0.0, 100.0), 42.0)
failures = failures + check_num("lerp", lerp(0.0, 10.0, 0.5), 5.0)
failures = failures + check_int("sign_neg", sign(-5), -1)
failures = failures + check_int("sign_zero", sign(0), 0)
failures = failures + check_int("sign_pos", sign(7), 1)
failures = failures + check_num("degrees_tau", degrees(TAU()), 360.0)
failures = failures + check_num("radians_180", radians(180.0), PI())

if failures == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"FAILURES: {failures}")
}
