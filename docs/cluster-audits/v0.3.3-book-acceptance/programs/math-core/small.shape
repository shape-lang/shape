// small.shape — math-core slice
// Exercises the chapter core: bare-global arithmetic builtins (native/math.mdx)
// and the std::core::math constants + trigonometry + helpers.
// Self-checking: every result asserted against a book-derived expected value.

from std::core::math use { PI, E, TAU, sin, cos, radians, degrees, clamp, lerp, sign, sum, mean, variance, std }

fn approx(a: number, b: number) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.000001
}

fn check(name: string, cond: bool) {
    if !cond {
        print(f"CHECK_FAILED: {name}")
    }
}

// Bare global builtins (native/math.mdx "Bare Global Builtins")
check("sqrt_hyp", approx(sqrt(3.0 * 3.0 + 4.0 * 4.0), 5.0))
check("abs_neg", approx(abs(-7.0), 7.0))
check("floor", floor(3.7) == 3)
check("ceil", ceil(3.2) == 4)
check("round", round(3.5) == 4)
check("min", approx(min(3.0, 5.0), 3.0))
check("max", approx(max(3.0, 5.0), 5.0))
check("pow", approx(pow(2.0, 10.0), 1024.0))

// Constants
check("PI", approx(PI(), 3.141592653589793))
check("E", approx(E(), 2.718281828459045))
check("TAU", approx(TAU(), 6.283185307179586))
check("TAU_is_2PI", approx(TAU(), 2.0 * PI()))

// Trigonometry (radians)
check("sin_90", approx(sin(radians(90.0)), 1.0))
check("cos_0", approx(cos(0.0), 1.0))
check("radians_180", approx(radians(180.0), PI()))
check("degrees_PI", approx(degrees(PI()), 180.0))

// Helpers
check("clamp_hi", approx(clamp(150.0, 0.0, 100.0), 100.0))
check("clamp_lo", approx(clamp(-5.0, 0.0, 100.0), 0.0))
check("clamp_mid", approx(clamp(42.0, 0.0, 100.0), 42.0))
check("lerp_mid", approx(lerp(0.0, 10.0, 0.5), 5.0))
check("sign_neg", sign(-5) == -1)
check("sign_zero", sign(0) == 0)
check("sign_pos", sign(7) == 1)

// Statistical surface (core/math.mdx) — documented-and-working set only
check("sum", approx(sum([1.0, 2.0, 3.0, 4.0]), 10.0))
check("mean", approx(mean([10.0, 20.0, 30.0]), 20.0))
check("variance", approx(variance([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]), 4.0))
check("std", approx(std([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]), 2.0))

print("ALL_CHECKS_PASSED")
