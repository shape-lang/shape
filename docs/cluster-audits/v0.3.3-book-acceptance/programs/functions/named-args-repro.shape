// NAMED-ARGUMENTS BOOK-WRONG reproducer.
//
// Book fundamentals/functions.mdx §"Named Arguments" (lines 194-218) documents
// named arguments as a supported feature and lists three "supported call shapes
// at HEAD":
//   - All-positional:        f(a, b, c)              -- works
//   - All-named:             f(a: 1, b: 2, c: 3)     -- claimed working
//   - Positional-then-named: f(1, b: 2, c: 3)        -- claimed working
//
// ACTUAL behavior in the v0.3.3 strict-flip-collection-dispatch binary:
//   - All-positional        -> works (correct).
//   - All-named             -> COMPILE ERROR: "expects between 3 and 3
//                              arguments, got 0" (named args counted as zero).
//   - Positional-then-named -> COMPILE ERROR: "...got 1" (named args dropped).
//   - With default-valued params, named values are SILENTLY IGNORED and the
//     default is used instead (no error), producing a wrong result.
//
// Each block below is commented out so the file's first ACTIVE line documents
// the only shape that actually works. Uncomment any one block to reproduce the
// corresponding error.

fn box_vol(w: int, h: int, d: int) -> int { w * h * d }

// (A) all-positional — WORKS, prints 24
print(box_vol(2, 3, 4))

// (B) all-named — book says works; ACTUALLY: error "got 0"
//   print(box_vol(w: 2, h: 3, d: 4))

// (C) positional-then-named — book says works; ACTUALLY: error "got 1"
//   print(box_vol(2, h: 3, d: 4))

// (D) default-valued params + named override — silently ignored:
//   fn sma(period: int = 14, threshold: number = 0.01) -> number {
//     threshold * (period as number)
//   }
//   print(sma(period: 20, threshold: 0.05))  // book: 1.0 ; ACTUAL: 0.14 (both defaults)
//   print(sma(20, threshold: 0.02))          // book: 0.4 ; ACTUAL: 0.2  (named dropped)
