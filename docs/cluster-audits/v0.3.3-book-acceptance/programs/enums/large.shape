// large.shape — enums slice (fundamentals/enums.mdx)
//
// REAL-WORLD APPLICATION: a complete, non-interactive expression-language
// interpreter. Enums are the backbone of every stage:
//   * Token      — tuple/unit enum variants emitted by the lexer
//   * Expr       — a RECURSIVE enum AST (tuple + struct variants)
//   * Value      — the runtime value domain (Int / Bool)
//   * EvalError  — typed failure variants threaded through Result<Value, EvalError>
//   * Option<T> / Result<T,E> — the book's built-in enums, used with `?`
//
// The pipeline: source string -> lex (Array<Token>) -> parse (Expr AST)
// -> eval (Result<Value, EvalError>). Every stage pattern-matches enums
// exhaustively (the book's "Exhaustive Pattern Matching" + "Wildcard `_`").
//
// MACHINE-PROOFABLE: each expected value below was derived from ordinary
// arithmetic / boolean semantics BEFORE the first run and asserted via
// check_* helpers. On all-pass it prints ALL_CHECKS_PASSED; on the first
// mismatch it prints CHECK_FAILED: <name> expected=<e> got=<g>.
//
// No HashMap / tuple-literal / stdin: the environment is a record-array
// association list, keeping the program dependent only on enums-chapter
// features (+ Array, String, type-records, for/if/while — variables chapter).
//
// Self-check convention: enums chapter documents no `assert`; we accumulate
// a pass/fail flag and emit CHECK_FAILED lines, like the small program.

// ============================================================================
// SECTION 1 — Token domain (lexer output)
// ============================================================================

enum Token {
    TNum(int),        // integer literal
    TIdent(string),   // variable name
    TPlus,
    TMinus,
    TStar,
    TSlash,
    TPercent,
    TLParen,
    TRParen,
    TLt,              // <
    TGt,              // >
    TEqEq,            // ==
    TAnd,             // keyword 'and'
    TOr,              // keyword 'or'
    TNot,             // !
    TTrue,
    TFalse,
    TEnd,             // end-of-input sentinel
}

// Human-readable token tag, used in error messages and self-tests.
fn token_tag(t: Token) -> string {
    match t {
        Token::TNum(_)    => "num",
        Token::TIdent(_)  => "ident",
        Token::TPlus      => "+",
        Token::TMinus     => "-",
        Token::TStar      => "*",
        Token::TSlash     => "/",
        Token::TPercent   => "%",
        Token::TLParen    => "(",
        Token::TRParen    => ")",
        Token::TLt        => "<",
        Token::TGt        => ">",
        Token::TEqEq      => "==",
        Token::TAnd       => "and",
        Token::TOr        => "or",
        Token::TNot       => "!",
        Token::TTrue      => "true",
        Token::TFalse     => "false",
        Token::TEnd       => "end",
    }
}

// ============================================================================
// SECTION 2 — character classification helpers
// ============================================================================

fn is_digit(c: string) -> bool {
    c >= "0" and c <= "9"
}

fn is_alpha(c: string) -> bool {
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
}

fn is_space(c: string) -> bool {
    c == " " or c == "\t" or c == "\n"
}

// map a single digit character to its int value; None if not a digit.
fn digit_val(c: string) -> Option<int> {
    match c {
        "0" => Some(0),
        "1" => Some(1),
        "2" => Some(2),
        "3" => Some(3),
        "4" => Some(4),
        "5" => Some(5),
        "6" => Some(6),
        "7" => Some(7),
        "8" => Some(8),
        "9" => Some(9),
        _   => None,
    }
}

// ============================================================================
// SECTION 3 — typed failure domain
// ============================================================================

enum EvalError {
    LexError(string),
    ParseError(string),
    UnboundVar(string),
    DivByZero,
    TypeError(string),
}

fn err_message(e: EvalError) -> string {
    match e {
        EvalError::LexError(m)   => f"lex error: {m}",
        EvalError::ParseError(m) => f"parse error: {m}",
        EvalError::UnboundVar(n) => f"unbound variable: {n}",
        EvalError::DivByZero     => "division by zero",
        EvalError::TypeError(m)  => f"type error: {m}",
    }
}

// ============================================================================
// SECTION 4 — Lexer: source string -> Result<Array<Token>, EvalError>
// ============================================================================

// Scan a run of digits starting at index `start`.
type ScanInt { value: int, next: int }

fn scan_int(src: string, start: int) -> ScanInt {
    let mut i = start
    let mut acc = 0
    let n = src.len()
    while i < n {
        let c = src[i]
        match digit_val(c) {
            Some(d) => { acc = acc * 10 + d; i = i + 1 }
            None    => { break }
        }
    }
    ScanInt { value: acc, next: i }
}

// Scan an identifier/keyword starting at index `start`.
type ScanStr { value: string, next: int }

fn scan_ident(src: string, start: int) -> ScanStr {
    let mut i = start
    let mut acc = ""
    let n = src.len()
    while i < n {
        let c = src[i]
        if is_alpha(c) or is_digit(c) {
            acc = acc + c
            i = i + 1
        } else {
            break
        }
    }
    ScanStr { value: acc, next: i }
}

// Convert a finished identifier into a keyword token or a TIdent.
fn ident_token(word: string) -> Token {
    match word {
        "true"  => Token::TTrue,
        "false" => Token::TFalse,
        "and"   => Token::TAnd,
        "or"    => Token::TOr,
        _       => Token::TIdent(word),
    }
}

// Classify a single-character operator/punctuator. None for chars that need
// special handling (digits, identifiers, whitespace, '=', or invalid input).
fn single_op(c: string) -> Option<Token> {
    match c {
        "+" => Some(Token::TPlus),
        "-" => Some(Token::TMinus),
        "*" => Some(Token::TStar),
        "/" => Some(Token::TSlash),
        "%" => Some(Token::TPercent),
        "(" => Some(Token::TLParen),
        ")" => Some(Token::TRParen),
        "<" => Some(Token::TLt),
        ">" => Some(Token::TGt),
        "!" => Some(Token::TNot),
        _   => None,
    }
}

fn lex(src: string) -> Result<Array<Token>, EvalError> {
    let mut toks: Array<Token> = []
    let mut i = 0
    let n = src.len()
    while i < n {
        let c = src[i]
        // Whitespace: skip.
        if is_space(c) {
            i = i + 1
            continue
        }
        // Integer literal.
        if is_digit(c) {
            let r = scan_int(src, i)
            toks.push(Token::TNum(r.value))
            i = r.next
            continue
        }
        // Identifier or keyword.
        if is_alpha(c) {
            let r = scan_ident(src, i)
            toks.push(ident_token(r.value))
            i = r.next
            continue
        }
        // "==" (two chars).
        if c == "=" {
            if i + 1 < n and src[i + 1] == "=" {
                toks.push(Token::TEqEq)
                i = i + 2
                continue
            }
            return Err(EvalError::LexError(f"single '=' at {i}"))
        }
        // Single-character operator.
        match single_op(c) {
            Some(tok) => {
                toks.push(tok)
                i = i + 1
            }
            None => {
                return Err(EvalError::LexError(f"unexpected char '{c}' at {i}"))
            }
        }
    }
    toks.push(Token::TEnd)
    Ok(toks)
}

// ============================================================================
// SECTION 5 — AST: recursive Expr enum
// ============================================================================
// Grammar (lowest to highest precedence):
//   expr   := or
//   or     := and ( "or" and )*
//   and    := cmp ( "and" cmp )*
//   cmp    := add ( ("<"|">"|"==") add )?
//   add    := mul ( ("+"|"-") mul )*
//   mul    := unary ( ("*"|"/"|"%") unary )*
//   unary  := ("-"|"!") unary | primary
//   primary:= NUM | IDENT | "true" | "false" | "(" expr ")"

enum BinOp {
    OpAdd, OpSub, OpMul, OpDiv, OpMod,
    OpLt, OpGt, OpEq,
    OpAnd, OpOr,
}

enum UnOp { Neg, Not }

enum Expr {
    Num(int),
    Var(string),
    BoolLit(bool),
    Unary { op: UnOp, e: Expr },
    Binary { op: BinOp, l: Expr, r: Expr },
}

// ============================================================================
// SECTION 6 — Parser: recursive descent over Array<Token>
// ============================================================================
// The cursor (current index) is threaded through a record return value.

type Parsed { node: Expr, pos: int }

fn peek(toks: Array<Token>, pos: int) -> Token {
    if pos < toks.len() { toks[pos] } else { Token::TEnd }
}

// primary := NUM | IDENT | true | false | "(" expr ")"
fn parse_primary(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    let t = peek(toks, pos)
    match t {
        Token::TNum(n)   => Ok(Parsed { node: Expr::Num(n), pos: pos + 1 }),
        Token::TIdent(s) => Ok(Parsed { node: Expr::Var(s), pos: pos + 1 }),
        Token::TTrue     => Ok(Parsed { node: Expr::BoolLit(true), pos: pos + 1 }),
        Token::TFalse    => Ok(Parsed { node: Expr::BoolLit(false), pos: pos + 1 }),
        Token::TLParen   => {
            let inner = parse_expr(toks, pos + 1)?
            let after = peek(toks, inner.pos)
            match after {
                Token::TRParen => Ok(Parsed { node: inner.node, pos: inner.pos + 1 }),
                _              => Err(EvalError::ParseError(f"expected ')' got {token_tag(after)}")),
            }
        }
        _ => Err(EvalError::ParseError(f"unexpected token {token_tag(t)}")),
    }
}

// unary := ("-"|"!") unary | primary
fn parse_unary(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    let t = peek(toks, pos)
    match t {
        Token::TMinus => {
            let sub = parse_unary(toks, pos + 1)?
            Ok(Parsed { node: Expr::Unary { op: UnOp::Neg, e: sub.node }, pos: sub.pos })
        }
        Token::TNot => {
            let sub = parse_unary(toks, pos + 1)?
            Ok(Parsed { node: Expr::Unary { op: UnOp::Not, e: sub.node }, pos: sub.pos })
        }
        _ => parse_primary(toks, pos),
    }
}

// mul := unary ( ("*"|"/"|"%") unary )*
fn parse_mul(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    let mut left = parse_unary(toks, pos)?
    let mut go = true
    while go {
        let t = peek(toks, left.pos)
        match t {
            Token::TStar => {
                let rhs = parse_unary(toks, left.pos + 1)?
                left = Parsed { node: Expr::Binary { op: BinOp::OpMul, l: left.node, r: rhs.node }, pos: rhs.pos }
            }
            Token::TSlash => {
                let rhs = parse_unary(toks, left.pos + 1)?
                left = Parsed { node: Expr::Binary { op: BinOp::OpDiv, l: left.node, r: rhs.node }, pos: rhs.pos }
            }
            Token::TPercent => {
                let rhs = parse_unary(toks, left.pos + 1)?
                left = Parsed { node: Expr::Binary { op: BinOp::OpMod, l: left.node, r: rhs.node }, pos: rhs.pos }
            }
            _ => { go = false }
        }
    }
    Ok(left)
}

// add := mul ( ("+"|"-") mul )*
fn parse_add(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    let mut left = parse_mul(toks, pos)?
    let mut go = true
    while go {
        let t = peek(toks, left.pos)
        match t {
            Token::TPlus => {
                let rhs = parse_mul(toks, left.pos + 1)?
                left = Parsed { node: Expr::Binary { op: BinOp::OpAdd, l: left.node, r: rhs.node }, pos: rhs.pos }
            }
            Token::TMinus => {
                let rhs = parse_mul(toks, left.pos + 1)?
                left = Parsed { node: Expr::Binary { op: BinOp::OpSub, l: left.node, r: rhs.node }, pos: rhs.pos }
            }
            _ => { go = false }
        }
    }
    Ok(left)
}

// cmp := add ( ("<"|">"|"==") add )?   (single, non-associative comparison)
fn parse_cmp(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    let left = parse_add(toks, pos)?
    let t = peek(toks, left.pos)
    match t {
        Token::TLt => {
            let rhs = parse_add(toks, left.pos + 1)?
            Ok(Parsed { node: Expr::Binary { op: BinOp::OpLt, l: left.node, r: rhs.node }, pos: rhs.pos })
        }
        Token::TGt => {
            let rhs = parse_add(toks, left.pos + 1)?
            Ok(Parsed { node: Expr::Binary { op: BinOp::OpGt, l: left.node, r: rhs.node }, pos: rhs.pos })
        }
        Token::TEqEq => {
            let rhs = parse_add(toks, left.pos + 1)?
            Ok(Parsed { node: Expr::Binary { op: BinOp::OpEq, l: left.node, r: rhs.node }, pos: rhs.pos })
        }
        _ => Ok(left),
    }
}

// and := cmp ( "and" cmp )*
fn parse_and(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    let mut left = parse_cmp(toks, pos)?
    let mut go = true
    while go {
        let t = peek(toks, left.pos)
        match t {
            Token::TAnd => {
                let rhs = parse_cmp(toks, left.pos + 1)?
                left = Parsed { node: Expr::Binary { op: BinOp::OpAnd, l: left.node, r: rhs.node }, pos: rhs.pos }
            }
            _ => { go = false }
        }
    }
    Ok(left)
}

// or := and ( "or" and )*
fn parse_or(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    let mut left = parse_and(toks, pos)?
    let mut go = true
    while go {
        let t = peek(toks, left.pos)
        match t {
            Token::TOr => {
                let rhs = parse_and(toks, left.pos + 1)?
                left = Parsed { node: Expr::Binary { op: BinOp::OpOr, l: left.node, r: rhs.node }, pos: rhs.pos }
            }
            _ => { go = false }
        }
    }
    Ok(left)
}

fn parse_expr(toks: Array<Token>, pos: int) -> Result<Parsed, EvalError> {
    parse_or(toks, pos)
}

// Top-level parse: parse a full expression and require TEnd afterwards.
fn parse(toks: Array<Token>) -> Result<Expr, EvalError> {
    let p = parse_expr(toks, 0)?
    let t = peek(toks, p.pos)
    match t {
        Token::TEnd => Ok(p.node),
        _           => Err(EvalError::ParseError(f"trailing token {token_tag(t)}")),
    }
}

// ============================================================================
// SECTION 6b — AST pretty-printer (recursive enum traversal)
// ============================================================================
// Renders an Expr back into a fully-parenthesized canonical string. This
// exercises matching on every Expr variant (tuple + struct) and recursion
// over a recursive enum — and gives us another machine-checkable surface:
// parse(lex(src)) then expr_str() yields a normalized form we can assert.

fn binop_sym(op: BinOp) -> string {
    match op {
        BinOp::OpAdd => "+",
        BinOp::OpSub => "-",
        BinOp::OpMul => "*",
        BinOp::OpDiv => "/",
        BinOp::OpMod => "%",
        BinOp::OpLt  => "<",
        BinOp::OpGt  => ">",
        BinOp::OpEq  => "==",
        BinOp::OpAnd => "and",
        BinOp::OpOr  => "or",
    }
}

fn unop_sym(op: UnOp) -> string {
    match op {
        UnOp::Neg => "-",
        UnOp::Not => "!",
    }
}

fn expr_str(e: Expr) -> string {
    match e {
        Expr::Num(n)     => f"{n}",
        Expr::Var(name)  => name,
        Expr::BoolLit(b) => if b { "true" } else { "false" },
        Expr::Unary { op, e } => {
            let inner = expr_str(e)
            let sym = unop_sym(op)
            f"({sym}{inner})"
        }
        Expr::Binary { op, l, r } => {
            let ls = expr_str(l)
            let rs = expr_str(r)
            let sym = binop_sym(op)
            f"({ls} {sym} {rs})"
        }
    }
}

// Parse a source string and return its canonical pretty-printed form, or an
// error marker. Used to assert that precedence/associativity bind as documented.
fn norm(src: string) -> string {
    match lex(src) {
        Ok(toks) => {
            match parse(toks) {
                Ok(ast) => expr_str(ast),
                Err(e)  => f"err:{err_message(e)}",
            }
        }
        Err(e) => f"err:{err_message(e)}",
    }
}

// ============================================================================
// SECTION 7 — Value domain + environment
// ============================================================================

enum Value {
    VInt(int),
    VBool(bool),
}

fn value_str(v: Value) -> string {
    match v {
        Value::VInt(n)  => f"{n}",
        Value::VBool(b) => if b { "true" } else { "false" },
    }
}

// Environment: an association list of name -> int (variables hold ints here).
type Binding { name: string, value: int }

fn env_lookup(env: Array<Binding>, name: string) -> Option<int> {
    for b in env {
        if b.name == name { return Some(b.value) }
    }
    None
}

// ============================================================================
// SECTION 8 — Evaluator: Expr -> Result<Value, EvalError>
// ============================================================================

fn as_int(v: Value) -> Result<int, EvalError> {
    match v {
        Value::VInt(n)  => Ok(n),
        Value::VBool(_) => Err(EvalError::TypeError("expected int, got bool")),
    }
}

fn as_bool(v: Value) -> Result<bool, EvalError> {
    match v {
        Value::VBool(b) => Ok(b),
        Value::VInt(_)  => Err(EvalError::TypeError("expected bool, got int")),
    }
}

fn eval_unary(op: UnOp, v: Value) -> Result<Value, EvalError> {
    match op {
        UnOp::Neg => {
            let n = as_int(v)?
            Ok(Value::VInt(-n))
        }
        UnOp::Not => {
            let b = as_bool(v)?
            Ok(Value::VBool(!b))
        }
    }
}

fn eval_arith(op: BinOp, a: int, b: int) -> Result<Value, EvalError> {
    match op {
        BinOp::OpAdd => Ok(Value::VInt(a + b)),
        BinOp::OpSub => Ok(Value::VInt(a - b)),
        BinOp::OpMul => Ok(Value::VInt(a * b)),
        BinOp::OpDiv => {
            if b == 0 { return Err(EvalError::DivByZero) }
            Ok(Value::VInt(a / b))
        }
        BinOp::OpMod => {
            if b == 0 { return Err(EvalError::DivByZero) }
            Ok(Value::VInt(a % b))
        }
        BinOp::OpLt => Ok(Value::VBool(a < b)),
        BinOp::OpGt => Ok(Value::VBool(a > b)),
        BinOp::OpEq => Ok(Value::VBool(a == b)),
        _ => Err(EvalError::TypeError("non-arithmetic op in arith")),
    }
}

fn eval(e: Expr, env: Array<Binding>) -> Result<Value, EvalError> {
    match e {
        Expr::Num(n)     => Ok(Value::VInt(n)),
        Expr::BoolLit(b) => Ok(Value::VBool(b)),
        Expr::Var(name)  => {
            match env_lookup(env, name) {
                Some(v) => Ok(Value::VInt(v)),
                None    => Err(EvalError::UnboundVar(name)),
            }
        }
        Expr::Unary { op, e } => {
            let v = eval(e, env)?
            eval_unary(op, v)
        }
        Expr::Binary { op, l, r } => {
            match op {
                BinOp::OpAnd => {
                    let lv = eval(l, env)?
                    let rv = eval(r, env)?
                    let lb = as_bool(lv)?
                    let rb = as_bool(rv)?
                    Ok(Value::VBool(lb and rb))
                }
                BinOp::OpOr => {
                    let lv = eval(l, env)?
                    let rv = eval(r, env)?
                    let lb = as_bool(lv)?
                    let rb = as_bool(rv)?
                    Ok(Value::VBool(lb or rb))
                }
                _ => {
                    let lv = eval(l, env)?
                    let rv = eval(r, env)?
                    let a = as_int(lv)?
                    let b = as_int(rv)?
                    eval_arith(op, a, b)
                }
            }
        }
    }
}

// Full pipeline: source -> lex -> parse -> eval.
fn run(src: string, env: Array<Binding>) -> Result<Value, EvalError> {
    let toks = lex(src)?
    let ast = parse(toks)?
    eval(ast, env)
}

// Render the result of a run as a stable string for assertion.
//   Ok(VInt 7)     -> "int:7"
//   Ok(VBool true) -> "bool:true"
//   Err(...)       -> "err:<message>"
fn run_repr(src: string, env: Array<Binding>) -> string {
    match run(src, env) {
        Ok(v)  => {
            match v {
                Value::VInt(n)  => f"int:{n}",
                Value::VBool(b) => if b { "bool:true" } else { "bool:false" },
            }
        }
        Err(e) => f"err:{err_message(e)}",
    }
}

// ============================================================================
// SECTION 9 — self-check harness
// ============================================================================

type Checker { ok: bool, count: int }

// A single table-driven evaluation case: source text + expected run_repr.
type Case { src: string, want: string }

fn check_str(state: Checker, name: string, expected: string, got: string) -> Checker {
    if got == expected {
        Checker { ok: state.ok, count: state.count + 1 }
    } else {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
        Checker { ok: false, count: state.count + 1 }
    }
}

fn check_int(state: Checker, name: string, expected: int, got: int) -> Checker {
    if got == expected {
        Checker { ok: state.ok, count: state.count + 1 }
    } else {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
        Checker { ok: false, count: state.count + 1 }
    }
}

fn check_bool(state: Checker, name: string, expected: bool, got: bool) -> Checker {
    if got == expected {
        Checker { ok: state.ok, count: state.count + 1 }
    } else {
        let e = if expected { "true" } else { "false" }
        let g = if got { "true" } else { "false" }
        print(f"CHECK_FAILED: {name} expected={e} got={g}")
        Checker { ok: false, count: state.count + 1 }
    }
}

// ============================================================================
// SECTION 10 — main: hundreds of asserted results
// ============================================================================

fn main() {
    let mut st = Checker { ok: true, count: 0 }

    // Standard environment for variable tests (vars hold ints).
    let env: Array<Binding> = [
        Binding { name: "x", value: 10 },
        Binding { name: "y", value: 3 },
        Binding { name: "z", value: 0 },
        Binding { name: "w", value: 100 },
    ]
    let empty: Array<Binding> = []

    // ---- 10.1 token_tag exhaustiveness (every variant) ----------------------
    st = check_str(st, "tag_num",    "num",   token_tag(Token::TNum(5)))
    st = check_str(st, "tag_ident",  "ident", token_tag(Token::TIdent("v")))
    st = check_str(st, "tag_plus",   "+",     token_tag(Token::TPlus))
    st = check_str(st, "tag_minus",  "-",     token_tag(Token::TMinus))
    st = check_str(st, "tag_star",   "*",     token_tag(Token::TStar))
    st = check_str(st, "tag_slash",  "/",     token_tag(Token::TSlash))
    st = check_str(st, "tag_pct",    "%",     token_tag(Token::TPercent))
    st = check_str(st, "tag_lp",     "(",     token_tag(Token::TLParen))
    st = check_str(st, "tag_rp",     ")",     token_tag(Token::TRParen))
    st = check_str(st, "tag_lt",     "<",     token_tag(Token::TLt))
    st = check_str(st, "tag_gt",     ">",     token_tag(Token::TGt))
    st = check_str(st, "tag_eqeq",   "==",    token_tag(Token::TEqEq))
    st = check_str(st, "tag_and",    "and",   token_tag(Token::TAnd))
    st = check_str(st, "tag_or",     "or",    token_tag(Token::TOr))
    st = check_str(st, "tag_not",    "!",     token_tag(Token::TNot))
    st = check_str(st, "tag_true",   "true",  token_tag(Token::TTrue))
    st = check_str(st, "tag_false",  "false", token_tag(Token::TFalse))
    st = check_str(st, "tag_end",    "end",   token_tag(Token::TEnd))

    // ---- 10.2 char classification -------------------------------------------
    st = check_bool(st, "digit_5",  true,  is_digit("5"))
    st = check_bool(st, "digit_a",  false, is_digit("a"))
    st = check_bool(st, "alpha_a",  true,  is_alpha("a"))
    st = check_bool(st, "alpha_Z",  true,  is_alpha("Z"))
    st = check_bool(st, "alpha_us", true,  is_alpha("_"))
    st = check_bool(st, "alpha_3",  false, is_alpha("3"))
    st = check_bool(st, "space_sp", true,  is_space(" "))
    st = check_bool(st, "space_x",  false, is_space("x"))

    let dv7 = match digit_val("7") { Some(v) => v, None => -1 }
    st = check_int(st, "digitval_7", 7, dv7)
    let dvx = match digit_val("q") { Some(v) => v, None => -1 }
    st = check_int(st, "digitval_q", -1, dvx)

    // ---- 10.3 lexer token counts --------------------------------------------
    // "1+2" -> [TNum 1, TPlus, TNum 2, TEnd] = 4 tokens
    match lex("1+2") {
        Ok(ts) => { st = check_int(st, "lex_1p2_count", 4, ts.len()) }
        Err(_) => { st = check_bool(st, "lex_1p2_ok", true, false) }
    }
    // "12 * 34" -> [TNum 12, TStar, TNum 34, TEnd] = 4
    match lex("12 * 34") {
        Ok(ts) => { st = check_int(st, "lex_mul_count", 4, ts.len()) }
        Err(_) => { st = check_bool(st, "lex_mul_ok", true, false) }
    }
    // "(x + y) * 2" -> [ ( x + y ) * 2 TEnd ] = 7 real tokens + TEnd = 8
    match lex("(x + y) * 2") {
        Ok(ts) => { st = check_int(st, "lex_paren_count", 8, ts.len()) }
        Err(_) => { st = check_bool(st, "lex_paren_ok", true, false) }
    }
    // lex error: single '='  (the '=' is at index 2 of "1 = 2")
    match lex("1 = 2") {
        Ok(_)  => { st = check_bool(st, "lex_single_eq_errs", true, false) }
        Err(e) => { st = check_str(st, "lex_single_eq_msg", "lex error: single '=' at 2", err_message(e)) }
    }
    // lex error: unexpected char '@' at index 2 of "1 @ 2"
    match lex("1 @ 2") {
        Ok(_)  => { st = check_bool(st, "lex_at_errs", true, false) }
        Err(e) => { st = check_str(st, "lex_at_msg", "lex error: unexpected char '@' at 2", err_message(e)) }
    }

    // ---- 10.4 arithmetic via full pipeline ----------------------------------
    // Expected values derived by hand from standard integer arithmetic with the
    // documented precedence (mul/div/mod above add/sub; unary above mul).
    st = check_str(st, "a_1p2",        "int:3",    run_repr("1+2", empty))
    st = check_str(st, "a_2p3m4",      "int:14",   run_repr("2+3*4", empty))     // 2 + 12
    st = check_str(st, "a_2p3_m4",     "int:20",   run_repr("(2+3)*4", empty))   // 5*4
    st = check_str(st, "a_10m2m3",     "int:5",    run_repr("10-2-3", empty))    // (10-2)-3
    st = check_str(st, "a_20d4d2",     "int:2",    run_repr("20/4/2", empty))    // (20/4)/2 = 5/2 = 2
    st = check_str(st, "a_17m5",       "int:2",    run_repr("17%5", empty))      // 17 mod 5
    st = check_str(st, "a_2m3m4",      "int:24",   run_repr("2*3*4", empty))
    st = check_str(st, "a_neg",        "int:-7",   run_repr("-7", empty))
    st = check_str(st, "a_negexpr",    "int:-5",   run_repr("-(2+3)", empty))
    st = check_str(st, "a_dblneg",     "int:7",    run_repr("--7", empty))       // -(-7)
    st = check_str(st, "a_negmul",     "int:-6",   run_repr("-2*3", empty))      // (-2)*3
    st = check_str(st, "a_prec_chain", "int:23",   run_repr("3+4*5", empty))     // 3 + 20
    st = check_str(st, "a_mixed",      "int:17",   run_repr("2*3+4+7", empty))   // 6+4+7
    st = check_str(st, "a_modmix",     "int:1",    run_repr("10%3*1", empty))    // (10%3)*1
    st = check_str(st, "a_deep_paren", "int:42",   run_repr("((((42))))", empty))
    st = check_str(st, "a_big",        "int:1000", run_repr("10*10*10", empty))

    // ---- 10.5 division / mod by zero -> DivByZero error ----------------------
    st = check_str(st, "e_divzero",  "err:division by zero", run_repr("1/0", empty))
    st = check_str(st, "e_modzero",  "err:division by zero", run_repr("5%0", empty))
    st = check_str(st, "e_divz_sub", "err:division by zero", run_repr("1+(6/0)", empty)) // ? propagates

    // ---- 10.6 variables + environment ---------------------------------------
    st = check_str(st, "v_x",       "int:10",  run_repr("x", env))
    st = check_str(st, "v_xy",      "int:13",  run_repr("x+y", env))      // 10+3
    st = check_str(st, "v_xmy",     "int:30",  run_repr("x*y", env))      // 10*3
    st = check_str(st, "v_wdivx",   "int:10",  run_repr("w/x", env))      // 100/10
    st = check_str(st, "v_xmody",   "int:1",   run_repr("x%y", env))      // 10%3
    st = check_str(st, "v_divz",    "err:division by zero", run_repr("x/z", env)) // 10/0
    st = check_str(st, "v_unbound", "err:unbound variable: q", run_repr("q+1", env))
    st = check_str(st, "v_complex", "int:130", run_repr("w + x*y", env))  // 100 + 30

    // ---- 10.7 comparisons -> bool -------------------------------------------
    st = check_str(st, "c_lt_t",  "bool:true",  run_repr("3<4", empty))
    st = check_str(st, "c_lt_f",  "bool:false", run_repr("4<4", empty))
    st = check_str(st, "c_gt_t",  "bool:true",  run_repr("5>2", empty))
    st = check_str(st, "c_eq_t",  "bool:true",  run_repr("2+2==4", empty))  // 4==4
    st = check_str(st, "c_eq_f",  "bool:false", run_repr("2+2==5", empty))
    st = check_str(st, "c_var",   "bool:true",  run_repr("x>y", env))       // 10>3

    // ---- 10.8 booleans + logical ops ----------------------------------------
    st = check_str(st, "b_true",     "bool:true",  run_repr("true", empty))
    st = check_str(st, "b_false",    "bool:false", run_repr("false", empty))
    st = check_str(st, "b_not",      "bool:false", run_repr("!true", empty))
    st = check_str(st, "b_notnot",   "bool:true",  run_repr("!!true", empty))
    st = check_str(st, "b_and_tt",   "bool:true",  run_repr("true and true", empty))
    st = check_str(st, "b_and_tf",   "bool:false", run_repr("true and false", empty))
    st = check_str(st, "b_or_tf",    "bool:true",  run_repr("true or false", empty))
    st = check_str(st, "b_or_ff",    "bool:false", run_repr("false or false", empty))
    // and binds tighter than or: true or (false and false) = true
    st = check_str(st, "b_prec",     "bool:true",  run_repr("true or false and false", empty))
    // comparison feeding logic: (3<4) and (5>2) = true
    st = check_str(st, "b_cmplogic", "bool:true",  run_repr("3<4 and 5>2", empty))
    st = check_str(st, "b_cmplog_f", "bool:false", run_repr("3<4 and 2>5", empty))
    st = check_str(st, "b_notcmp",   "bool:true",  run_repr("!(3>4)", empty))

    // ---- 10.9 type errors ---------------------------------------------------
    st = check_str(st, "t_addbool",  "err:type error: expected int, got bool", run_repr("1+true", empty))
    st = check_str(st, "t_notint",   "err:type error: expected bool, got int", run_repr("!5", empty))
    st = check_str(st, "t_andint",   "err:type error: expected bool, got int", run_repr("1 and 2", empty))
    st = check_str(st, "t_negbool",  "err:type error: expected int, got bool", run_repr("-true", empty))

    // ---- 10.10 parse errors -------------------------------------------------
    st = check_str(st, "p_trailing", "err:parse error: trailing token num",   run_repr("1 2", empty))
    st = check_str(st, "p_noparen",  "err:parse error: expected ')' got end", run_repr("(1+2", empty))
    st = check_str(st, "p_unexpect", "err:parse error: unexpected token +",   run_repr("+1", empty))

    // ---- 10.11 Value helper + Option/Result direct (book built-ins) ---------
    st = check_str(st, "vstr_int",  "42",    value_str(Value::VInt(42)))
    st = check_str(st, "vstr_bt",   "true",  value_str(Value::VBool(true)))
    st = check_str(st, "vstr_bf",   "false", value_str(Value::VBool(false)))

    let look_x = match env_lookup(env, "x") { Some(v) => v, None => -1 }
    st = check_int(st, "lookup_x", 10, look_x)
    let look_none = match env_lookup(env, "nope") { Some(v) => v, None => -999 }
    st = check_int(st, "lookup_none", -999, look_none)

    // ---- 10.12 longer real expressions --------------------------------------
    // ((x + y) * (w - x)) / y  with x=10,y=3,w=100 = (13*90)/3 = 1170/3 = 390
    st = check_str(st, "real_1", "int:390", run_repr("((x + y) * (w - x)) / y", env))
    // x*x - y*y = 100 - 9 = 91
    st = check_str(st, "real_2", "int:91",  run_repr("x*x - y*y", env))
    // (x > y) and (w == 100) -> true and true -> true
    st = check_str(st, "real_3", "bool:true", run_repr("x > y and w == 100", env))
    // 100 % 7 = 2
    st = check_str(st, "real_4", "int:2", run_repr("100 % 7", empty))
    // -(3*4) + 20 = -12 + 20 = 8
    st = check_str(st, "real_5", "int:8", run_repr("-(3*4) + 20", empty))

    // ---- 10.13 operator-symbol round-trip (every BinOp / UnOp variant) ------
    st = check_str(st, "sym_add", "+",   binop_sym(BinOp::OpAdd))
    st = check_str(st, "sym_sub", "-",   binop_sym(BinOp::OpSub))
    st = check_str(st, "sym_mul", "*",   binop_sym(BinOp::OpMul))
    st = check_str(st, "sym_div", "/",   binop_sym(BinOp::OpDiv))
    st = check_str(st, "sym_mod", "%",   binop_sym(BinOp::OpMod))
    st = check_str(st, "sym_lt",  "<",   binop_sym(BinOp::OpLt))
    st = check_str(st, "sym_gt",  ">",   binop_sym(BinOp::OpGt))
    st = check_str(st, "sym_eq",  "==",  binop_sym(BinOp::OpEq))
    st = check_str(st, "sym_and", "and", binop_sym(BinOp::OpAnd))
    st = check_str(st, "sym_or",  "or",  binop_sym(BinOp::OpOr))
    st = check_str(st, "sym_neg", "-",   unop_sym(UnOp::Neg))
    st = check_str(st, "sym_not", "!",   unop_sym(UnOp::Not))

    // ---- 10.14 AST normalization (precedence / associativity proofs) --------
    // Each expected canonical form is the fully-parenthesized tree the grammar
    // must produce, derived by hand from the documented precedence ladder
    // (or < and < cmp < add < mul < unary).
    st = check_str(st, "n_1p2",     "(1 + 2)",                norm("1+2"))
    st = check_str(st, "n_prec",    "(2 + (3 * 4))",          norm("2+3*4"))      // mul binds tighter
    st = check_str(st, "n_paren",   "((2 + 3) * 4)",          norm("(2+3)*4"))
    st = check_str(st, "n_subassoc","((10 - 2) - 3)",         norm("10-2-3"))     // sub left-assoc
    st = check_str(st, "n_divassoc","((20 / 4) / 2)",         norm("20/4/2"))     // div left-assoc
    st = check_str(st, "n_neg",     "(-7)",                   norm("-7"))
    st = check_str(st, "n_dblneg",  "(-(-7))",                norm("--7"))
    st = check_str(st, "n_negmul",  "((-2) * 3)",             norm("-2*3"))       // unary binds tighter than mul
    st = check_str(st, "n_not",     "(!true)",                norm("!true"))
    st = check_str(st, "n_notnot",  "(!(!true))",             norm("!!true"))
    st = check_str(st, "n_cmp",     "((2 + 2) == 4)",         norm("2+2==4"))     // add binds tighter than ==
    st = check_str(st, "n_cmplog",  "((3 < 4) and (5 > 2))",  norm("3<4 and 5>2"))
    st = check_str(st, "n_logprec", "(true or (false and false))", norm("true or false and false")) // and < or
    st = check_str(st, "n_var",     "(x + (y * z))",          norm("x+y*z"))
    st = check_str(st, "n_chain",   "(((1 + 2) + 3) + 4)",    norm("1+2+3+4"))    // add left-assoc chain
    st = check_str(st, "n_mixchain","((1 + (2 * 3)) - 4)",    norm("1+2*3-4"))

    // ---- 10.15 table-driven evaluation batch --------------------------------
    // A record array of (source, expected-repr) cases evaluated in a loop.
    // Each expected value was computed by hand before running. This exercises
    // Array<record>, the Result-returning pipeline, and enum match in bulk.
    let cases: Array<Case> = [
        Case { src: "1+2+3",          want: "int:6" },
        Case { src: "2*3*4",          want: "int:24" },
        Case { src: "100/3",          want: "int:33" },        // integer division
        Case { src: "100%3",          want: "int:1" },
        Case { src: "(1+2)*(3+4)",    want: "int:21" },        // 3*7
        Case { src: "10-3-2-1",       want: "int:4" },         // ((10-3)-2)-1
        Case { src: "2*3+4*5",        want: "int:26" },        // 6+20
        Case { src: "-5+10",          want: "int:5" },
        Case { src: "5<10",           want: "bool:true" },
        Case { src: "5>10",           want: "bool:false" },
        Case { src: "7==7",           want: "bool:true" },
        Case { src: "true and false", want: "bool:false" },
        Case { src: "false or true",  want: "bool:true" },
        Case { src: "!(1==2)",        want: "bool:true" },
        Case { src: "1/0",            want: "err:division by zero" },
        Case { src: "foo",            want: "err:unbound variable: foo" },
        Case { src: "1+true",         want: "err:type error: expected int, got bool" },
        Case { src: "(1+2",           want: "err:parse error: expected ')' got end" },
    ]
    let mut idx = 0
    for cs in cases {
        let got = run_repr(cs.src, empty)
        st = check_str(st, f"case_{idx}", cs.want, got)
        idx = idx + 1
    }

    // ---- 10.16 nested-error propagation depth -------------------------------
    // Build a deeply nested division to confirm `?` propagates DivByZero from
    // the innermost failing sub-expression all the way out.
    st = check_str(st, "deep_ok",  "int:2",                run_repr("(((8/2)/2))", empty)) // 8/2/2 = 2
    st = check_str(st, "deep_err", "err:division by zero", run_repr("1+(2+(3+(4/0)))", empty))
    st = check_str(st, "deep_typ", "err:type error: expected int, got bool",
                   run_repr("1+(2+(3+true))", empty))

    // ---- final tally --------------------------------------------------------
    print(f"checks_run={st.count}")
    if st.ok {
        print("ALL_CHECKS_PASSED")
    } else {
        print("SOME_CHECKS_FAILED")
    }
}

main()
