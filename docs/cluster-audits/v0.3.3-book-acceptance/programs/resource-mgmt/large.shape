// =============================================================================
// large.shape -- Resource Management slice (fundamentals/resource-management.mdx)
//
// A deterministic transactional "unit-of-work" / resource-pool engine where
// RAII drop order is the load-bearing correctness property. Models a stack of
// dependent resources (connection -> transaction -> cursor, plus file handles
// and locks). Every acquire and every Drop is appended to a global event log;
// each scenario asserts the EXACT event sequence against an expected sequence
// DERIVED FROM BOOK SEMANTICS and written before the first run.
//
// Book invariants exercised (fundamentals/resource-management.mdx):
//   - "Automatic Scope-Based Drop": let bindings implementing Drop run drop()
//     at scope exit (block, return, break, continue).
//   - "Multiple Resources and Reverse Drop Order": last declared, first dropped.
//   - "Block Scoping": inner block resources drop at block end, before outer.
//   - "Drop in Loops": loop-body bindings drop at end of each iteration;
//     break/continue trigger cleanup.
//   - "Early Return": all pending drops for exited scopes run before return.
//   - "Nested Scopes": value-producing block drops its resource at block end.
//   - "Custom Connection Type": conditional behavior inside drop().
//
// Determinism: pure. No stdin / network / clock. The "external resources" are
// simulated by appending strings to a global log -- the proof object.
//
// NOTE (author finding, NOT a book topic): under strict-flip collection
// dispatch, an unannotated `let x = a.len()` or `let x = a[i]` yields an
// `unknown` type that fails a downstream `!=`. We therefore annotate every
// binding fed from `.len()`/index (`let n: int = ...`, `let s: string = ...`),
// which is a legitimate strict-typing idiom and does not mask any
// resource-management behavior.
// =============================================================================

// ---- Global event log (the proof object) -----------------------------------

let mut LOG: Array<string> = []

fn emit(ev: string) {
  LOG.push(ev)
}

// emit a tag:n event. Used inside loop-break branches: building the f-string
// into a `let` and then emitting it sidesteps a strict-flip codegen
// non-termination bug triggered when an interpolated f-string is passed
// DIRECTLY as a call argument inside the break-branch of a Drop-bearing loop
// whose fall-through branch also passes an interpolated f-string directly, with
// a statement after the loop (see REPORT.md, FN-REG-CORRECTNESS). The book's
// "Drop in Loops" break-triggers-cleanup semantics are unchanged.
fn emit_tag(tag: string, n: int) {
  let m: string = f"{tag}:{n}"
  emit(m)
}

fn log_len() -> int {
  let n: int = LOG.len()
  n
}

fn log_at(i: int) -> string {
  let s: string = LOG[i]
  s
}

// The log is never cleared (reassigning `[]` to a typed module array hits an
// unimplemented op_new_array(0) SURFACE under V3-S5 -- see REPORT.md, V0.4-DEFER).
// Instead each scenario records BASE = current length before running, then
// compares the suffix LOG[BASE..] against its expected sequence.

let mut BASE: int = 0

fn mark_base() {
  BASE = log_len()
}

// snapshot the suffix produced since the last mark_base()
fn log_suffix() -> Array<string> {
  let mut out: Array<string> = []
  let n: int = log_len()
  for i in BASE..n {
    let s: string = log_at(i)
    out.push(s)
  }
  out
}

// ---- Assertion harness ------------------------------------------------------

let mut FAILS: int = 0
let mut CHECKS: int = 0

fn arr_eq(a: Array<string>, b: Array<string>) -> bool {
  let al: int = a.len()
  let bl: int = b.len()
  if al != bl {
    return false
  }
  for i in 0..al {
    let x: string = a[i]
    let y: string = b[i]
    if x != y {
      return false
    }
  }
  true
}

fn join_arr(a: Array<string>) -> string {
  let mut acc: string = "["
  let n: int = a.len()
  for i in 0..n {
    let s: string = a[i]
    if i == 0 {
      acc = acc + s
    } else {
      acc = acc + "," + s
    }
  }
  acc + "]"
}

fn check_seq(name: string, expected: Array<string>) {
  CHECKS = CHECKS + 1
  let actual: Array<string> = log_suffix()
  let ok: bool = arr_eq(actual, expected)
  if !ok {
    FAILS = FAILS + 1
    let e: string = join_arr(expected)
    let g: string = join_arr(actual)
    print(f"CHECK_FAILED: {name} expected={e} got={g}")
  }
}

fn check_int(name: string, expected: int, got: int) {
  CHECKS = CHECKS + 1
  if expected != got {
    FAILS = FAILS + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}

fn check_str(name: string, expected: string, got: string) {
  CHECKS = CHECKS + 1
  if expected != got {
    FAILS = FAILS + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}

// ---- Resource types (each impl Drop) ----------------------------------------

// A pooled connection. Drop returns it to the pool only when active.
type Connection {
  pool: string,
  id: int,
  active: bool
}

impl Drop for Connection {
  method drop() {
    if self.active {
      emit(f"conn:return:{self.pool}:{self.id}")
    } else {
      emit(f"conn:skip:{self.pool}:{self.id}")
    }
  }
}

trait Named {
  fn name(self) -> string;
}

impl Named for Connection {
  method name() -> string {
    f"conn({self.id}@{self.pool})"
  }
}

// A transaction depends on a connection (declared after it).
type Transaction {
  conn_id: int,
  committed: bool
}

impl Drop for Transaction {
  method drop() {
    if self.committed {
      emit(f"tx:finalize:{self.conn_id}")
    } else {
      emit(f"tx:rollback:{self.conn_id}")
    }
  }
}

// A cursor depends on a transaction (declared after it).
type Cursor {
  tx_conn: int,
  rows: int
}

impl Drop for Cursor {
  method drop() {
    emit(f"cursor:close:{self.tx_conn}:{self.rows}")
  }
}

// A file handle.
type FileHandle {
  path: string
}

impl Drop for FileHandle {
  method drop() {
    emit(f"file:close:{self.path}")
  }
}

// An advisory lock.
type Lock {
  resource: string
}

impl Drop for Lock {
  method drop() {
    emit(f"lock:release:{self.resource}")
  }
}

// ---- Constructors that also log acquisition --------------------------------

fn open_conn(pool: string, id: int) -> Connection {
  emit(f"conn:open:{pool}:{id}")
  Connection { pool: pool, id: id, active: true }
}

fn begin_tx(conn_id: int) -> Transaction {
  emit(f"tx:begin:{conn_id}")
  Transaction { conn_id: conn_id, committed: false }
}

fn open_cursor(tx_conn: int, rows: int) -> Cursor {
  emit(f"cursor:open:{tx_conn}:{rows}")
  Cursor { tx_conn: tx_conn, rows: rows }
}

fn open_file(path: string) -> FileHandle {
  emit(f"file:open:{path}")
  FileHandle { path: path }
}

fn acquire_lock(resource: string) -> Lock {
  emit(f"lock:acquire:{resource}")
  Lock { resource: resource }
}

print("== resource-management RAII engine ==")

// =============================================================================
// SCENARIO 1: Reverse drop order for a dependent resource stack.
// Book "Multiple Resources and Reverse Drop Order" + best-practice "transact":
// declare conn, then tx, then cursor; drop runs cursor, tx, conn (reverse).
// =============================================================================

fn scenario_dependent_stack() {
  let conn: Connection = open_conn("analytics", 1)
  let tx: Transaction = begin_tx(1)
  let cur: Cursor = open_cursor(1, 5)
  emit("body:work")
}

fn run_scenario_dependent_stack() {
  mark_base()
  scenario_dependent_stack()
  let expected: Array<string> = [
    "conn:open:analytics:1",
    "tx:begin:1",
    "cursor:open:1:5",
    "body:work",
    "cursor:close:1:5",
    "tx:rollback:1",
    "conn:return:analytics:1"
  ]
  check_seq("dependent_stack_reverse_order", expected)
}

// =============================================================================
// SCENARIO 2: Block scoping releases the inner resource early.
// Book "Block Scoping" / "Use blocks to limit resource lifetimes".
// The block produces an int; the connection inside drops at block end.
// =============================================================================

fn scenario_block_scoping() {
  let row_count: int = {
    let conn: Connection = open_conn("staging", 2)
    emit("body:query-in-block")
    3
  }
  emit(f"body:after-block:{row_count}")
  let f: FileHandle = open_file("/tmp/out.csv")
  emit("body:write")
}

fn run_scenario_block_scoping() {
  mark_base()
  scenario_block_scoping()
  let expected: Array<string> = [
    "conn:open:staging:2",
    "body:query-in-block",
    "conn:return:staging:2",
    "body:after-block:3",
    "file:open:/tmp/out.csv",
    "body:write",
    "file:close:/tmp/out.csv"
  ]
  check_seq("block_scoping_early_release", expected)
}

// =============================================================================
// SCENARIO 3: Drop in loops -- per-iteration cleanup with continue and break.
// Book "Drop in Loops": break and continue both trigger cleanup; binding drops
// at end of each iteration.
// counts = [0, 7, 2000000, 9]
//   i=0 -> count 0   -> continue (drop conn)
//   i=1 -> count 7   -> process  (drop conn)
//   i=2 -> count 2000000 -> break (drop conn, loop exits) -- index 3 never seen
// =============================================================================

fn scenario_loop_drops() {
  let counts: Array<int> = [0, 7, 2000000, 9]
  let n: int = counts.len()
  for i in 0..n {
    let conn: Connection = open_conn("loop", i)
    let c: int = counts[i]
    if c == 0 {
      emit(f"body:skip:{i}")
      continue
    }
    if c > 1000000 {
      emit(f"body:abort:{i}")
      break
    }
    emit(f"body:process:{i}:{c}")
  }
  emit("body:loop-done")
}

fn run_scenario_loop_drops() {
  mark_base()
  scenario_loop_drops()
  let expected: Array<string> = [
    "conn:open:loop:0",
    "body:skip:0",
    "conn:return:loop:0",
    "conn:open:loop:1",
    "body:process:1:7",
    "conn:return:loop:1",
    "conn:open:loop:2",
    "body:abort:2",
    "conn:return:loop:2",
    "body:loop-done"
  ]
  check_seq("loop_drops_continue_break", expected)
}

// =============================================================================
// SCENARIO 4: Early return runs all pending drops before returning.
// Book "Early Return". Returns from inside a for-loop; the conn (declared before
// the loop) and the per-iteration cursor both drop before return completes.
// =============================================================================

fn find_first(target: int) -> string {
  let conn: Connection = open_conn("search", 4)
  let rows: Array<int> = [11, 22, 33]
  let n: int = rows.len()
  for i in 0..n {
    let cur: Cursor = open_cursor(4, i)
    let v: int = rows[i]
    if v == target {
      emit(f"body:match:{v}")
      return f"found:{v}"
    }
  }
  emit("body:nomatch")
  "not-found"
}

fn run_scenario_early_return() {
  mark_base()
  let result: string = find_first(22)
  // i=0: cursor open(0), v=11 no match, cursor close(0)
  // i=1: cursor open(1), v=22 match -> body:match, then drops before return:
  //      cursor(1) closes, then conn returns (reverse order across exited scopes)
  let expected: Array<string> = [
    "conn:open:search:4",
    "cursor:open:4:0",
    "cursor:close:4:0",
    "cursor:open:4:1",
    "body:match:22",
    "cursor:close:4:1",
    "conn:return:search:4"
  ]
  check_seq("early_return_drops_all", expected)
  check_str("early_return_value", "found:22", result)
}

// =============================================================================
// SCENARIO 5: Nested scopes -- value escapes the block, resource drops at block
// end. Book "Nested Scopes" / "load_and_transform".
// =============================================================================

fn load_and_transform() -> int {
  let data: int = {
    let src: Connection = open_conn("source", 5)
    emit("body:read")
    42
  }
  // src dropped here
  let dest: Connection = open_conn("dest", 6)
  emit(f"body:bulk-insert:{data}")
  data
}

fn run_scenario_nested_scopes() {
  mark_base()
  let out: int = load_and_transform()
  let expected: Array<string> = [
    "conn:open:source:5",
    "body:read",
    "conn:return:source:5",
    "conn:open:dest:6",
    "body:bulk-insert:42",
    "conn:return:dest:6"
  ]
  check_seq("nested_scopes_value_escape", expected)
  check_int("nested_scopes_value", 42, out)
}

