// =============================================================================
// SCENARIO 6: Conditional drop body (active vs inactive).
// Book "Custom Connection Type": drop() returns to pool only when active.
// We build an inactive connection by constructing the type directly.
// =============================================================================

fn scenario_conditional_drop() {
  let live: Connection = open_conn("live", 10)
  let dead: Connection = Connection { pool: "dead", id: 11, active: false }
  emit("conn:make:dead:11")
  emit("body:done")
}

fn run_scenario_conditional_drop() {
  mark_base()
  scenario_conditional_drop()
  // reverse order: dead (declared last) drops first -> conn:skip, then live -> conn:return
  let expected: Array<string> = [
    "conn:open:live:10",
    "conn:make:dead:11",
    "body:done",
    "conn:skip:dead:11",
    "conn:return:live:10"
  ]
  check_seq("conditional_drop_active_flag", expected)
}

// =============================================================================
// SCENARIO 7: Multiple homogeneous resources -- three files, reverse drop.
// Book reverse-order guarantee generalizes to N bindings.
// =============================================================================

fn scenario_multi_file() {
  let f1: FileHandle = open_file("a.log")
  let f2: FileHandle = open_file("b.log")
  let f3: FileHandle = open_file("c.log")
  emit("body:fan-out")
}

fn run_scenario_multi_file() {
  mark_base()
  scenario_multi_file()
  let expected: Array<string> = [
    "file:open:a.log",
    "file:open:b.log",
    "file:open:c.log",
    "body:fan-out",
    "file:close:c.log",
    "file:close:b.log",
    "file:close:a.log"
  ]
  check_seq("multi_file_reverse", expected)
}

// =============================================================================
// SCENARIO 8: Lock + nested block. A lock is held for the whole function; an
// inner block acquires a connection that drops before the lock is released.
// =============================================================================

fn scenario_lock_nested() {
  let lk: Lock = acquire_lock("table:records")
  {
    let conn: Connection = open_conn("locked", 12)
    emit("body:critical-section")
  }
  emit("body:after-critical")
}

fn run_scenario_lock_nested() {
  mark_base()
  scenario_lock_nested()
  let expected: Array<string> = [
    "lock:acquire:table:records",
    "conn:open:locked:12",
    "body:critical-section",
    "conn:return:locked:12",
    "body:after-critical",
    "lock:release:table:records"
  ]
  check_seq("lock_nested_block", expected)
}

// =============================================================================
// SCENARIO 9: Full unit-of-work -- conn -> tx -> cursor with an inner staging
// block, exercising reverse order across the whole stack plus a scoped block.
// This is the "transact" best-practice composed with "Block Scoping".
// =============================================================================

fn unit_of_work() -> int {
  let conn: Connection = open_conn("uow", 20)
  let tx: Transaction = begin_tx(20)
  let staged: int = {
    let cur: Cursor = open_cursor(20, 8)
    emit("body:stage")
    8
  }
  // cur dropped here, before commit
  emit(f"body:commit:{staged}")
  staged
}

fn run_scenario_unit_of_work() {
  mark_base()
  let rows: int = unit_of_work()
  let expected: Array<string> = [
    "conn:open:uow:20",
    "tx:begin:20",
    "cursor:open:20:8",
    "body:stage",
    "cursor:close:20:8",
    "body:commit:8",
    "tx:rollback:20",
    "conn:return:uow:20"
  ]
  check_seq("unit_of_work_full_stack", expected)
  check_int("unit_of_work_rows", 8, rows)
}

// =============================================================================
// SCENARIO 10: Loop that opens a connection AND a cursor each iteration --
// per-iteration reverse drop (cursor before conn) at the end of every pass.
// =============================================================================

fn scenario_loop_pair() {
  for i in 0..3 {
    let conn: Connection = open_conn("batch", i)
    let cur: Cursor = open_cursor(i, i)
    emit(f"body:row:{i}")
  }
}

fn run_scenario_loop_pair() {
  mark_base()
  scenario_loop_pair()
  let expected: Array<string> = [
    "conn:open:batch:0", "cursor:open:0:0", "body:row:0", "cursor:close:0:0", "conn:return:batch:0",
    "conn:open:batch:1", "cursor:open:1:1", "body:row:1", "cursor:close:1:1", "conn:return:batch:1",
    "conn:open:batch:2", "cursor:open:2:2", "body:row:2", "cursor:close:2:2", "conn:return:batch:2"
  ]
  check_seq("loop_pair_per_iter_reverse", expected)
}

