fn scenario_mixed_kinds() {
  let conn: Connection = open_conn("mixed", 30)
  let file: FileHandle = open_file("mixed.log")
  let lock: Lock = acquire_lock("mixed:res")
  emit("body:mixed-work")
}

fn run_scenario_mixed_kinds() {
  mark_base()
  scenario_mixed_kinds()
  let expected: Array<string> = [
    "conn:open:mixed:30",
    "file:open:mixed.log",
    "lock:acquire:mixed:res",
    "body:mixed-work",
    "lock:release:mixed:res",
    "file:close:mixed.log",
    "conn:return:mixed:30"
  ]
  check_seq("mixed_resource_kinds_reverse", expected)
}

print("== scenarios defined (part 4) ==")

// =============================================================================
// SCENARIO 15: Composite ETL job -- iterate over a fixed dataset, for each
// partition open a connection + cursor, "process" rows (sum), and let RAII
// close them per partition. Also assert the computed numeric aggregate, so the
// program proves both ordering AND data correctness.
//
// dataset partitions (deterministic fixtures):
//   p0: [1, 2, 3]      sum = 6
//   p1: [10, 20]       sum = 30
//   p2: [5]            sum = 5
//   total = 41
// =============================================================================

fn partition_sum(values: Array<int>) -> int {
  let mut acc: int = 0
  let n: int = values.len()
  for i in 0..n {
    let v: int = values[i]
    acc = acc + v
  }
  acc
}

fn etl_job() -> int {
  let p0: Array<int> = [1, 2, 3]
  let p1: Array<int> = [10, 20]
  let p2: Array<int> = [5]
  let parts: Array<Array<int>> = [p0, p1, p2]
  let np: int = parts.len()
  let mut total: int = 0
  for pi in 0..np {
    let conn: Connection = open_conn("etl", pi)
    let part: Array<int> = parts[pi]
    let plen: int = part.len()
    let cur: Cursor = open_cursor(pi, plen)
    let s: int = partition_sum(part)
    emit(f"body:partition:{pi}:{s}")
    total = total + s
    // cur then conn drop at end of iteration (reverse)
  }
  emit(f"body:etl-total:{total}")
  total
}

fn run_scenario_etl() {
  mark_base()
  let total: int = etl_job()
  let expected: Array<string> = [
    "conn:open:etl:0", "cursor:open:0:3", "body:partition:0:6", "cursor:close:0:3", "conn:return:etl:0",
    "conn:open:etl:1", "cursor:open:1:2", "body:partition:1:30", "cursor:close:1:2", "conn:return:etl:1",
    "conn:open:etl:2", "cursor:open:2:1", "body:partition:2:5", "cursor:close:2:1", "conn:return:etl:2",
    "body:etl-total:41"
  ]
  check_seq("etl_job_order", expected)
  check_int("etl_job_total", 41, total)
}

// =============================================================================
// SCENARIO 16: Early return from a NON-loop guard, before vs after a block.
// Verifies the resource declared BEFORE an early return drops, and a resource
// that would be declared AFTER never gets created.
// =============================================================================

fn guarded(abort: bool) -> string {
  let pre: Lock = acquire_lock("pre")
  if abort {
    emit("body:abort")
    return "aborted"
  }
  let post: Lock = acquire_lock("post")
  emit("body:full")
  "completed"
}

fn run_scenario_guarded_abort() {
  mark_base()
  let r: string = guarded(true)
  let expected: Array<string> = [
    "lock:acquire:pre",
    "body:abort",
    "lock:release:pre"
  ]
  check_seq("guarded_abort_path", expected)
  check_str("guarded_abort_value", "aborted", r)
}

fn run_scenario_guarded_full() {
  mark_base()
  let r: string = guarded(false)
  let expected: Array<string> = [
    "lock:acquire:pre",
    "lock:acquire:post",
    "body:full",
    "lock:release:post",
    "lock:release:pre"
  ]
  check_seq("guarded_full_path", expected)
  check_str("guarded_full_value", "completed", r)
}

// =============================================================================
// SCENARIO 18: Committed transaction vs rolled-back -- exercises the two drop
// branches of Transaction. A committed tx finalizes; an uncommitted one rolls
// back. We build a committed tx directly and verify the drop branch.
// =============================================================================

fn scenario_tx_commit() {
  let conn: Connection = open_conn("txpool", 40)
  let tx: Transaction = Transaction { conn_id: 40, committed: true }
  emit("tx:begin:40")
  emit("body:commit-work")
}

fn run_scenario_tx_commit() {
  mark_base()
  scenario_tx_commit()
  // reverse drop: tx first (committed -> finalize), then conn
  let expected: Array<string> = [
    "conn:open:txpool:40",
    "tx:begin:40",
    "body:commit-work",
    "tx:finalize:40",
    "conn:return:txpool:40"
  ]
  check_seq("tx_commit_branch", expected)
}

// =============================================================================
// SCENARIO 19: Trait method alongside Drop. A type can implement both Drop and
// another trait (Named). Calling the trait method does not affect drop order;
// the Drop still fires at scope exit. Book "Custom Connection Type" shows a
// type implementing Drop and Display together.
// =============================================================================

fn scenario_named_drop() {
  let conn: Connection = open_conn("named", 50)
  let label: string = conn.name()
  emit(f"body:label:{label}")
}

fn run_scenario_named_drop() {
  mark_base()
  scenario_named_drop()
  let expected: Array<string> = [
    "conn:open:named:50",
    "body:label:conn(50@named)",
    "conn:return:named:50"
  ]
  check_seq("named_trait_with_drop", expected)
}

// =============================================================================
// SCENARIO 20: Combined nested block + early return. An outer lock is held; an
// inner block opens and releases a connection; then an early return fires while
// the lock is still held. The inner conn drops at block end (before the return
// region), and the outer lock drops on the early return.
// =============================================================================

fn nested_then_return(skip: bool) -> string {
  let lk: Lock = acquire_lock("outer")
  let staged: int = {
    let conn: Connection = open_conn("inner", 60)
    emit("body:stage")
    7
  }
  // conn dropped here
  if skip {
    emit(f"body:early:{staged}")
    return "early"
  }
  emit(f"body:full:{staged}")
  "full"
}

fn run_scenario_nested_then_return() {
  mark_base()
  let r: string = nested_then_return(true)
  let expected: Array<string> = [
    "lock:acquire:outer",
    "conn:open:inner:60",
    "body:stage",
    "conn:return:inner:60",
    "body:early:7",
    "lock:release:outer"
  ]
  check_seq("nested_block_then_early_return", expected)
  check_str("nested_then_return_value", "early", r)
}

// =============================================================================
// SCENARIO 21: Nested loops, each level holding a resource. Inner-loop bindings
// drop at the end of every inner iteration; outer-loop bindings drop at the end
// of every outer iteration -- after all inner work for that pass.
// =============================================================================

fn scenario_nested_loops() {
  for outer in 0..2 {
    let oconn: Connection = open_conn("outer", outer)
    for inner in 0..2 {
      let icur: Cursor = open_cursor(outer, inner)
      emit_tag2("body:cell", outer, inner)
    }
  }
}

fn emit_tag2(tag: string, a: int, b: int) {
  let m: string = f"{tag}:{a}:{b}"
  emit(m)
}

fn run_scenario_nested_loops() {
  mark_base()
  scenario_nested_loops()
  // outer=0: open outer:0; inner 0 (cur close 0:0), inner 1 (cur close 0:1); conn return outer:0
  // outer=1: open outer:1; inner 0 (cur close 1:0), inner 1 (cur close 1:1); conn return outer:1
  let expected: Array<string> = [
    "conn:open:outer:0",
    "cursor:open:0:0", "body:cell:0:0", "cursor:close:0:0",
    "cursor:open:0:1", "body:cell:0:1", "cursor:close:0:1",
    "conn:return:outer:0",
    "conn:open:outer:1",
    "cursor:open:1:0", "body:cell:1:0", "cursor:close:1:0",
    "cursor:open:1:1", "body:cell:1:1", "cursor:close:1:1",
    "conn:return:outer:1"
  ]
  check_seq("nested_loops_per_level_drop", expected)
}

// =============================================================================
// MAIN DRIVER
// =============================================================================

run_scenario_dependent_stack()
run_scenario_block_scoping()
run_scenario_loop_drops()
run_scenario_early_return()
run_scenario_nested_scopes()
run_scenario_conditional_drop()
run_scenario_multi_file()
run_scenario_lock_nested()
run_scenario_unit_of_work()
run_scenario_loop_pair()
run_scenario_deep_nest()
run_scenario_call_boundary()
run_scenario_retry()
run_scenario_mixed_kinds()
run_scenario_etl()
run_scenario_guarded_abort()
run_scenario_guarded_full()
run_scenario_tx_commit()
run_scenario_named_drop()
run_scenario_nested_then_return()
run_scenario_nested_loops()

print(f"checks_run={CHECKS}")
if FAILS == 0 {
  print("ALL_CHECKS_PASSED")
} else {
  print(f"FAILS={FAILS}")
}
