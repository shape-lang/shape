// =============================================================================
// SCENARIO 11: Deeply nested blocks -- three levels, each with its own resource.
// Innermost drops first as each block exits, outermost last.
// =============================================================================

fn scenario_deep_nest() {
  let l1: Lock = acquire_lock("L1")
  {
    let l2: Lock = acquire_lock("L2")
    {
      let l3: Lock = acquire_lock("L3")
      emit("body:innermost")
    }
    emit("body:mid")
  }
  emit("body:outer")
}

fn run_scenario_deep_nest() {
  mark_base()
  scenario_deep_nest()
  let expected: Array<string> = [
    "lock:acquire:L1",
    "lock:acquire:L2",
    "lock:acquire:L3",
    "body:innermost",
    "lock:release:L3",
    "body:mid",
    "lock:release:L2",
    "body:outer",
    "lock:release:L1"
  ]
  check_seq("deep_nested_blocks", expected)
}

// =============================================================================
// SCENARIO 12: Function call boundary -- a callee that opens and drops its own
// resource returns to the caller, then the caller's resource drops. Verifies
// drops are bounded by each function's own scope.
// =============================================================================

fn helper_open(tag: int) -> int {
  let conn: Connection = open_conn("helper", tag)
  emit(f"body:helper:{tag}")
  tag * 10
}

fn scenario_call_boundary() {
  let outer: FileHandle = open_file("outer.dat")
  let v1: int = helper_open(1)
  let v2: int = helper_open(2)
  emit(f"body:caller:{v1}:{v2}")
}

fn run_scenario_call_boundary() {
  mark_base()
  scenario_call_boundary()
  // each helper call fully opens+drops its conn before returning
  let expected: Array<string> = [
    "file:open:outer.dat",
    "conn:open:helper:1",
    "body:helper:1",
    "conn:return:helper:1",
    "conn:open:helper:2",
    "body:helper:2",
    "conn:return:helper:2",
    "body:caller:10:20",
    "file:close:outer.dat"
  ]
  check_seq("call_boundary_scoped_drops", expected)
}

// =============================================================================
// SCENARIO 13: Retry loop -- attempts until success, breaks out. Each attempt
// holds a connection that is dropped per iteration; the successful attempt
// breaks (drop runs on break).
// success_on = 2  ->  attempt 0 fail, attempt 1 fail, attempt 2 success+break
// =============================================================================

fn scenario_retry() {
  let success_on: int = 2
  for attempt in 0..5 {
    let conn: Connection = open_conn("retry", attempt)
    if attempt == success_on {
      emit_tag("body:success", attempt)
      break
    }
    emit_tag("body:fail", attempt)
  }
  emit("body:retry-done")
}

fn run_scenario_retry() {
  mark_base()
  scenario_retry()
  let expected: Array<string> = [
    "conn:open:retry:0",
    "body:fail:0",
    "conn:return:retry:0",
    "conn:open:retry:1",
    "body:fail:1",
    "conn:return:retry:1",
    "conn:open:retry:2",
    "body:success:2",
    "conn:return:retry:2",
    "body:retry-done"
  ]
  check_seq("retry_loop_break", expected)
}

