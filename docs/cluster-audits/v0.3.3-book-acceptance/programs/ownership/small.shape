// small.shape — Ownership Deep Dive core concepts
// Book: advanced/ownership-deep-dive.mdx
// Exercises (book-faithful, only behaviors the chapter documents AND that
// actually run): move on `let q = p`, explicit clone keeps both bindings live,
// scalar Copy, call-arg share-by-value (v0.3.3), var smart-default stack-mutable,
// struct field mutation under `let mut`, auto-ref method dispatch.
// Self-checking: every result asserted against a book-derived expected value.

fn check(name: string, got: int, expected: int) {
    if got != expected {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}

// --- Move: `q` takes ownership of the struct; `p` is consumed.
//     (book §"Move, Clone, Use-After-Move", lines 122-125, runnable=true)
type Point { x: int, y: int }
let p = Point { x: 1, y: 2 }
let q = p
check("move_q_x", q.x, 1)
check("move_q_y", q.y, 2)

// --- Clone: explicit deep copy keeps both bindings live.
//     `clone a` keyword and `a.clone()` method are identical (book lines 104-110).
let a = [10, 20, 30]
let b = clone a
let c = a.clone()
check("clone_kw_orig", a[0], 10)
check("clone_kw_b", b[0], 10)
check("clone_method_c", c[2], 30)

// Clone independence: mutating the copy must not touch the original
// (book §"Copy Semantics" — arrays are NOT Copy; clone is a deep copy).
let mut dup = a.clone()
dup.push(40)
check("clone_indep_orig_len", a.len(), 3)
check("clone_indep_dup_len", dup.len(), 4)
check("clone_indep_dup_last", dup[3], 40)

// --- Scalars stay Copy — both usable, no move (book lines 90-95, 133-136).
let n = 7
let m = n
check("copy_n", n, 7)
check("copy_sum", n + m, 14)

// --- Call-arg share-by-value (v0.3.3): `nums` still usable after the call;
//     mutation through the by-value param is caller-visible (book lines 156-163).
fn append(xs) { xs.push(4) }
let nums = [1, 2, 3]
append(nums)
check("share_len", nums.len(), 4)
check("share_val", nums[3], 4)

// --- var smart-default: mutated-in-scope -> Direct(mutable), stack (book lines 46, 34-41).
var counter = 0
counter = counter + 1
counter = counter + 1
check("var_direct_mut", counter, 2)

var acc = 0
for v in [1, 2, 3, 4] {
    acc = acc + v
}
check("var_loop_acc", acc, 10)

// --- Struct field mutation under `let mut` (book §"Disjoint field borrows").
let mut pt = Point { x: 1, y: 2 }
pt.x = 100
pt.y = 200
check("field_x", pt.x, 100)
check("field_y", pt.y, 200)

// --- Owned array param + auto-ref method dispatch; caller binding intact
//     (book §"Auto-Referencing": arr.len() -> (&arr).len()).
fn total(arr: Array<int>) -> int {
    var t = 0
    for v in arr {
        t = t + v
    }
    return t
}
let data = [2, 4, 6, 8]
check("owned_param_sum", total(data), 20)
check("owned_param_intact", data.len(), 4)

// --- var-copy auto-clone independence (S1b 2026-06-21): a `var copy = src`
//     rebind of a still-live heap source produces an INDEPENDENT value, so
//     mutating the copy does NOT touch the source (the `var` smart-default
//     clone-on-still-live / SharedCow intent). Pre-fix this aliased the
//     backing TypedArray (book §"Copy Semantics" var-CoW BOOK-WRONG finding).
var vsrc = [1, 2, 3]
var vcopy = vsrc
vcopy.push(99)
check("varcopy_src_intact", vsrc.len(), 3)
check("varcopy_copy_grew", vcopy.len(), 4)
vcopy[0] = 9
check("varcopy_src_idx_intact", vsrc[0], 1)
check("varcopy_copy_idx_set", vcopy[0], 9)

print("ALL_CHECKS_PASSED")
