// small.shape — Ownership Deep Dive core concepts (book: advanced/ownership-deep-dive.mdx)
// Exercises: let / let mut / var smart-default, Copy semantics, array clone,
// struct field mutation, owned fn params, auto-ref method dispatch.
// Self-checking: asserts every result against a book-derived expected value.

fn check(name: string, got: int, expected: int) {
    if got != expected {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}

// --- Copy semantics (book "Copy Semantics": int is implicitly Copy) ---
// `let b = a` copies the int; `a` remains usable.
let a = 5
let b = a
check("int_copy_a", a, 5)
check("int_copy_b", b, 5)

// --- let mut: single-owner, zero-overhead mutation (book "Three Keywords") ---
let mut counter = 0
counter = counter + 10
counter = counter + 5
check("let_mut", counter, 15)

// --- var smart-default: mutated within scope -> Direct(mutable) (book table) ---
var acc = 0
for v in [1, 2, 3, 4] {
    acc = acc + v
}
check("var_direct_mut", acc, 10)

// --- Array clone: arrays are NOT Copy; `.clone()` makes an independent copy ---
// (book "Clone Trait" + "Copy Semantics" table). Mutating the clone must
// not affect the original.
// The `clone x` keyword and `x.clone()` method are identical (book "Clone
// Trait"): both produce an independent deep copy. (The keyword previously
// aliased; fixed via the ownership-modifier → `.clone()` desugar.)
let original = [10, 20, 30]
let mut dup = original.clone()
dup.push(40)
check("clone_independent_orig_len", original.len(), 3)
check("clone_independent_dup_len", dup.len(), 4)
check("clone_orig_first", original[0], 10)
check("clone_dup_last", dup[3], 40)

// `clone` KEYWORD form — must match the `.clone()` method (independent copy).
let kw_orig = [10, 20, 30]
let mut kw_dup = clone kw_orig
kw_dup.push(40)
check("clone_kw_orig_len", kw_orig.len(), 3)
check("clone_kw_dup_len", kw_dup.len(), 4)

// --- Struct field mutation on let mut (book "Disjoint field borrows") ---
type Point { x: int, y: int }
let mut p = Point { x: 1, y: 2 }
p.x = 100
p.y = 200
check("field_x", p.x, 100)
check("field_y", p.y, 200)

// --- Owned value passed to fn; auto-ref for method dispatch (book "Auto-Referencing") ---
fn total(arr: Array<int>) -> int {
    var t = 0
    for v in arr {
        t = t + v
    }
    return t
}
let data = [2, 4, 6, 8]
check("owned_param_sum", total(data), 20)
// data still usable after the call (Arc-shared, no move-out of caller)
check("owned_param_caller_intact", data.len(), 4)

// --- var auto move/clone inference (book "Smart Move/Clone Inference") ---
// `copy = data` with data used after -> auto-clone; both independent.
var src = [7, 7, 7]
var copyOf = src
check("var_autoclone_src", src.len(), 3)
check("var_autoclone_copy", copyOf.len(), 3)

print("ALL_CHECKS_PASSED")
