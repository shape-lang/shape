from std::core::intrinsics use { Result, Option, AnyError, Ok, Err }

// Book §Fallible: `as Type?` returns Result<int, AnyError>
fn parse_int(raw: string) -> Result<int> {
    let n = (raw as int?)?;
    return Ok(n);
}

match parse_int("42") {
    Ok(v) => print(f"parsed {v}"),
    Err(e) => print("parse err"),
}

match parse_int("notanumber") {
    Ok(v) => print(f"parsed {v}"),
    Err(e) => print("parse err"),
}
