// small.shape — error-handling slice (book: fundamentals/error-handling.mdx)
// Exercises: Result/Option constructors, `?` propagation, `!!` context,
// `??` None-coalescing, `as Type?` fallible cast. Self-checking.
from std::core::intrinsics use { Result, Option, AnyError, Ok, Err }

fn read_file(path: string) -> Result<string> {
    if path == "" { return Err("empty path"); }
    return Ok("port = 8080");
}

fn parse_config(text: string) -> Result<int> {
    let n = ("8080" as int?)?;
    return Ok(n);
}

fn load_config(path: string) -> Result<int> {
    let text = (read_file(path) !! "Failed to read config")?;
    return parse_config(text) !! "Config parse failed";
}

fn find_user(found: bool) -> Option<int> {
    if found { return Some(7); }
    return None;
}

fn lookup(found: bool) -> Result<int> {
    let id = (find_user(found) !! "User not found")?;
    return Ok(id);
}

let mut ok = true;

match load_config("config.shape") {
    Ok(v) => { if v != 8080 { ok = false; print("CHECK_FAILED: load_ok expected=8080"); } }
    Err(e) => { ok = false; print("CHECK_FAILED: load_ok unexpected err"); }
}

match load_config("") {
    Ok(v) => { ok = false; print("CHECK_FAILED: load_err expected Err got Ok"); }
    Err(e) => { }
}

match lookup(true) {
    Ok(v) => { if v != 7 { ok = false; print("CHECK_FAILED: lookup_ok expected=7"); } }
    Err(e) => { ok = false; print("CHECK_FAILED: lookup_ok unexpected err"); }
}

match lookup(false) {
    Ok(v) => { ok = false; print("CHECK_FAILED: lookup_none expected Err got Ok"); }
    Err(e) => { }
}

let a = find_user(false) ?? 99;
if a != 99 { ok = false; print("CHECK_FAILED: coalesce_none expected=99"); }

let b = find_user(true) ?? 99;
if b != 7 { ok = false; print("CHECK_FAILED: coalesce_some expected=7"); }

fn wrap_plain() -> Result<int> { return 42 !! "ctx"; }
match wrap_plain() {
    Ok(v) => { if v != 42 { ok = false; print("CHECK_FAILED: wrap_plain expected=42"); } }
    Err(e) => { ok = false; print("CHECK_FAILED: wrap_plain unexpected err"); }
}

if ok { print("ALL_CHECKS_PASSED"); }
