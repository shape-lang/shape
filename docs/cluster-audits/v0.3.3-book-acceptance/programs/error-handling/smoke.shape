from std::core::intrinsics use { Result, Option, AnyError, Ok, Err }

fn parse_positive(raw: int) -> Result<int> {
    if raw < 0 {
        return Err("negative");
    }
    return Ok(raw);
}

fn use_q(raw: int) -> Result<int> {
    let n = parse_positive(raw)?;
    return Ok(n + 1);
}

let a = use_q(5);
match a {
    Ok(v) => print(f"ok {v}"),
    Err(e) => print(f"err"),
}
