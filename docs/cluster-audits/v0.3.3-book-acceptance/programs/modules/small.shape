// Module-system smoke: named import, named alias, namespace import,
// type export, and a module that imports a sibling module.
from geomlib::transforms use { center, clamp, Bounds }
from geomlib::stats use { variance as varc }
use geomlib::stats

let data = [10.0, 12.0, 11.5, 13.0, 9.5]

// mean is 11.3 -> centered values sum to ~0
let centered = center(data)
let csum = centered.sum()
if csum > 0.0001 || csum < -0.0001 {
    print(f"CHECK_FAILED: centered_sum expected=0 got={csum}")
}

// variance via named alias vs via namespace import must agree
let v1 = varc(data)
let v2 = stats::variance(data)
if v1 != v2 {
    print(f"CHECK_FAILED: variance_paths expected_equal got {v1} {v2}")
}

// imported type + clamp from transforms module
let b = Bounds { lo: 0.0, hi: 10.0 }
let cl = clamp(13.0, b)
if cl != 10.0 {
    print(f"CHECK_FAILED: clamp expected=10 got={cl}")
}
let cl2 = clamp(-5.0, b)
if cl2 != 0.0 {
    print(f"CHECK_FAILED: clamp_lo expected=0 got={cl2}")
}

print(f"mean-centered sum: {csum}")
print(f"variance: {v1}")
print("ALL_CHECKS_PASSED")
