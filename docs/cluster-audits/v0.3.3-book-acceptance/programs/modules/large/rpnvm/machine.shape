// rpnvm/machine.shape -- importable as rpnvm::machine
//
// The RPN stack machine evaluator.  It imports arithmetic primitives from
// rpnvm::ops and opcode/status constants from rpnvm::codes (cross-module
// imports used inside module function bodies -- verified working).
//
// Calling convention (chosen to fit the working module idioms in this build):
//   * `prog`  : Array<int>  -- the program (caller-built literal array)
//   * `stack` : Array<int>  -- scratch operand stack (caller-built, capacity N)
//   * `res`   : Array<int>  -- 2-cell result: res[0]=status, res[1]=value
// The function returns the status code AND writes (status, value) into `res`,
// so callers can inspect both without binding an imported call to a `let`.

from rpnvm::ops use { add, sub, mul, idiv, imod, neg, absx, minx, maxx, powx }
from rpnvm::codes use {
    op_add, op_sub, op_mul, op_div, op_mod, op_neg, op_dup, op_swap,
    op_min, op_max, op_abs, op_pow, op_drop,
    status_ok, status_underflow, status_overflow, status_div_zero,
    status_bad_op, status_empty, arity
}

// Apply a binary operator code to (a, b).  Caller has validated div/mod guards.
fn apply_binary(code: int, a: int, b: int) -> int {
    if code == op_add() {
        add(a, b)
    } else if code == op_sub() {
        sub(a, b)
    } else if code == op_mul() {
        mul(a, b)
    } else if code == op_div() {
        idiv(a, b)
    } else if code == op_mod() {
        imod(a, b)
    } else if code == op_min() {
        minx(a, b)
    } else if code == op_max() {
        maxx(a, b)
    } else if code == op_pow() {
        powx(a, b)
    } else if code == op_swap() {
        // swap is handled structurally in the eval loop; never reaches here
        b
    } else {
        0
    }
}

// Apply a unary operator code to a.
fn apply_unary(code: int, a: int) -> int {
    if code == op_neg() {
        neg(a)
    } else if code == op_abs() {
        absx(a)
    } else {
        a
    }
}

// Evaluate `prog` using `stack` as scratch space.  Writes status+value into
// `res` and returns the status code.  `cap` is the usable capacity of `stack`.
pub fn run(prog: Array<int>, stack: Array<int>, cap: int, res: Array<int>) -> int {
    let mut sp = 0
    let mut i = 0
    let mut status = status_ok()
    while i < prog.length {
        let tok = prog[i]
        if tok >= 0 {
            // push literal
            if sp >= cap {
                status = status_overflow()
                i = prog.length
            } else {
                stack[sp] = tok
                sp = sp + 1
                i = i + 1
            }
        } else if tok == op_dup() {
            if sp < 1 {
                status = status_underflow()
                i = prog.length
            } else if sp >= cap {
                status = status_overflow()
                i = prog.length
            } else {
                stack[sp] = stack[sp - 1]
                sp = sp + 1
                i = i + 1
            }
        } else if tok == op_drop() {
            if sp < 1 {
                status = status_underflow()
                i = prog.length
            } else {
                sp = sp - 1
                i = i + 1
            }
        } else if tok == op_swap() {
            if sp < 2 {
                status = status_underflow()
                i = prog.length
            } else {
                let top = stack[sp - 1]
                let below = stack[sp - 2]
                stack[sp - 1] = below
                stack[sp - 2] = top
                i = i + 1
            }
        } else if arity(tok) == 1 {
            if sp < 1 {
                status = status_underflow()
                i = prog.length
            } else {
                let a = stack[sp - 1]
                sp = sp - 1
                stack[sp] = apply_unary(tok, a)
                sp = sp + 1
                i = i + 1
            }
        } else if arity(tok) == 2 {
            if sp < 2 {
                status = status_underflow()
                i = prog.length
            } else {
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                // guard division / modulo by zero
                if (tok == op_div() || tok == op_mod()) && b == 0 {
                    status = status_div_zero()
                    i = prog.length
                } else {
                    sp = sp - 2
                    stack[sp] = apply_binary(tok, a, b)
                    sp = sp + 1
                    i = i + 1
                }
            }
        } else {
            status = status_bad_op()
            i = prog.length
        }
    }

    if status == status_ok() && sp < 1 {
        status = status_empty()
    }

    res[0] = status
    if status == status_ok() {
        res[1] = stack[sp - 1]
    } else {
        res[1] = 0
    }
    status
}

// Convenience: count how many operators of a given arity a program contains.
pub fn count_arity(prog: Array<int>, want: int) -> int {
    let mut n = 0
    let mut i = 0
    while i < prog.length {
        if arity(prog[i]) == want { n = n + 1 }
        i = i + 1
    }
    n
}

// Validate a program WITHOUT executing it: returns status_ok() if the program
// is well-formed (no unknown opcode, never underflows, ends with >= 1 operand),
// else the first failing status code.  Mirrors run()'s status taxonomy.
pub fn validate(prog: Array<int>) -> int {
    let mut depth = 0
    let mut i = 0
    let mut status = status_ok()
    while i < prog.length {
        let tok = prog[i]
        let ar = arity(tok)
        if tok >= 0 {
            depth = depth + 1
        } else if tok == op_dup() {
            if depth < 1 { status = status_underflow()  i = prog.length } else { depth = depth + 1 }
        } else if tok == op_drop() {
            if depth < 1 { status = status_underflow()  i = prog.length } else { depth = depth - 1 }
        } else if tok == op_swap() {
            if depth < 2 { status = status_underflow()  i = prog.length }
        } else if ar == 1 {
            if depth < 1 { status = status_underflow()  i = prog.length }
        } else if ar == 2 {
            if depth < 2 { status = status_underflow()  i = prog.length } else { depth = depth - 1 }
        } else {
            status = status_bad_op()
            i = prog.length
        }
        if status == status_ok() { i = i + 1 }
    }
    if status == status_ok() && depth < 1 { status = status_empty() }
    status
}

// Count the literal tokens (>= 0) in a program.
pub fn count_literals(prog: Array<int>) -> int {
    let mut n = 0
    let mut i = 0
    while i < prog.length {
        if prog[i] >= 0 { n = n + 1 }
        i = i + 1
    }
    n
}

// Sum of all literal tokens in a program (a simple structural fingerprint).
pub fn sum_literals(prog: Array<int>) -> int {
    let mut acc = 0
    let mut i = 0
    while i < prog.length {
        if prog[i] >= 0 { acc = acc + prog[i] }
        i = i + 1
    }
    acc
}

// Largest literal in a program, or -1 if the program has no literals.
pub fn max_literal(prog: Array<int>) -> int {
    let mut best = 0 - 1
    let mut i = 0
    while i < prog.length {
        if prog[i] >= 0 && prog[i] > best { best = prog[i] }
        i = i + 1
    }
    best
}

// Run `prog` and return ONLY its value if status is OK, else the sentinel.
// Convenience wrapper around run() for fixtures that only care about the value.
pub fn eval_or(prog: Array<int>, stack: Array<int>, cap: int, sentinel: int, res: Array<int>) -> int {
    run(prog, stack, cap, res)
    if res[0] == status_ok() { res[1] } else { sentinel }
}

// Static maximum stack depth a (well-formed) program needs.  Returns -1 if the
// program underflows at any point (more operands consumed than available).
pub fn max_depth(prog: Array<int>) -> int {
    let mut depth = 0
    let mut peak = 0
    let mut i = 0
    let mut bad = false
    while i < prog.length {
        let tok = prog[i]
        let ar = arity(tok)
        if tok >= 0 {
            depth = depth + 1
        } else if tok == op_dup() {
            // needs >= 1 operand to duplicate
            if depth < 1 { bad = true }
            depth = depth + 1
        } else if tok == op_drop() {
            // needs >= 1 operand to drop
            if depth < 1 { bad = true } else { depth = depth - 1 }
        } else if tok == op_swap() {
            // depth unchanged; needs >= 2
            if depth < 2 { bad = true }
        } else if ar == 1 {
            // depth unchanged (pop 1, push 1); needs >= 1
            if depth < 1 { bad = true }
        } else if ar == 2 {
            // pop 2, push 1; needs >= 2 BEFORE consuming
            if depth < 2 { bad = true } else { depth = depth - 1 }
        }
        if depth > peak { peak = depth }
        if depth < 0 { bad = true }
        i = i + 1
    }
    if bad { 0 - 1 } else { peak }
}
