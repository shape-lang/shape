// rpnvm/codes.shape -- importable as rpnvm::codes
//
// Opcode encoding for the RPN stack machine.  A program is an Array<int>:
//   * a token >= 0 is a literal value to PUSH onto the operand stack
//   * a token  < 0 is an operator; the negative code selects the operation
//
// Operator codes are exposed as pure zero-arg functions so other modules can
// import them by name and stay independent of the raw integer values.
// (Constants-as-functions: the module chapter exports `pub fn`, and an
// imported function used inside another module's function body resolves
// correctly -- verified working.)

pub fn op_add() -> int { -1 }   // a b -> a+b
pub fn op_sub() -> int { -2 }   // a b -> a-b
pub fn op_mul() -> int { -3 }   // a b -> a*b
pub fn op_div() -> int { -4 }   // a b -> a/b   (integer division)
pub fn op_mod() -> int { -5 }   // a b -> a%b
pub fn op_neg() -> int { -6 }   // a   -> -a
pub fn op_dup() -> int { -7 }   // a   -> a a
pub fn op_swap() -> int { -8 }  // a b -> b a
pub fn op_min() -> int { -9 }   // a b -> min(a,b)
pub fn op_max() -> int { -10 }  // a b -> max(a,b)
pub fn op_abs() -> int { -11 }  // a   -> |a|
pub fn op_pow() -> int { -12 }  // a b -> a^b    (b >= 0)
pub fn op_drop() -> int { -13 } // a   -> (nothing)

// Status codes returned by the machine in result-cell index 0.
pub fn status_ok() -> int { 0 }
pub fn status_underflow() -> int { 1 }   // operator with too few operands
pub fn status_overflow() -> int { 2 }    // push beyond stack capacity
pub fn status_div_zero() -> int { 3 }    // division or modulo by zero
pub fn status_bad_op() -> int { 4 }      // unknown negative token
pub fn status_empty() -> int { 5 }       // program left the stack empty

// Classify a token: 0 = literal, 1 = unary op, 2 = binary op, -1 = unknown.
pub fn arity(tok: int) -> int {
    if tok >= 0 {
        0
    } else if tok == -6 || tok == -7 || tok == -11 || tok == -13 {
        1
    } else if tok == -1 || tok == -2 || tok == -3 || tok == -4 || tok == -5 || tok == -8 || tok == -9 || tok == -10 || tok == -12 {
        2
    } else {
        -1
    }
}
