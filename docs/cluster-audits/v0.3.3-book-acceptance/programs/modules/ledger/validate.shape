// ledger/validate.shape
// Validation rules over transactions, returning Result<T, string>. Demonstrates
// the `?` propagation operator across a module boundary: rules call each other
// and bubble the first error up. Imports the Transaction type and helpers.

from ledger::txn use { Transaction, magnitude, txn_cat_index }
from ledger::category use { cat_count }

// A non-zero amount is required; a zero-amount transaction is rejected.
pub fn check_nonzero(t: Transaction) -> Result<int, string> {
    if t.amount == 0 {
        Err("amount must be non-zero")
    } else {
        Ok(t.amount)
    }
}

// The description must be non-empty.
pub fn check_desc(t: Transaction) -> Result<string, string> {
    if t.desc.length == 0 {
        Err("description must be non-empty")
    } else {
        Ok(t.desc)
    }
}

// The category index must be in range 0..cat_count()-1. By construction this
// always holds, but the rule guards against future enum drift.
pub fn check_cat(t: Transaction) -> Result<int, string> {
    let idx = txn_cat_index(t)
    if idx < 0 {
        Err("category index underflow")
    } else if idx >= cat_count() {
        Err("category index overflow")
    } else {
        Ok(idx)
    }
}

// Run all rules on one transaction, propagating the first failure with `?`.
// On success returns Ok(magnitude).
pub fn validate_txn(t: Transaction) -> Result<int, string> {
    let _amt = check_nonzero(t)?
    let _desc = check_desc(t)?
    let _cat = check_cat(t)?
    Ok(magnitude(t))
}

// Validate a whole batch. Returns Ok(count_validated) when every transaction
// passes, or Err(first failure message) otherwise.
pub fn validate_all(ts: Array<Transaction>) -> Result<int, string> {
    let mut n = 0
    for t in ts {
        let _ok = validate_txn(t)?
        n = n + 1
    }
    Ok(n)
}
