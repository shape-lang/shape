// numutil.shape -> module mylib? No: top-level file => importable as "smalllib::numutil"
pub fn clamp(x: int, lo: int, hi: int) -> int {
  if x < lo { lo } else if x > hi { hi } else { x }
}

pub type Bounds {
  lo: int,
  hi: int
}

pub fn clamp_b(x: int, b: Bounds) -> int {
  clamp(x, b.lo, b.hi)
}
