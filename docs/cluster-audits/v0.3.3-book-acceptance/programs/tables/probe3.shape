// Probe 3: query syntax form per tables.mdx "Query Syntax"
type Event {
  id: int,
  value: number,
  tag: string
}

let events: Table<Event> =
    [1, 50.0,  "alpha"],
    [2, 75.5,  "beta"],
    [3, 120.0, "gamma"]

let ids = from row in events
  where row.value > 70.0
  select row.id

print(ids)
