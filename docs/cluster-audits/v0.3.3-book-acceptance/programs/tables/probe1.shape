// Probe 1: row-literal Table + count + filter.count, exactly as fundamentals/tables.mdx shows
type Event {
  id: int,
  value: number,
  tag: string
}

let events: Table<Event> =
    [1, 50.0,  "alpha"],
    [2, 75.5,  "beta"],
    [3, 120.0, "gamma"]

print(events.count())

let filtered = events.filter(|row| row.value > 70.0)
print(filtered.count())
