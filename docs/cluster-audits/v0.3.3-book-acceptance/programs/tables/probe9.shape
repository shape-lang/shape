// Probe 9: filter then forEach, and orderBy on id, and limit alone
from std::core::queryable use { Queryable }

type Event {
  id: int,
  value: number,
  tag: string
}

impl Queryable for Table {
    method filter(predicate) { self.filter(predicate) }
    method orderBy(key_fn, direction) { self.orderBy(key_fn, direction) }
    method limit(n) { self.limit(n) }
    method count() { self.count() }
    method forEach(f) { self.forEach(f) }
    method execute() { self }
}

let events: Table<Event> =
    [3, 120.0, "gamma"],
    [1, 50.0,  "alpha"],
    [2, 75.5,  "beta"]

print("--- filter value>60 forEach ---")
events.filter(|row| row.value > 60.0).forEach(|row| print(f"{row.id}:{row.value}"))

print("--- orderBy id asc ---")
events.orderBy(|row| row.id, "asc").forEach(|row| print(f"{row.id}"))

print("--- limit 2 count ---")
let lim = events.limit(2)
print(f"limit2_count={lim.count()}")
