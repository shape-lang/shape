// small.shape — Content slice (fundamentals/content.mdx)
// Exercises the Content builder API the chapter teaches:
//   Content.text + style chaining, Color namespace, Content.table + borders,
//   Content.chart, and the Content trait with a direct .render() call.
// Determinism strategy: render every node to a string via .to_string() and
// assert on stable substrings / equalities (book §"Styled Text", §"Tables").
//
// NOTE: the book's headline syntax c"..." (§Content Strings), the 2-arg-less
// Content.table(records) form, render(Plain) adapter selection, and the
// print()-auto-dispatches-the-Content-trait claim do NOT hold in the shipped
// binary — see REPORT.md (book_wrong). This program uses the API that works.

let mut failures = 0

fn check(cond: bool, label: string) {
    if !cond {
        print(f"CHECK_FAILED: {label}")
        failures = failures + 1
    }
}

// --- Plain text renders to exactly its text (no codes) ---
// Book §Content Trait: Content.text(...) is the primitive text node.
let plain = Content.text("hello").to_string()
check(plain == "hello", "plain-text-roundtrip expected=hello")

// --- Styling wraps text but preserves the payload ---
// Book §Styled Text: .fg / .bold etc. chain on a ContentNode.
let styled = Content.text("Error").fg(Color.red).bold().to_string()
check(styled.contains("Error"), "styled-contains-payload")
// Styling wraps the payload in ANSI escapes, so the rendered string is
// strictly longer than the bare payload "Error" (5 chars).
let styled_len: int = styled.len()
check(styled_len > 5, "styling-adds-escape-codes")

// --- Each named color produces a distinct rendering ---
// Book §Colors: Color.red/green/blue are named colors.
let red = Content.text("X").fg(Color.red).to_string()
let green = Content.text("X").fg(Color.green).to_string()
let blue = Content.text("X").fg(Color.blue).to_string()
check(red != green, "red-distinct-from-green")
check(green != blue, "green-distinct-from-blue")
check(red.contains("X") && green.contains("X") && blue.contains("X"),
      "all-colors-keep-payload")

// --- RGB color ---
// Book §Colors: Color.rgb(r,g,b), 0-255 per channel.
let rgb = Content.text("rgb").bg(Color.rgb(40, 0, 0)).to_string()
check(rgb.contains("rgb"), "rgb-bg-keeps-payload")

// --- All decoration methods chain ---
// Book §Style Methods table.
let deco = Content.text("d").italic().underline().dim().to_string()
check(deco.contains("d"), "decoration-chain-keeps-payload")

// --- Table renders headers and cells ---
// Book §Tables. NOTE: book prose shows Content.table(records); the runtime
// takes Content.table(headers, rows) — recorded book-wrong in REPORT.
let headers = ["name", "value"]
let rows = [["test", "142.5"], ["prod", "378.2"]]
let tbl = Content.table(headers, rows).border(Border.rounded).to_string()
check(tbl.contains("name"), "table-header-name")
check(tbl.contains("value"), "table-header-value")
check(tbl.contains("test"), "table-cell-test")
check(tbl.contains("378.2"), "table-cell-378.2")
// Rounded border draws U+256D top-left corner per book §Border Styles.
check(tbl.contains("╭"), "rounded-corner-drawn")

// --- Sharp border draws a different corner ---
let sharp = Content.table(headers, rows).border(Border.sharp).to_string()
check(sharp.contains("┌"), "sharp-corner-drawn")
check(!sharp.contains("╭"), "sharp-has-no-rounded-corner")

// --- max_rows truncates ---
// Book §Table Methods: .max_rows(n) truncates after n rows.
let big = Content.table(["n"], [["1"], ["2"], ["3"], ["4"]])
    .max_rows(2)
    .to_string()
check(big.contains("more rows"), "max_rows-truncates")

// --- Chart builds without error and renders to a non-empty string ---
// Book §Charts: Content.chart(type).add(label,data).title(...).
let chart = Content.chart("line")
    .add("Revenue", [[1, 100], [2, 200], [3, 350]])
    .title("Quarterly Revenue")
    .to_string()
let chart_len: int = chart.len()
check(chart_len > 0, "chart-renders-nonempty")

// --- Content trait: implement render() and call it directly ---
// Book §Content Trait. NOTE: book claims print(value) auto-dispatches the
// trait; the runtime does NOT (recorded book-wrong). Direct .render() works.
type Label {
    text: string,
}

impl Content for Label {
    method render() {
        Content.text(self.text).bold()
    }
}

let lbl = Label { text: "tagged" }
let rendered = lbl.render().to_string()
check(rendered.contains("tagged"), "trait-render-produces-payload")

if failures == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"FAILURES: {failures}")
}
