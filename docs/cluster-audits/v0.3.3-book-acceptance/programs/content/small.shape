// small.shape — Content builders (fundamentals/content.mdx, v0.3.3 surface)
// Exercises the chapter's runnable core: Content.text + style methods, the
// Color namespace, Content.table + border styles + max_rows, and Content.chart.
// Determinism strategy: render each node to a string and assert on stable
// structure (substrings / lengths / inequalities), per the slice strategy.
//
// BOOK-GAP captured below: every runnable example in the chapter binds the node
// with `let x = Content.text(...)` and only ever print()s it. To ASSERT a
// rendered string you must annotate the .toString() result `: string`, else
// strict typing reports the operand as `unknown` at a `==` site. The chapter
// never shows this.

let mut failures = 0
fn check(cond: bool, label: string) {
    if !cond {
        print(f"CHECK_FAILED: {label}")
        failures = failures + 1
    }
}

// --- Styled text -----------------------------------------------------------
// Book lines 8-13: plain Content.text renders to its text; .toString() and
// .to_string() are aliases.
let plain: string = Content.text("Hello").toString()
let plainAlias: string = Content.text("Hello").to_string()
check(plain == "Hello", "plain text renders with no styling expected=Hello")
check(plainAlias == "Hello", "to_string is an alias of toString")
check(plain.length() == 5, "plain length expected=5")

// Book lines 156-196: style methods chain on a node and wrap it. A styled
// node differs from plain, still carries the payload, and is strictly longer
// (escape bytes added). We assert structure, not exact escape ordering.
let styled: string = Content.text("Hello").fg(Color.red).bold().toString()
check(styled != plain, "styled differs from plain")
check(styled.contains("Hello"), "styled keeps the payload")
check(styled.contains("31m"), "red foreground emits SGR code 31")
check(styled.length() > plain.length(), "styling adds escape bytes")

// Each named color renders distinctly (Color namespace, lines 158-171).
let red: string = Content.text("X").fg(Color.red).toString()
let green: string = Content.text("X").fg(Color.green).toString()
let blue: string = Content.text("X").fg(Color.blue).toString()
check(red != green, "red distinct from green")
check(green != blue, "green distinct from blue")

// RGB + all decoration methods chain (lines 170, 186-196).
let rgb: string = Content.text("rgb").bg(Color.rgb(40, 0, 0)).toString()
check(rgb.contains("rgb"), "rgb bg keeps payload")
let deco: string = Content.text("d").italic().underline().dim().toString()
check(deco.contains("d"), "decoration chain keeps payload")

// --- Tables ----------------------------------------------------------------
// Book lines 198-244: Content.table(headers, rows); default border rounded (╭).
let headers = ["name", "value"]
let rows = [["test", "142.5"], ["prod", "378.2"]]
let rounded: string = Content.table(headers, rows).toString()
check(rounded.contains("name"), "table header name")
check(rounded.contains("378.2"), "table data cell")
check(rounded.contains("╭"), "default border rounded top-left expected=╭")

// Border styles (lines 224-288): sharp ┌, heavy ┏, double ╔.
let sharp: string = Content.table(headers, rows).border(Border.sharp).toString()
check(sharp.contains("┌"), "sharp top-left expected=┌")
check(!sharp.contains("╭"), "sharp has no rounded corner")
let heavy: string = Content.table(headers, rows).border(Border.heavy).toString()
check(heavy.contains("┏"), "heavy top-left expected=┏")
let dbl: string = Content.table(headers, rows).border(Border.double).toString()
check(dbl.contains("╔"), "double top-left expected=╔")

// max_rows truncates display (line 294).
let capped: string = Content.table(["n"], [["1"], ["2"], ["3"], ["4"]])
    .max_rows(2)
    .toString()
check(capped.contains("more rows"), "max_rows truncation notice shown")

// --- Charts ----------------------------------------------------------------
// Book lines 301-322: Content.chart("line").add(label,[[x,y],...]).title(...);
// the title appears in the terminal rendering.
let chart: string = Content.chart("line")
    .add("Revenue", [[1, 100], [2, 200], [3, 350]])
    .title("Quarterly Revenue")
    .x_label("Quarter")
    .y_label("USD")
    .toString()
check(chart.contains("Quarterly Revenue"), "chart title appears in rendering")
check(chart.length() > 0, "chart renders non-empty")

if failures == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"FAILURES: {failures}")
}
