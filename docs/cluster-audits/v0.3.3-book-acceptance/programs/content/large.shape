failures = failures + expect_bool("dash_table_header", dash_table.contains("name"))
failures = failures + expect_bool("dash_chart_nonempty", longer_than(dash_chart, 0))

// The three nodes are independent renderings (the v0.3.3 sequential pattern);
// none of them is empty and each carries its own distinct payload.
failures = failures + expect_bool("dash_parts_distinct_1", dash_summary != dash_table)
failures = failures + expect_bool("dash_parts_distinct_2", dash_table != dash_chart)

// ===========================================================================
// 21. Empty / single-cell table edge cases (§Tables)
//     A one-column, one-row table still draws a full bordered box, and the
