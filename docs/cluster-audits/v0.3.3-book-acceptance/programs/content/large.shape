// ---------------------------------------------------------------------------

checkEq(Content.text("p").bold().italic().toString(), ansi("1;3", "p"), "bold+italic")
checkEq(Content.text("p").bold().underline().toString(), ansi("1;4", "p"), "bold+underline")
