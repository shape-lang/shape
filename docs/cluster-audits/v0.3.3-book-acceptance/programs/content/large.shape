failures = failures + expect_str("ct_line", f"{ChartType.line}", "line")
failures = failures + expect_str("ct_bar", f"{ChartType.bar}", "bar")
failures = failures + expect_str("ct_scatter", f"{ChartType.scatter}", "scatter")
failures = failures + expect_str("ct_area", f"{ChartType.area}", "area")
failures = failures + expect_str("ct_histogram", f"{ChartType.histogram}", "histogram")
failures = failures + expect_str("ct_candlestick", f"{ChartType.candlestick}", "candlestick")
failures = failures + expect_str("ct_boxplot", f"{ChartType.boxplot}", "boxplot")
failures = failures + expect_str("ct_heatmap", f"{ChartType.heatmap}", "heatmap")
failures = failures + expect_str("ct_bubble", f"{ChartType.bubble}", "bubble")

// ===========================================================================
// 12. All six border styles render the per-suite duration table
//     Book §Border Styles: each style has a documented distinguishing glyph.
//     We assert the distinguishing corner/line glyph appears (or, for the
//     border-less styles, that the border glyphs are ABSENT) and that the data
//     survives in every rendering.
// ===========================================================================

let dur_headers: Array<string> = ["suite", "ms"]
let du0: Array<string> = [auth.suite, f"{auth.total_ms}"]
let du1: Array<string> = [db.suite, f"{db.total_ms}"]
let du2: Array<string> = [api.suite, f"{api.total_ms}"]
let dur_rows: Array<Array<string>> = [du0, du1, du2]

let b_rounded = Content.table(dur_headers, dur_rows).border(Border.rounded).to_string()
let b_sharp = Content.table(dur_headers, dur_rows).border(Border.sharp).to_string()
let b_heavy = Content.table(dur_headers, dur_rows).border(Border.heavy).to_string()
let b_double = Content.table(dur_headers, dur_rows).border(Border.double).to_string()
let b_minimal = Content.table(dur_headers, dur_rows).border(Border.minimal).to_string()
let b_none = Content.table(dur_headers, dur_rows).border(Border.none).to_string()

// Distinguishing glyphs (book §Border Styles examples).
failures = failures + expect_bool("b_rounded_glyph", b_rounded.contains("╭"))
failures = failures + expect_bool("b_sharp_glyph", b_sharp.contains("┌"))
failures = failures + expect_bool("b_heavy_glyph", b_heavy.contains("┏"))
failures = failures + expect_bool("b_double_glyph", b_double.contains("╔"))
// minimal: "No outer border, ─ row separators only" -> has ─ but no ╭/┌/┏/╔.
failures = failures + expect_bool("b_minimal_has_sep", b_minimal.contains("-"))
failures = failures + expect_bool("b_minimal_no_round", !b_minimal.contains("╭"))
// none: "No borders at all".
failures = failures + expect_bool("b_none_no_round", !b_none.contains("╭"))
failures = failures + expect_bool("b_none_no_sharp", !b_none.contains("┌"))

// Data survives every border style.
failures = failures + expect_bool("b_rounded_data", b_rounded.contains("auth"))
failures = failures + expect_bool("b_sharp_data", b_sharp.contains("52"))
failures = failures + expect_bool("b_heavy_data", b_heavy.contains("db"))
failures = failures + expect_bool("b_double_data", b_double.contains("71"))
failures = failures + expect_bool("b_minimal_data", b_minimal.contains("api"))
failures = failures + expect_bool("b_none_data", b_none.contains("91"))

// ===========================================================================
// 13. Style-method matrix (§Style Methods)
//     Every documented decoration method chains on a ContentNode, preserves
//     its payload, and (for the visible-effect methods) grows the string.
// ===========================================================================

let sm_fg = Content.text("m").fg(Color.cyan).to_string()
let sm_bg = Content.text("m").bg(Color.magenta).to_string()
let sm_bold = Content.text("m").bold().to_string()
let sm_italic = Content.text("m").italic().to_string()
let sm_under = Content.text("m").underline().to_string()
let sm_dim = Content.text("m").dim().to_string()

failures = failures + expect_bool("sm_fg_payload", sm_fg.contains("m"))
failures = failures + expect_bool("sm_bg_payload", sm_bg.contains("m"))
failures = failures + expect_bool("sm_bold_payload", sm_bold.contains("m"))
failures = failures + expect_bool("sm_italic_payload", sm_italic.contains("m"))
failures = failures + expect_bool("sm_under_payload", sm_under.contains("m"))
failures = failures + expect_bool("sm_dim_payload", sm_dim.contains("m"))

// Each decoration wraps the 1-char payload in escape codes -> length > 1.
failures = failures + expect_bool("sm_fg_grows", longer_than(sm_fg, 1))
failures = failures + expect_bool("sm_bold_grows", longer_than(sm_bold, 1))
failures = failures + expect_bool("sm_italic_grows", longer_than(sm_italic, 1))
failures = failures + expect_bool("sm_under_grows", longer_than(sm_under, 1))

// A full chain applies all decorations at once (book §Style Methods example).
let sm_all = Content.text("X")
    .fg(Color.red)
    .bg(Color.rgb(40, 0, 0))
    .bold()
    .underline()
    .to_string()
failures = failures + expect_bool("sm_all_payload", sm_all.contains("X"))
failures = failures + expect_bool("sm_all_longest", longer_than(sm_all, sm_fg.len()))

// ===========================================================================
// 14. RGB color channel coverage (§Colors: Color.rgb(r,g,b), 0-255)
//     Distinct channel values produce distinct rgb(...) names.
// ===========================================================================

failures = failures + expect_str("rgb_black", f"{Color.rgb(0, 0, 0)}", "rgb(0,0,0)")
failures = failures + expect_str("rgb_white", f"{Color.rgb(255, 255, 255)}", "rgb(255,255,255)")
failures = failures + expect_str("rgb_red", f"{Color.rgb(255, 0, 0)}", "rgb(255,0,0)")
failures = failures + expect_str("rgb_green", f"{Color.rgb(0, 255, 0)}", "rgb(0,255,0)")
failures = failures + expect_str("rgb_blue", f"{Color.rgb(0, 0, 255)}", "rgb(0,0,255)")
failures = failures + expect_str("rgb_mid", f"{Color.rgb(128, 64, 32)}", "rgb(128,64,32)")

// ===========================================================================
// 15. Multi-series chart (§Charts: multiple .add channels)
//     A line chart with two series renders both labels in its legend/body.
// ===========================================================================

let dual = Content.chart("line")
    .add("passed", [[1, 2], [2, 2], [3, 2]])
    .add("failed", [[1, 1], [2, 0], [3, 1]])
    .title("Pass/Fail by suite")
    .x_label("suite")
    .y_label("count")
    .width(60)
    .height(12)
    .to_string()
failures = failures + expect_bool("dual_nonempty", longer_than(dual, 0))
failures = failures + expect_bool("dual_title", dual.contains("Pass/Fail by suite"))

// Bar chart of total durations (book §Channel-Based Data Model: bar needs y).
let bar = Content.chart(ChartType.bar)
    .add("ms", [[1, 52], [2, 71], [3, 91]])
    .title("Durations")
    .to_string()
failures = failures + expect_bool("bar_nonempty", longer_than(bar, 0))
failures = failures + expect_bool("bar_title", bar.contains("Durations"))

// ===========================================================================
// 16. Per-case verdict labels via the Content trait (§Content Trait)
//     Render a styled status badge for each case, asserting payload + styling.
// ===========================================================================

type CaseBadge {
    name: string,
    status: string,
}

impl Content for CaseBadge {
    method render() {
        let body = f"{self.name} [{self.status}]"
        if self.status == "PASS" {
            Content.text(body).fg(Color.green)
        } else if self.status == "FAIL" {
            Content.text(body).fg(Color.red).bold()
        } else {
            Content.text(body).fg(Color.yellow).dim()
        }
    }
}

fn badge_for(c: TestCase) -> string {
    let nm: string = c.name
    let st: string = outcome_label(c.outcome)
    let b = CaseBadge { name: nm, status: st }
    let rendered: string = b.render().to_string()
    return rendered
}

let badge0: string = badge_for(cases[0])  // login_ok PASS
let badge2: string = badge_for(cases[2])  // token_expiry FAIL
let badge4: string = badge_for(cases[4])  // migration_v3 SKIP

failures = failures + expect_bool("badge0_payload", badge0.contains("login_ok [PASS]"))
failures = failures + expect_bool("badge2_payload", badge2.contains("token_expiry [FAIL]"))
failures = failures + expect_bool("badge4_payload", badge4.contains("migration_v3 [SKIP]"))
// FAIL badge is bold+red, so longer than the bare "token_expiry [FAIL]" (19).
failures = failures + expect_bool("badge2_styled", longer_than(badge2, 19))

// ===========================================================================
// 17. Final tally
// ===========================================================================

if failures == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"CHECK_FAILURES: {failures}")
}
