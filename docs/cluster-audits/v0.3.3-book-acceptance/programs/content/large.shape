failures = failures + expect_bool("tc_bar_ok", longer_than(tc_bar, 0))
failures = failures + expect_bool("tc_bar_title", tc_bar.contains("M_bar"))
failures = failures + expect_bool("tc_scatter_ok", longer_than(tc_scatter, 0))
failures = failures + expect_bool("tc_scatter_title", tc_scatter.contains("M_scatter"))
failures = failures + expect_bool("tc_area_ok", longer_than(tc_area, 0))
failures = failures + expect_bool("tc_area_title", tc_area.contains("M_area"))
failures = failures + expect_bool("tc_hist_ok", longer_than(tc_hist, 0))
failures = failures + expect_bool("tc_hist_title", tc_hist.contains("M_hist"))
failures = failures + expect_bool("tc_candle_ok", longer_than(tc_candle, 0))
failures = failures + expect_bool("tc_candle_title", tc_candle.contains("M_candle"))
failures = failures + expect_bool("tc_box_ok", longer_than(tc_box, 0))
failures = failures + expect_bool("tc_box_title", tc_box.contains("M_box"))
failures = failures + expect_bool("tc_heat_ok", longer_than(tc_heat, 0))
failures = failures + expect_bool("tc_heat_title", tc_heat.contains("M_heat"))
failures = failures + expect_bool("tc_bubble_ok", longer_than(tc_bubble, 0))
failures = failures + expect_bool("tc_bubble_title", tc_bubble.contains("M_bubble"))

// ===========================================================================
// 26. Color namespace completeness (§Colors — all 8 named colors + default)
//     The book lists red/green/blue/yellow/magenta/cyan/white/default. Each
//     resolves to its lowercase name via interpolation, and each (except
//     default) produces a distinct foreground rendering for the same text.
