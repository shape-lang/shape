// ---------------------------------------------------------------------------
// SECTION 22 — Combined pass/fail badge column rendered OUTSIDE the table.
// (Tables take plain strings; styled badges are printed alongside.) We build a
// parallel list of badge strings and assert each.
// ---------------------------------------------------------------------------

fn badgeFor(i: int) -> string {
    statusBadge(suiteStatus(i))
}

checkEq(badgeFor(0), expectBadge("PASS"), "badgeFor auth PASS")
checkEq(badgeFor(1), expectBadge("FAIL"), "badgeFor db FAIL")
checkEq(badgeFor(2), expectBadge("PASS"), "badgeFor api PASS")
checkEq(badgeFor(3), expectBadge("FAIL"), "badgeFor ui FAIL")
checkEq(badgeFor(4), expectBadge("PASS"), "badgeFor core PASS")

// Concatenate all badges into one status line and assert the exact string.
fn statusLine() -> string {
    let mut out = ""
    let mut i = 0
    while i < suiteNames.length() {
        if i > 0 {
            out = out + " "
        }
        out = out + badgeFor(i)
        i = i + 1
    }
    out
}
let expStatusLine =
    expectBadge("PASS") + " " +
    expectBadge("FAIL") + " " +
    expectBadge("PASS") + " " +
    expectBadge("FAIL") + " " +
    expectBadge("PASS")
checkEq(statusLine(), expStatusLine, "concatenated status line")

// ---------------------------------------------------------------------------
// SECTION 23 — Coverage-grade legend: map each coverage to a colored grade and
// assert the exact ANSI. Grade A (>=90) green, B (>=70) yellow, F (<70) red.
// ---------------------------------------------------------------------------

fn grade(p: int) -> string {
    if p >= 90 {
        "A"
    } else {
        if p >= 70 {
            "B"
        } else {
            "F"
        }
    }
}

fn gradeBadge(p: int) -> string {
    let g = grade(p)
    if p >= 90 {
        Content.text(g).fg(Color.green).bold().toString()
    } else {
        if p >= 70 {
            Content.text(g).fg(Color.yellow).bold().toString()
        } else {
            Content.text(g).fg(Color.red).bold().toString()
        }
    }
}

checkEq(grade(95), "A", "grade 95 A")
checkEq(grade(70), "B", "grade 70 B")
checkEq(grade(40), "F", "grade 40 F")
checkEq(gradeBadge(95), ansi("1;32", "A"), "gradeBadge 95 green A")
checkEq(gradeBadge(88), ansi("1;33", "B"), "gradeBadge 88 yellow B")
checkEq(gradeBadge(40), ansi("1;31", "F"), "gradeBadge 40 red F")

// Map fixture coverage to grades and assert the joined grade string.
fn gradeLine() -> string {
    let mut out = ""
    for p in covLines {
        out = out + grade(p)
    }
    out
}
checkEq(gradeLine(), "ABBFA", "grade line ABBFA")

