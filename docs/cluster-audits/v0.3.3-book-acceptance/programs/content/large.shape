failures = failures + expect_bool("fg_green_payload", fg_green.contains("c"))
failures = failures + expect_bool("fg_blue_payload", fg_blue.contains("c"))
failures = failures + expect_bool("fg_yellow_payload", fg_yellow.contains("c"))
failures = failures + expect_bool("fg_magenta_payload", fg_magenta.contains("c"))
failures = failures + expect_bool("fg_cyan_payload", fg_cyan.contains("c"))
failures = failures + expect_bool("fg_white_payload", fg_white.contains("c"))

// Distinct named colors yield distinct renderings for identical text.
failures = failures + expect_bool("fg_red_ne_green", fg_red != fg_green)
failures = failures + expect_bool("fg_green_ne_blue", fg_green != fg_blue)
failures = failures + expect_bool("fg_blue_ne_yellow", fg_blue != fg_yellow)
failures = failures + expect_bool("fg_yellow_ne_magenta", fg_yellow != fg_magenta)
failures = failures + expect_bool("fg_magenta_ne_cyan", fg_magenta != fg_cyan)
failures = failures + expect_bool("fg_cyan_ne_white", fg_cyan != fg_white)

// ===========================================================================
// 27. Final tally
// ===========================================================================

if failures == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"CHECK_FAILURES: {failures}")
}
