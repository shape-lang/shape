failures = failures + expect_bool("labelled_title", labelled.contains("Labelled"))
// NOTE: the book documents .x_label/.y_label as "Label the x/y-axis" but does
// NOT promise the label TEXT appears in the .toString() terminal rendering (its
// sample terminal output, lines 396-404, shows only the title + axis ticks, no
// axis-label text). Probing confirms the label text is absent from the
// rendering, so we assert only that the methods are ACCEPTED and chain (which is
// what the book guarantees): the chart still builds non-empty with its title
// intact after x_label/y_label/width/height. Asserting label-text presence would
// assert a behavior the book never claims.
failures = failures + expect_bool("labelled_chains_ok", longer_than(labelled, 10))

// ===========================================================================
// 20. Dashboard sequence (§Composition with Fragment, v0.3.3 form)
//     The book's v0.3.3 guidance (lines 437-449): since Content.fragment is a
//     v0.4 feature, "achieve the same result by printing each node in turn".
//     We build the three nodes the book's runnable example builds (summary
//     text, a table, a chart) and render each to a string, asserting each
//     part's payload survives. This is the documented v0.3.3 substitute for
//     fragments.
// ===========================================================================

let dash_summary: string = Content.text("Report").bold().to_string()
let dash_table: string = Content.table(["name", "value"], [["test", "142.5"]]).to_string()
