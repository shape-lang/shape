let tc_scatter = typed_chart(ChartType.scatter, "M_scatter")
let tc_area = typed_chart(ChartType.area, "M_area")
let tc_hist = typed_chart(ChartType.histogram, "M_hist")
let tc_candle = typed_chart(ChartType.candlestick, "M_candle")
let tc_box = typed_chart(ChartType.boxplot, "M_box")
let tc_heat = typed_chart(ChartType.heatmap, "M_heat")
let tc_bubble = typed_chart(ChartType.bubble, "M_bubble")

failures = failures + expect_bool("tc_line_ok", longer_than(tc_line, 0))
