failures = failures + expect_bool("ch_line_title", ch_line.contains("T_line"))
failures = failures + expect_bool("ch_bar_nonempty", longer_than(ch_bar, 0))
failures = failures + expect_bool("ch_bar_title", ch_bar.contains("T_bar"))
failures = failures + expect_bool("ch_scatter_nonempty", longer_than(ch_scatter, 0))
failures = failures + expect_bool("ch_scatter_title", ch_scatter.contains("T_scatter"))
failures = failures + expect_bool("ch_area_nonempty", longer_than(ch_area, 0))
failures = failures + expect_bool("ch_area_title", ch_area.contains("T_area"))

// Construct each remaining type via the ChartType namespace; assert the type
// name resolves and a titled chart builds non-empty. (Histogram/candlestick/
