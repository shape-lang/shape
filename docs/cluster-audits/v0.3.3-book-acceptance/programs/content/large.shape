failures = failures + expect_str("ct_line", f"{ChartType.line}", "line")
failures = failures + expect_str("ct_bar", f"{ChartType.bar}", "bar")
failures = failures + expect_str("ct_scatter", f"{ChartType.scatter}", "scatter")
failures = failures + expect_str("ct_area", f"{ChartType.area}", "area")
failures = failures + expect_str("ct_histogram", f"{ChartType.histogram}", "histogram")
failures = failures + expect_str("ct_candlestick", f"{ChartType.candlestick}", "candlestick")
failures = failures + expect_str("ct_boxplot", f"{ChartType.boxplot}", "boxplot")
failures = failures + expect_str("ct_heatmap", f"{ChartType.heatmap}", "heatmap")
failures = failures + expect_str("ct_bubble", f"{ChartType.bubble}", "bubble")

// ===========================================================================
// 12. All six border styles render the per-suite duration table
//     Book §Border Styles: each style has a documented distinguishing glyph.
//     We assert the distinguishing corner/line glyph appears (or, for the
//     border-less styles, that the border glyphs are ABSENT) and that the data
//     survives in every rendering.
// ===========================================================================

let dur_headers: Array<string> = ["suite", "ms"]
let du0: Array<string> = [auth.suite, f"{auth.total_ms}"]
let du1: Array<string> = [db.suite, f"{db.total_ms}"]
let du2: Array<string> = [api.suite, f"{api.total_ms}"]
let dur_rows: Array<Array<string>> = [du0, du1, du2]

let b_rounded = Content.table(dur_headers, dur_rows).border(Border.rounded).to_string()
let b_sharp = Content.table(dur_headers, dur_rows).border(Border.sharp).to_string()
let b_heavy = Content.table(dur_headers, dur_rows).border(Border.heavy).to_string()
let b_double = Content.table(dur_headers, dur_rows).border(Border.double).to_string()
let b_minimal = Content.table(dur_headers, dur_rows).border(Border.minimal).to_string()
let b_none = Content.table(dur_headers, dur_rows).border(Border.none).to_string()

// Distinguishing glyphs (book §Border Styles examples).
failures = failures + expect_bool("b_rounded_glyph", b_rounded.contains("╭"))
failures = failures + expect_bool("b_sharp_glyph", b_sharp.contains("┌"))
failures = failures + expect_bool("b_heavy_glyph", b_heavy.contains("┏"))
failures = failures + expect_bool("b_double_glyph", b_double.contains("╔"))
// minimal: "No outer border, ─ row separators only" -> has ─ but no ╭/┌/┏/╔.
failures = failures + expect_bool("b_minimal_has_sep", b_minimal.contains("-"))
failures = failures + expect_bool("b_minimal_no_round", !b_minimal.contains("╭"))
// none: "No borders at all".
failures = failures + expect_bool("b_none_no_round", !b_none.contains("╭"))
failures = failures + expect_bool("b_none_no_sharp", !b_none.contains("┌"))

// Data survives every border style.
failures = failures + expect_bool("b_rounded_data", b_rounded.contains("auth"))
failures = failures + expect_bool("b_sharp_data", b_sharp.contains("52"))
failures = failures + expect_bool("b_heavy_data", b_heavy.contains("db"))
failures = failures + expect_bool("b_double_data", b_double.contains("71"))
failures = failures + expect_bool("b_minimal_data", b_minimal.contains("api"))
