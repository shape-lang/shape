failures = failures + expect_str("named_white", f"{Color.white}", "white")
failures = failures + expect_str("named_default", f"{Color.default}", "default")

let fg_red = Content.text("c").fg(Color.red).to_string()
let fg_green = Content.text("c").fg(Color.green).to_string()
let fg_blue = Content.text("c").fg(Color.blue).to_string()
let fg_yellow = Content.text("c").fg(Color.yellow).to_string()
let fg_magenta = Content.text("c").fg(Color.magenta).to_string()
let fg_cyan = Content.text("c").fg(Color.cyan).to_string()
let fg_white = Content.text("c").fg(Color.white).to_string()

// All eight keep the payload.
