// title + that adding a second series keeps it deterministic and titled.
// ---------------------------------------------------------------------------

let dashChart = Content.chart("line")
    .add("Revenue", revenue)
    .add("Costs", costs)
    .title("Q1-Q4 Revenue vs Costs")
    .x_label("Quarter")
    .y_label("USD")
    .toString()
check(dashChart.contains("Q1-Q4 Revenue vs Costs"), "dash chart title")
check(dashChart.length() > 0, "dash chart non-empty")

// area chart over cumulative revenue.
// Build cumulative pairs without an empty-array literal (Shape v0.3.3 cannot
// construct `[]` — op_new_array(0) SURFACE; recorded as a BOOK-GAP/defect).
// Seed with the first cumulative point, then append the rest.
fn cumulative(series: Array<Array<int>>) -> Array<Array<int>> {
    let first = series[0]
    let mut acc = first[1]
    let mut out = [[first[0], acc]]
    let mut i = 1
    while i < series.length() {
        acc = acc + series[i][1]
        out.push([series[i][0], acc])
        i = i + 1
    }
    out
}

let cumRev = cumulative(revenue)
check(cumRev.length() == 4, "cumulative length 4")
check(cumRev[3][1] == 1150, "cumulative total 1150")

let areaChart = Content.chart("area")
    .add("Cumulative", cumRev)
    .title("Cumulative Revenue")
    .toString()
check(areaChart.contains("Cumulative Revenue"), "area chart title")

