// ===========================================================================
// 16. Per-case verdict labels via the Content trait (§Content Trait)
//     Render a styled status badge for each case, asserting payload + styling.
// ===========================================================================

type CaseBadge {
    name: string,
    status: string,
}

impl Content for CaseBadge {
    method render() {
        let body = f"{self.name} [{self.status}]"
        if self.status == "PASS" {
            Content.text(body).fg(Color.green)
        } else if self.status == "FAIL" {
            Content.text(body).fg(Color.red).bold()
        } else {
            Content.text(body).fg(Color.yellow).dim()
        }
    }
}

fn badge_for(c: TestCase) -> string {
    let nm: string = c.name
    let st: string = outcome_label(c.outcome)
    let b = CaseBadge { name: nm, status: st }
    let rendered: string = b.render().to_string()
    return rendered
}

let badge0: string = badge_for(cases[0])  // login_ok PASS
let badge2: string = badge_for(cases[2])  // token_expiry FAIL
let badge4: string = badge_for(cases[4])  // migration_v3 SKIP

failures = failures + expect_bool("badge0_payload", badge0.contains("login_ok [PASS]"))
failures = failures + expect_bool("badge2_payload", badge2.contains("token_expiry [FAIL]"))
failures = failures + expect_bool("badge4_payload", badge4.contains("migration_v3 [SKIP]"))
// FAIL badge is bold+red, so longer than the bare "token_expiry [FAIL]" (19).
failures = failures + expect_bool("badge2_styled", longer_than(badge2, 19))

// ===========================================================================
// 17. Book-pinned minimal + none border fixtures (§Border Styles)
//     The book prints a verbatim visual-reference block for Border.minimal
//     ("No outer border, ASCII `-` row separators only") and describes
//     Border.none ("No borders at all"). We pin the full minimal rendering to
//     the book's block, and assert none drops all box-drawing glyphs.
//     Data: name/value, test/prod (same fixture the book uses).
// ===========================================================================

// Book §Border Styles, Border.minimal block (lines 281-288): a leading-space
// separator row of " ------ ------- ", then 2-space-indented content rows, with
// separators above and below the header and after the last data row.
let minimal = Content.table(bp_headers, bp_rows).border(Border.minimal).to_string()
let minimal_book = " ------ ------- \n  name   value  \n ------ ------- \n  test   142.5  \n  prod   378.2  \n ------ ------- \n"
failures = failures + expect_str("book_border_minimal", minimal, minimal_book)

// Border.none: "No borders at all" (book line 233). Cells separated by spaces,
// no box-drawing characters, no ASCII separator rows.
let bnone = Content.table(bp_headers, bp_rows).border(Border.none).to_string()
let bnone_book = "name  value\ntest  142.5\nprod  378.2\n"
failures = failures + expect_str("book_border_none", bnone, bnone_book)
// none has none of the box-drawing corner glyphs.
failures = failures + expect_bool("none_no_rounded", !bnone.contains("╭"))
failures = failures + expect_bool("none_no_sharp", !bnone.contains("┌"))
failures = failures + expect_bool("none_no_heavy", !bnone.contains("┏"))
failures = failures + expect_bool("none_no_double", !bnone.contains("╔"))
failures = failures + expect_bool("none_no_vrule", !bnone.contains("│"))

// ===========================================================================
// 18. Every documented chart type constructs and renders (§Chart Types table)
//     The book lists 9 chart types (line/bar/scatter/area/histogram/
//     candlestick/boxplot/heatmap/bubble). Each must construct via the
//     namespace form, accept a title, and render to a non-empty block whose
//     title round-trips. We use x/y pair data, valid for the line family;
//     other types may render differently but must still produce output and
//     echo the title (book §Charts: "title(text) Set chart title").
// ===========================================================================

fn chart_with_title(ct: string, t: string) -> string {
    let c = Content.chart(ct)
        .add("s", [[1, 10], [2, 20], [3, 15]])
        .title(t)
        .to_string()
    return c
}

let ch_line = chart_with_title("line", "T_line")
let ch_bar = chart_with_title("bar", "T_bar")
let ch_scatter = chart_with_title("scatter", "T_scatter")
let ch_area = chart_with_title("area", "T_area")

