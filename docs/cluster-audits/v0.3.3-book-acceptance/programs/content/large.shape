// ===========================================================================
// 24. Failing-cases-only table (computed projection over the fixture)
//     Build a table containing only the FAIL cases. From the fixture there are
//     exactly two: auth/token_expiry (31ms) and api/post_order (52ms). The
//     table must contain both and NOT contain a passing case (e.g. login_ok).
//     Row count is derived by hand from the fixture, not observed.
// ===========================================================================

fn is_fail(c: TestCase) -> bool {
    return match c.outcome {
        Outcome::Fail => true,
        Outcome::Pass => false,
        Outcome::Skip => false,
    }
}

// Hand-enumerated fail rows (the two FAIL cases above).
let fr0: Array<string> = case_row(cases[2])  // token_expiry FAIL 31
let fr1: Array<string> = case_row(cases[7])  // post_order   FAIL 52
let fail_rows: Array<Array<string>> = [fr0, fr1]

// Cross-check the projection against the predicate over the whole fixture.
let mut fail_count = 0
for c in cases {
    if is_fail(c) {
        fail_count = fail_count + 1
    }
}
failures = failures + expect_int("fail_count_matches", fail_count, 2)

let fail_tbl = Content.table(["suite", "name", "status", "ms"], fail_rows)
    .border(Border.heavy)
    .to_string()
failures = failures + expect_bool("fail_tbl_token", fail_tbl.contains("token_expiry"))
failures = failures + expect_bool("fail_tbl_post", fail_tbl.contains("post_order"))
failures = failures + expect_bool("fail_tbl_no_pass", !fail_tbl.contains("login_ok"))
failures = failures + expect_bool("fail_tbl_all_FAIL", fail_tbl.contains("FAIL"))
failures = failures + expect_bool("fail_tbl_no_PASS", !fail_tbl.contains("PASS"))
failures = failures + expect_bool("fail_tbl_heavy", fail_tbl.contains("┏"))
// 3 borders + 1 header + 2 body + trailing newline -> 7.
let fail_lc: int = line_count(fail_tbl)
failures = failures + expect_int("fail_tbl_lines", fail_lc, 7)

// ===========================================================================
// 25. Chart-type construction matrix (§Chart Types — all 9 documented types)
//     Each documented ChartType namespace member constructs a titled chart that
//     renders non-empty and echoes its title. We feed each the channel shape it
//     can accept from [x,y] pairs (the .add helper builds x/y channels per
//     §Channel-Based Data Model); types needing extra channels still construct.
// ===========================================================================

fn typed_chart(ct: string, title: string) -> string {
    let c = Content.chart(ct)
        .add("d", [[1, 30], [2, 45], [3, 28], [4, 60]])
        .title(title)
        .to_string()
    return c
}

let tc_line = typed_chart(ChartType.line, "M_line")
