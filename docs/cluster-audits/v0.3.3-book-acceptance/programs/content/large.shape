    Content.text("p").bold().italic().underline().toString(),
    ansi("1;3;4", "p"),
    "bold+italic+underline"
)
checkEq(
    Content.text("p").bold().italic().underline().fg(Color.red).bg(Color.blue).toString(),
    ansi("1;3;4;31;44", "p"),
    "all decorations + fg + bg"
)

// ---------------------------------------------------------------------------
// SECTION 28 — Aggregate report computations (book-independent arithmetic over
// the fixtures) feeding a final stats table.
// ---------------------------------------------------------------------------

fn maxArr(a: Array<int>) -> int {
    let mut m = a[0]
    for x in a {
        if x > m {
            m = x
        }
    }
    m
}

fn minArr(a: Array<int>) -> int {
    let mut m = a[0]
    for x in a {
        if x < m {
            m = x
        }
    }
    m
}

check(maxArr(suiteMs) == 450, "max ms == 450")
check(minArr(suiteMs) == 60, "min ms == 60")
check(maxArr(covLines) == 99, "max coverage == 99")
check(minArr(covLines) == 40, "min coverage == 40")

