// ===========================================================================
// 19. Chart axis-label + size-hint coverage (§Chart Methods)
//     .x_label / .y_label / .width / .height all chain and are accepted; the
//     axis labels round-trip into the rendered output.
// ===========================================================================

let labelled = Content.chart("line")
    .add("series", [[1, 100], [2, 140], [3, 90], [4, 160]])
    .title("Labelled")
    .x_label("X_AXIS_LABEL")
    .y_label("Y_AXIS_LABEL")
    .width(72)
    .height(16)
    .to_string()
