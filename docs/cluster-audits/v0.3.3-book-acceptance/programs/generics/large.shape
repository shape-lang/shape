// large.shape — generics slice (book-acceptance, ~1000 LOC)
// Book sources:
//   fundamentals/functions.mdx  — Generics, Trait Bounds, where clauses,
//                                 Default Parameter Values, Named Arguments,
//                                 Higher-Order Functions, Closures and Capture.
//   fundamentals/traits.mdx     — Defining/Implementing a Trait, Trait Bounds,
//                                 Multiple bounds, Supertraits, Extend Blocks,
//                                 Conversion Traits (primitive as/as?).
//
// A NON-INTERACTIVE, deterministic generic catalog/report engine. Every record
// type implements a small set of user traits; generic functions parameterized by
// those bounds (`fn f<T: Bound>(x: T)`) drive all formatting, pricing, and
// summarization. All inputs are fixed literals; every computed result is asserted
// against a value derived from book semantics BEFORE running.
//
// Self-check protocol: each check is a bool-returning helper that prints
// "CHECK_FAILED: <name> expected=<e> got=<g>" on mismatch and returns the bool.
// A running AND of all checks gates the final "ALL_CHECKS_PASSED".
//
// =====================================================================
// SECTION 0 — Check harness
// =====================================================================

fn ck_int(name: string, got: int, want: int) -> bool {
  if got != want { print(f"CHECK_FAILED: {name} expected={want} got={got}") }
  got == want
}

fn ck_str(name: string, got: string, want: string) -> bool {
  if got != want { print(f"CHECK_FAILED: {name} expected={want} got={got}") }
  got == want
}

fn ck_bool(name: string, got: bool, want: bool) -> bool {
  if got != want { print(f"CHECK_FAILED: {name} expected={want} got={got}") }
  got == want
}

fn ck_num(name: string, got: number, want: number) -> bool {
  if got != want { print(f"CHECK_FAILED: {name} expected={want} got={got}") }
  got == want
}

// =====================================================================
// SECTION 1 — Core generic combinators (functions.mdx "Generics")
// Scalar type-param generics: identity, projection, swap, const.
// =====================================================================

fn identity<T>(x: T) -> T { x }

fn const_first<A, B>(a: A, b: B) -> A { a }
fn const_second<A, B>(a: A, b: B) -> B { b }

// A generic that threads its argument through a let-binding then returns it.
fn echo<T>(x: T) -> T {
  let captured = x
  captured
}

// A generic that returns a fixed concrete result regardless of T (uses the
// type param only as an input gate).
fn tag_of<T>(x: T) -> int { 0 }

// =====================================================================
// SECTION 2 — Trait hierarchy (traits.mdx)
// Display: human-readable name.
// Priced:  integer price in cents.
// Stocked: integer on-hand quantity.
// Coded:   a short string code.
// =====================================================================

trait Display { fn display() -> string; }
trait Priced  { fn price() -> int; }
trait Stocked { fn stock() -> int; }
trait Coded   { fn code() -> string; }

// Supertrait (traits.mdx "Supertraits"): a Catalogable item is Display + Priced.
trait Catalogable : Display + Priced {
  fn category() -> string;
}

// =====================================================================
// SECTION 3 — Record types + impls
// =====================================================================

type Book {
  title: string,
  isbn: string,
  cents: int,
  qty: int
}

type Gadget {
  name: string,
  sku: string,
  cents: int,
  qty: int
}

type Subscription {
  plan: string,
  monthly_cents: int,
  seats: int
}

impl Display for Book   { method display() -> string { self.title } }
impl Priced  for Book   { method price() -> int { self.cents } }
impl Stocked for Book   { method stock() -> int { self.qty } }
impl Coded   for Book   { method code() -> string { self.isbn } }

impl Display for Gadget { method display() -> string { self.name } }
impl Priced  for Gadget { method price() -> int { self.cents } }
impl Stocked for Gadget { method stock() -> int { self.qty } }
impl Coded   for Gadget { method code() -> string { self.sku } }

impl Display for Subscription { method display() -> string { self.plan } }
impl Priced  for Subscription { method price() -> int { self.monthly_cents } }
impl Stocked for Subscription { method stock() -> int { self.seats } }

// Catalogable impls (must also satisfy supertraits Display + Priced).
impl Catalogable for Book   { method category() -> string { "media" } }
impl Catalogable for Gadget { method category() -> string { "hardware" } }

// =====================================================================
// SECTION 4 — Generic trait-bound functions (traits.mdx "Trait Bounds",
// functions.mdx "where clauses"). Each is instantiated at several
// concrete types — exercising monomorphization.
// =====================================================================

// Single bound, inline.
fn name_of<T: Display>(x: T) -> string { x.display() }

// where-clause form, equivalent.
fn name_of_w<T>(x: T) -> string where T: Display { x.display() }

// Two bounds: Display + Priced.
fn line_item<T: Display + Priced>(x: T) -> string {
  f"{x.display()} = {x.price()}"
}

// Three bounds: Display + Priced + Stocked.
fn shelf_line<T: Display + Priced + Stocked>(x: T) -> string {
  f"{x.display()} | price {x.price()} | qty {x.stock()}"
}

// where-clause with multiple bounds.
fn coded_label<T>(x: T) -> string where T: Display, T: Coded {
  f"{x.code()}:{x.display()}"
}

// Inventory value = price * stock, for any Priced + Stocked type.
fn inventory_value<T: Priced + Stocked>(x: T) -> int {
  x.price() * x.stock()
}

// Apply a percentage discount (integer cents, truncating division).
fn discounted_price<T: Priced>(x: T, pct: int) -> int {
  let p = x.price()
  p - (p * pct) / 100
}

// Catalogable summary, leans on the supertrait methods + the subtrait method.
fn catalog_entry<T: Catalogable>(x: T) -> string {
  f"[{x.category()}] {x.display()} ({x.price()})"
}

// Generic-calls-generic: build a labelled line from name_of.
fn labelled<T: Display>(prefix: string, x: T) -> string {
  f"{prefix}: {name_of(x)}"
}

// =====================================================================
// SECTION 5 — Default params + named args (functions.mdx)
// =====================================================================

fn money(cents: int, symbol: string = "$") -> string {
  let dollars = cents / 100
  let rem = cents % 100
  if rem < 10 {
    f"{symbol}{dollars}.0{rem}"
  } else {
    f"{symbol}{dollars}.{rem}"
  }
}

fn box_vol(w: int = 1, h: int = 1, d: int = 1) -> int { w * h * d }

// =====================================================================
// SECTION 6 — Concrete-typed array utilities (Vec<int> works at HEAD)
// Used to aggregate over price/stock vectors extracted from records.
// =====================================================================

fn sum_ints(xs: Vec<int>) -> int {
  let mut s = 0
  for x in xs { s = s + x }
  s
}

fn max_int(xs: Vec<int>) -> int {
  let mut m = xs[0]
  for x in xs {
    if x > m { m = x }
  }
  m
}

fn min_int(xs: Vec<int>) -> int {
  let mut m = xs[0]
  for x in xs {
    if x < m { m = x }
  }
  m
}

fn count_above(xs: Vec<int>, threshold: int) -> int {
  let mut c = 0
  for x in xs {
    if x > threshold { c = c + 1 }
  }
  c
}

fn join_ints(xs: Vec<int>, sep: string) -> string {
  let mut acc = ""
  let mut firstFlag = true
  for x in xs {
    if firstFlag {
      acc = f"{x}"
      firstFlag = false
    } else {
      acc = f"{acc}{sep}{x}"
    }
  }
  acc
}

// =====================================================================
// SECTION 7 — Higher-order + closure capture (functions.mdx)
// =====================================================================

fn apply_int(f, x: int) -> int { f(x) }

// Closure capture (read-only) — book "Closures and Capture".
// NOTE: the book demonstrates capture only at MODULE scope; capturing a
// function-LOCAL binding (param/local let) into a closure fails on v0.3.3 with
// `Undefined variable` (book-gap — see REPORT.md). So this section captures a
// module-scope binding, matching the book's runnable example exactly.

// =====================================================================
// SECTION 8 — Primitive conversion traits (traits.mdx "Conversion Traits")
// as / as? on primitives ship in stdlib.
// =====================================================================

fn bool_to_num(b: bool) -> number { b as number }

fn try_parse_int(s: string) -> Result<int, AnyError> {
  let n = (s as int?)?
  Ok(n)
}

// =====================================================================
// SECTION 9 — Fixtures (deterministic literals)
// =====================================================================

let b1 = Book   { title: "Shape Lang",  isbn: "978-1", cents: 4999, qty: 12 }
let b2 = Book   { title: "Type Theory", isbn: "978-2", cents: 8999, qty: 3 }
let g1 = Gadget { name:  "Keyboard",    sku:  "KB-01", cents: 12000, qty: 25 }
let g2 = Gadget { name:  "Mouse",       sku:  "MS-02", cents: 3500,  qty: 40 }
let s1 = Subscription { plan: "Pro", monthly_cents: 1500, seats: 5 }

// =====================================================================
// SECTION 10 — Checks
// Every expected value is computed by hand from the fixtures + book semantics.
// =====================================================================

// --- Section 1: combinators ---
let r001 = ck_int("identity_int",   identity(99), 99)
let r002 = ck_str("identity_str",   identity("abc"), "abc")
let r003 = ck_bool("identity_bool", identity(false), false)
let r004 = ck_num("identity_num",   identity(2.5), 2.5)
let r005 = ck_int("const_first",    const_first(7, "z"), 7)
let r006 = ck_str("const_second",   const_second(7, "z"), "z")
let r007 = ck_int("echo_int",       echo(123), 123)
let r008 = ck_str("echo_str",       echo("hi"), "hi")
let r009 = ck_int("tag_of_book",    tag_of(b1), 0)
let r010 = ck_int("tag_of_int",     tag_of(5), 0)

// --- Section 4: trait-bound generics, monomorphized at Book/Gadget/Subscription ---
let r011 = ck_str("name_book",      name_of(b1), "Shape Lang")
let r012 = ck_str("name_gadget",    name_of(g1), "Keyboard")
let r013 = ck_str("name_sub",       name_of(s1), "Pro")
let r014 = ck_str("name_w_book",    name_of_w(b2), "Type Theory")
let r015 = ck_str("name_w_gadget",  name_of_w(g2), "Mouse")

// line_item: "<name> = <cents>"
let r016 = ck_str("line_book1",     line_item(b1), "Shape Lang = 4999")
let r017 = ck_str("line_gadget1",   line_item(g1), "Keyboard = 12000")
let r018 = ck_str("line_sub",       line_item(s1), "Pro = 1500")

// shelf_line: "<name> | price <p> | qty <q>"
let r019 = ck_str("shelf_book1",    shelf_line(b1), "Shape Lang | price 4999 | qty 12")
let r020 = ck_str("shelf_gadget2",  shelf_line(g2), "Mouse | price 3500 | qty 40")

// coded_label: "<code>:<name>"
let r021 = ck_str("coded_book1",    coded_label(b1), "978-1:Shape Lang")
let r022 = ck_str("coded_gadget1",  coded_label(g1), "KB-01:Keyboard")

// inventory_value = price * stock
let r023 = ck_int("inv_book1",      inventory_value(b1), 4999 * 12)   // 59988
let r024 = ck_int("inv_book2",      inventory_value(b2), 8999 * 3)    // 26997
let r025 = ck_int("inv_gadget1",    inventory_value(g1), 12000 * 25)  // 300000
let r026 = ck_int("inv_gadget2",    inventory_value(g2), 3500 * 40)   // 140000
let r027 = ck_int("inv_sub",        inventory_value(s1), 1500 * 5)    // 7500

// discounted_price: p - (p*pct)/100 (integer truncating)
let r028 = ck_int("disc_book1_10",  discounted_price(b1, 10), 4999 - (4999 * 10) / 100) // 4999-499=4500
let r029 = ck_int("disc_gadget1_25",discounted_price(g1, 25), 12000 - (12000 * 25) / 100) // 12000-3000=9000
let r030 = ck_int("disc_book2_0",   discounted_price(b2, 0), 8999)

// catalog_entry: "[<category>] <name> (<price>)"  — Catalogable supertrait
let r031 = ck_str("cat_book1",      catalog_entry(b1), "[media] Shape Lang (4999)")
let r032 = ck_str("cat_gadget1",    catalog_entry(g1), "[hardware] Keyboard (12000)")

// labelled (generic-calls-generic)
let r033 = ck_str("lab_book2",      labelled("ITEM", b2), "ITEM: Type Theory")
let r034 = ck_str("lab_gadget2",    labelled("ITEM", g2), "ITEM: Mouse")

// --- Section 5: defaults + named args ---
let r035 = ck_str("money_default",  money(4999), "$49.99")
let r036 = ck_str("money_symbol",   money(1500, "€"), "€15.00")
let r037 = ck_str("money_named",    money(cents: 305, symbol: "$"), "$3.05")
let r038 = ck_str("money_pad",      money(4005), "$40.05")
let r039 = ck_int("box_all_default",box_vol(), 1)
let r040 = ck_int("box_one",        box_vol(5), 5)
let r041 = ck_int("box_two",        box_vol(5, 6), 30)
let r042 = ck_int("box_three",      box_vol(2, 3, 4), 24)
let r043 = ck_int("box_named",      box_vol(h: 6), 6)             // w=1,h=6,d=1
let r044 = ck_int("box_named2",     box_vol(w: 2, d: 5), 10)      // w=2,h=1,d=5
let r045 = ck_int("box_ooo",        box_vol(d: 4, w: 2, h: 3), 24)

// --- Section 6: concrete array utilities ---
let prices: Vec<int> = [4999, 8999, 12000, 3500, 1500]
let stocks: Vec<int> = [12, 3, 25, 40, 5]
let r046 = ck_int("sum_prices",     sum_ints(prices), 4999 + 8999 + 12000 + 3500 + 1500) // 30998
let r047 = ck_int("sum_stocks",     sum_ints(stocks), 12 + 3 + 25 + 40 + 5)              // 85
let r048 = ck_int("max_price",      max_int(prices), 12000)
let r049 = ck_int("min_price",      min_int(prices), 1500)
let r050 = ck_int("max_stock",      max_int(stocks), 40)
let r051 = ck_int("min_stock",      min_int(stocks), 3)
let r052 = ck_int("count_above5k",  count_above(prices, 5000), 2)  // 8999, 12000
let r053 = ck_int("count_above10",  count_above(stocks, 10), 3)    // 12, 25, 40
let r054 = ck_str("join_stocks",    join_ints(stocks, "-"), "12-3-25-40-5")
let r055 = ck_str("join_prices",    join_ints(prices, ","), "4999,8999,12000,3500,1500")

// map / filter / reduce on concrete Vec<int>
let halved = prices.map(|p| p / 2)
let r056 = ck_int("map_halved0",    halved[0], 2499)   // 4999/2 truncates
let r057 = ck_int("map_halved2",    halved[2], 6000)
let cheap = prices.filter(|p| p < 5000)
let r058 = ck_int("filter_cheap_len", cheap.len(), 3)  // 4999, 3500, 1500
let r059 = ck_int("filter_cheap0",  cheap[0], 4999)
let reduced = prices.reduce(|acc, p| acc + p, 0)
let r060 = ck_int("reduce_sum",     reduced, 30998)

// --- Section 7: higher-order + capture ---
let dbl = |x| x * 2
let r061 = ck_int("apply_dbl",      apply_int(dbl, 21), 42)
// Module-scope read-only capture, exactly the book's "Closures and Capture" shape.
let store = "WAREHOUSE"
let banner = |n| f"{store} has {n} items"
let r062 = ck_str("report_header",  banner(3), "WAREHOUSE has 3 items")
let bias = 100
let add_bias = |x| x + bias
let r063 = ck_int("capture_bias",   add_bias(5), 105)
let r064 = ck_int("capture_bias2",  add_bias(50), 150)

// --- Section 8: conversion traits (primitive) ---
let r065 = ck_num("bool_true_num",  bool_to_num(true), 1.0)
let r066 = ck_num("bool_false_num", bool_to_num(false), 0.0)
let parsed = try_parse_int("42")
let r067 = ck_int("parse_ok",       match parsed { Ok(v) => v, Err(e) => -1 }, 42)
let parsed2 = try_parse_int("7")
let r068 = ck_int("parse_ok2",      match parsed2 { Ok(v) => v, Err(e) => -1 }, 7)

// =====================================================================
// SECTION 11 — Aggregate report assembled via generics (more checks)
// Build a multi-line report string by calling the generic line builders
// in sequence, asserting each segment.
// =====================================================================

fn full_report_book(x: Book) -> string {
  let l1 = catalog_entry(x)
  let l2 = shelf_line(x)
  let l3 = coded_label(x)
  f"{l1}\n{l2}\n{l3}"
}

let rep_b1 = full_report_book(b1)
let exp_b1 = "[media] Shape Lang (4999)\nShape Lang | price 4999 | qty 12\n978-1:Shape Lang"
let r069 = ck_str("report_b1",      rep_b1, exp_b1)

let rep_b2 = full_report_book(b2)
let exp_b2 = "[media] Type Theory (8999)\nType Theory | price 8999 | qty 3\n978-2:Type Theory"
let r070 = ck_str("report_b2",      rep_b2, exp_b2)

// Total catalog value across all items, summed via inventory_value generic.
let total_value =
  inventory_value(b1) +
  inventory_value(b2) +
  inventory_value(g1) +
  inventory_value(g2) +
  inventory_value(s1)
let exp_total = 59988 + 26997 + 300000 + 140000 + 7500   // 534485
let r071 = ck_int("total_value",    total_value, exp_total)

// Discounted total (each item 10% off), summed.
let disc_total =
  discounted_price(b1, 10) +
  discounted_price(b2, 10) +
  discounted_price(g1, 10) +
  discounted_price(g2, 10) +
  discounted_price(s1, 10)
// b1: 4999-499=4500 ; b2: 8999-899=8100 ; g1:12000-1200=10800 ; g2:3500-350=3150 ; s1:1500-150=1350
let exp_disc = 4500 + 8100 + 10800 + 3150 + 1350   // 27900
let r072 = ck_int("disc_total",     disc_total, exp_disc)

// Money formatting over the total (cents -> $).
let r073 = ck_str("money_total",    money(total_value), "$5344.85")
let r074 = ck_str("money_disc",     money(disc_total), "$279.00")

// =====================================================================
// SECTION 12 — Generic chains across multiple distinct types
// Re-instantiate the same generic at every fixture type to stress
// monomorphization breadth.
// =====================================================================

let names_concat =
  name_of(b1) + "|" +
  name_of(b2) + "|" +
  name_of(g1) + "|" +
  name_of(g2) + "|" +
  name_of(s1)
let r075 = ck_str("names_concat", names_concat, "Shape Lang|Type Theory|Keyboard|Mouse|Pro")

let lines_concat =
  line_item(b1) + " ; " +
  line_item(g2) + " ; " +
  line_item(s1)
let r076 = ck_str("lines_concat", lines_concat,
  "Shape Lang = 4999 ; Mouse = 3500 ; Pro = 1500")

// where-clause variant across types.
let names_w_concat =
  name_of_w(b1) + "/" + name_of_w(g1) + "/" + name_of_w(s1)
let r077 = ck_str("names_w_concat", names_w_concat, "Shape Lang/Keyboard/Pro")

// identity threaded through every fixture's display.
let id_chain =
  identity(name_of(b2)) + ":" + identity(name_of(g2))
let r078 = ck_str("id_chain", id_chain, "Type Theory:Mouse")

// =====================================================================
// SECTION 13 — Numeric generic-free aggregations over derived vectors
// =====================================================================

let inv_values: Vec<int> = [
  inventory_value(b1),
  inventory_value(b2),
  inventory_value(g1),
  inventory_value(g2),
  inventory_value(s1)
]
let r079 = ck_int("inv_sum",       sum_ints(inv_values), exp_total)
let r080 = ck_int("inv_max",       max_int(inv_values), 300000)
let r081 = ck_int("inv_min",       min_int(inv_values), 7500)
let r082 = ck_int("inv_above100k", count_above(inv_values, 100000), 2) // 300000, 140000
let r083 = ck_str("inv_join",      join_ints(inv_values, ","),
  "59988,26997,300000,140000,7500")

// =====================================================================
// SECTION 14 — More generic combinators + bound-dispatch batteries
// Additional generic helpers, each instantiated at several concrete types,
// with fully hand-derived expected values.
// =====================================================================

// Generic "is the same display string" comparison across any Display types.
fn same_name<T: Display, U: Display>(a: T, b: U) -> bool {
  a.display() == b.display()
}

// Generic price comparison: returns the cheaper item's price (Priced bound).
fn cheaper_price<T: Priced, U: Priced>(a: T, b: U) -> int {
  let pa = a.price()
  let pb = b.price()
  if pa < pb { pa } else { pb }
}

// Generic richer-of comparison: returns higher inventory value.
fn richer_value<T: Priced + Stocked, U: Priced + Stocked>(a: T, b: U) -> int {
  let va = a.price() * a.stock()
  let vb = b.price() * b.stock()
  if va > vb { va } else { vb }
}

// Generic that formats a "receipt line": code + name + price, for Display+Priced+Coded.
fn receipt_line<T: Display + Priced + Coded>(x: T) -> string {
  f"{x.code()} {x.display()} ${x.price()}"
}

// Generic count of distinct displays in a fixed pair.
fn distinct_pair<T: Display, U: Display>(a: T, b: U) -> int {
  if a.display() == b.display() { 1 } else { 2 }
}

// Generic tax computation: 8% sales tax, integer truncating, on any Priced.
fn with_tax<T: Priced>(x: T) -> int {
  let p = x.price()
  p + (p * 8) / 100
}

// Generic restock cost: (target - current stock) * price, clamped at 0 deficit.
fn restock_cost<T: Priced + Stocked>(x: T, target: int) -> int {
  let cur = x.stock()
  let deficit = if target > cur { target - cur } else { 0 }
  deficit * x.price()
}

// --- same_name checks ---
let r084 = ck_bool("same_name_diff", same_name(b1, g1), false)  // "Shape Lang" vs "Keyboard"
let r085 = ck_bool("same_name_self", same_name(b1, b1), true)   // identical display
let r086 = ck_bool("same_name_bg",   same_name(g2, s1), false)  // "Mouse" vs "Pro"

// --- cheaper_price checks ---
let r087 = ck_int("cheap_b1_b2",    cheaper_price(b1, b2), 4999)   // 4999 < 8999
let r088 = ck_int("cheap_g1_g2",    cheaper_price(g1, g2), 3500)   // 3500 < 12000
let r089 = ck_int("cheap_b1_s1",    cheaper_price(b1, s1), 1500)   // 1500 < 4999
let r090 = ck_int("cheap_g2_s1",    cheaper_price(g2, s1), 1500)   // 1500 < 3500

// --- richer_value checks (inventory value = price*stock) ---
// b1=59988, b2=26997, g1=300000, g2=140000, s1=7500
let r091 = ck_int("rich_b1_b2",     richer_value(b1, b2), 59988)
let r092 = ck_int("rich_g1_g2",     richer_value(g1, g2), 300000)
let r093 = ck_int("rich_b1_s1",     richer_value(b1, s1), 59988)
let r094 = ck_int("rich_g2_b2",     richer_value(g2, b2), 140000)

// --- receipt_line checks (Subscription has no Coded impl, so only Book/Gadget) ---
let r095 = ck_str("receipt_b1",     receipt_line(b1), "978-1 Shape Lang $4999")
let r096 = ck_str("receipt_g1",     receipt_line(g1), "KB-01 Keyboard $12000")
let r097 = ck_str("receipt_g2",     receipt_line(g2), "MS-02 Mouse $3500")
let r098 = ck_str("receipt_b2",     receipt_line(b2), "978-2 Type Theory $8999")

// --- distinct_pair checks ---
