// =====================================================================
// SECTION 19 — Generic Option-returning selectors + a third record type
// =====================================================================

type Service {
  label: string,
  rate_cents: int,
  units: int
}

impl Display for Service { method display() -> string { self.label } }
impl Priced  for Service { method price() -> int { self.rate_cents } }
impl Stocked for Service { method stock() -> int { self.units } }

// Generic affordability: Some(price) if it fits the budget, else None.
fn affordable<T: Priced>(x: T, budget: int) -> Option<int> {
  let p = x.price()
  if p <= budget { Some(p) } else { None }
}

// Generic: unwrap an affordability check to a sentinel.
fn affordable_or<T: Priced>(x: T, budget: int, sentinel: int) -> int {
  match affordable(x, budget) {
    Some(p) => p,
    None => sentinel
  }
}

