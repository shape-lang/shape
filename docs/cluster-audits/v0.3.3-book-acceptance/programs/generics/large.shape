// Generic predicate: is this item premium (price above threshold)?
fn is_premium<T: Priced>(x: T, threshold: int) -> bool {
  x.price() > threshold
}

// Generic predicate: is this item well-stocked?
fn well_stocked<T: Stocked>(x: T, floor: int) -> bool {
  x.stock() >= floor
}

let r169 = ck_bool("prem_g1",       is_premium(g1, 10000), true)   // 12000 > 10000
