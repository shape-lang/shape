fn full_receipt_book(x: Book) -> string {
  let l1 = receipt_line(x)
  let l2 = f"  tax-incl: {with_tax(x)}"
  let l3 = f"  inv-value: {inventory_value(x)}"
  f"{l1}\n{l2}\n{l3}"
}

