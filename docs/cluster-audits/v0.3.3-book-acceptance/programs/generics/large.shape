let r171 = ck_bool("prem_sv1",      is_premium(sv1, 10000), true)  // 25000 > 10000
let r172 = ck_bool("stock_g2",      well_stocked(g2, 30), true)    // 40 >= 30
let r173 = ck_bool("stock_b2_no",   well_stocked(b2, 30), false)   // 3 < 30
