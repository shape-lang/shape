// =====================================================================
// large.shape -- A recursive-descent arithmetic expression interpreter
// Slice: pattern-matching. Book: fundamentals/pattern-matching.mdx
//
// Everything is driven by `match`:
//   - the parser dispatches on Token variants (enum matching, guards)
//   - the AST evaluator dispatches on Expr variants (enum matching)
//   - error handling is Result<T,E> with Ok/Err constructor patterns + `?`
//   - Option<T> with Some/None for optional lookahead
//   - type/literal/guard/wildcard arms exercised throughout
//
// Non-interactive: token streams are deterministic in-program fixtures.
// Machine-proofable: every expected value below is derived from ordinary
// arithmetic / precedence semantics and written BEFORE the first run.
// =====================================================================

// ---- failure tracking ------------------------------------------------
let mut failures: int = 0
fn check_int(name: string, got: int, expected: int) {
  if got != expected {
    failures = failures + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}
fn check_str(name: string, got: string, expected: string) {
  if got != expected {
    failures = failures + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}
fn check_bool(name: string, got: bool, expected: bool) {
  if got != expected {
    failures = failures + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}

// ---- tokens ----------------------------------------------------------
enum Token {
  Num(int),
  Plus,
  Minus,
  Star,
  Slash,
  LParen,
  RParen,
  End
}

// Pretty name of a token -- pure enum match, exhaustive (no wildcard).
fn token_name(t: Token) -> string {
  match t {
    Token::Num(n) => f"num({n})"
    Token::Plus => "+"
    Token::Minus => "-"
    Token::Star => "*"
    Token::Slash => "/"
    Token::LParen => "("
    Token::RParen => ")"
    Token::End => "$"
  }
}

// Is this token an additive operator? (guard-free literal-style enum match)
fn is_additive(t: Token) -> bool {
  match t {
    Token::Plus => true
    Token::Minus => true
    _ => false
  }
}

fn is_multiplicative(t: Token) -> bool {
  match t {
    Token::Star => true
    Token::Slash => true
    _ => false
  }
}

// ---- AST -------------------------------------------------------------
// Bin carries a string operator discriminator + two sub-exprs.
enum Expr {
  Num(int),
  Neg(Expr),
  Bin(string, Expr, Expr)
}

// ---- evaluator -------------------------------------------------------
// Returns Result<int,string>; division by zero is an Err. `?` propagates.
fn eval(e: Expr) -> Result<int, string> {
  match e {
    Expr::Num(n) => Ok(n)
    Expr::Neg(x) => {
      let v: int = eval(x)?
      Ok(-v)
    }
    Expr::Bin(op, a, b) => {
      let av: int = eval(a)?
      let bv: int = eval(b)?
      match op {
        "+" => Ok(av + bv)
        "-" => Ok(av - bv)
        "*" => Ok(av * bv)
        "/" => match bv {
          0 => Err("division by zero")
          _ => Ok(av / bv)
        }
        _ => Err(f"unknown operator {op}")
      }
    }
  }
}

// Count AST nodes (recursive enum match returning int).
fn node_count(e: Expr) -> int {
  match e {
    Expr::Num(_) => 1
    Expr::Neg(x) => 1 + node_count(x)
    Expr::Bin(_, a, b) => 1 + node_count(a) + node_count(b)
  }
}

// Depth of the AST.
fn depth(e: Expr) -> int {
  match e {
    Expr::Num(_) => 1
    Expr::Neg(x) => 1 + depth(x)
    Expr::Bin(_, a, b) => {
      let da: int = depth(a)
      let db: int = depth(b)
      match da >= db {
        true => 1 + da
        false => 1 + db
      }
    }
  }
}

// Fully-parenthesized pretty printer (recursive enum match -> string).
fn pretty(e: Expr) -> string {
  match e {
    Expr::Num(n) => f"{n}"
    Expr::Neg(x) => f"(- {pretty(x)})"
    Expr::Bin(op, a, b) => f"({op} {pretty(a)} {pretty(b)})"
  }
}

// ---- parser ----------------------------------------------------------
// A successful parse produces a node and the index of the next token.
type ParseOk { node: Expr, next: int }

// peek: Option<Token> -- None past the end. (Option + match)
fn peek(tokens: Array<Token>, pos: int) -> Option<Token> {
  match pos < tokens.len() {
    true => Some(tokens[pos])
    false => None
  }
}

// The grammar (lowest to highest precedence):
//   expr   := term   (('+'|'-') term)*
//   term   := factor (('*'|'/') factor)*
//   factor := '-' factor | primary
//   primary:= NUM | '(' expr ')'

fn parse_primary(tokens: Array<Token>, pos: int) -> Result<ParseOk, string> {
  match peek(tokens, pos) {
    None => Err("unexpected end of input in primary")
    Some(tok) => match tok {
      Token::Num(n) => Ok(ParseOk { node: Expr::Num(n), next: pos + 1 })
      Token::LParen => {
        let inner: ParseOk = parse_expr(tokens, pos + 1)?
        // Unwrap the Option first (single-level), then match the token
        // (single-level) -- nested Some(Token::RParen) patterns are avoided
        // on purpose (see REPORT.md nested-constructor finding).
        match peek(tokens, inner.next) {
          None => Err("expected closing parenthesis")
          Some(closer) => match closer {
            Token::RParen => Ok(ParseOk { node: inner.node, next: inner.next + 1 })
            _ => Err("expected closing parenthesis")
          }
        }
      }
      _ => Err(f"unexpected token {token_name(tok)} in primary")
    }
  }
}

fn parse_factor(tokens: Array<Token>, pos: int) -> Result<ParseOk, string> {
  // Unwrap Option first, then match the token (single-level both).
  match peek(tokens, pos) {
    None => parse_primary(tokens, pos)
    Some(t) => match t {
      Token::Minus => {
        let inner: ParseOk = parse_factor(tokens, pos + 1)?
        Ok(ParseOk { node: Expr::Neg(inner.node), next: inner.next })
      }
      _ => parse_primary(tokens, pos)
    }
  }
}

fn parse_term(tokens: Array<Token>, pos: int) -> Result<ParseOk, string> {
  let mut left: ParseOk = parse_factor(tokens, pos)?
  let mut keep: bool = true
  while keep {
    match peek(tokens, left.next) {
      Some(op_tok) => match is_multiplicative(op_tok) {
        true => {
          let right: ParseOk = parse_factor(tokens, left.next + 1)?
          let opname: string = match op_tok {
            Token::Star => "*"
            _ => "/"
          }
          left = ParseOk { node: Expr::Bin(opname, left.node, right.node), next: right.next }
        }
        false => { keep = false }
      }
      None => { keep = false }
    }
  }
  Ok(left)
}

fn parse_expr(tokens: Array<Token>, pos: int) -> Result<ParseOk, string> {
  let mut left: ParseOk = parse_term(tokens, pos)?
  let mut keep: bool = true
  while keep {
    match peek(tokens, left.next) {
      Some(op_tok) => match is_additive(op_tok) {
        true => {
          let right: ParseOk = parse_term(tokens, left.next + 1)?
          let opname: string = match op_tok {
            Token::Plus => "+"
            _ => "-"
          }
          left = ParseOk { node: Expr::Bin(opname, left.node, right.node), next: right.next }
        }
        false => { keep = false }
      }
      None => { keep = false }
    }
  }
  Ok(left)
}

// Parse a full token stream; require it ends at End.
fn parse(tokens: Array<Token>) -> Result<Expr, string> {
  let po: ParseOk = parse_expr(tokens, 0)?
  // Unwrap Option first, then match the token (single-level both).
  match peek(tokens, po.next) {
    None => Ok(po.node)
    Some(extra) => match extra {
      Token::End => Ok(po.node)
      _ => Err(f"trailing token {token_name(extra)}")
    }
  }
}

// Parse-then-eval, surfacing either stage's error. (match on Result)
fn run(tokens: Array<Token>) -> Result<int, string> {
  match parse(tokens) {
    Err(e) => Err(e)
    Ok(ast) => eval(ast)
  }
}

// Render a Result<int,string> deterministically. (Ok/Err match)
fn show(r: Result<int, string>) -> string {
  match r {
    Ok(v) => f"ok:{v}"
    Err(e) => f"err:{e}"
  }
}

// =====================================================================
// PROOFS
// =====================================================================

// ---- token_name / classifier proofs ---------------------------------
check_str("tn_num", token_name(Token::Num(42)), "num(42)")
check_str("tn_plus", token_name(Token::Plus), "+")
check_str("tn_minus", token_name(Token::Minus), "-")
check_str("tn_star", token_name(Token::Star), "*")
check_str("tn_slash", token_name(Token::Slash), "/")
check_str("tn_lparen", token_name(Token::LParen), "(")
check_str("tn_rparen", token_name(Token::RParen), ")")
check_str("tn_end", token_name(Token::End), "$")

check_bool("add_plus", is_additive(Token::Plus), true)
check_bool("add_minus", is_additive(Token::Minus), true)
check_bool("add_star", is_additive(Token::Star), false)
check_bool("mul_star", is_multiplicative(Token::Star), true)
check_bool("mul_slash", is_multiplicative(Token::Slash), true)
check_bool("mul_plus", is_multiplicative(Token::Plus), false)

// ---- direct AST eval proofs (no parser) ------------------------------
// 3 + 4 = 7
check_str("eval_add", show(eval(Expr::Bin("+", Expr::Num(3), Expr::Num(4)))), "ok:7")
// 10 - 6 = 4
check_str("eval_sub", show(eval(Expr::Bin("-", Expr::Num(10), Expr::Num(6)))), "ok:4")
// 6 * 7 = 42
check_str("eval_mul", show(eval(Expr::Bin("*", Expr::Num(6), Expr::Num(7)))), "ok:42")
// 20 / 4 = 5
check_str("eval_div", show(eval(Expr::Bin("/", Expr::Num(20), Expr::Num(4)))), "ok:5")
// 20 / 0 -> error
check_str("eval_div0", show(eval(Expr::Bin("/", Expr::Num(20), Expr::Num(0)))), "err:division by zero")
// -(5) = -5
check_str("eval_neg", show(eval(Expr::Neg(Expr::Num(5)))), "ok:-5")
// -(2+3) = -5
check_str("eval_neg_sum", show(eval(Expr::Neg(Expr::Bin("+", Expr::Num(2), Expr::Num(3))))), "ok:-5")
// (2 + 3) * 4 = 20  (error propagates through nested ?)
check_str("eval_nested", show(eval(Expr::Bin("*", Expr::Bin("+", Expr::Num(2), Expr::Num(3)), Expr::Num(4)))), "ok:20")
// 8 / (4 - 4) -> div by zero propagates up
check_str("eval_div0_nested", show(eval(Expr::Bin("/", Expr::Num(8), Expr::Bin("-", Expr::Num(4), Expr::Num(4))))), "err:division by zero")
// unknown operator
check_str("eval_badop", show(eval(Expr::Bin("%", Expr::Num(1), Expr::Num(2)))), "err:unknown operator %")

// ---- node_count / depth / pretty proofs ------------------------------
// (2 + 3) * 4 : Bin(*) over Bin(+,2,3) and 4 -> 5 nodes, depth 3
let ast1: Expr = Expr::Bin("*", Expr::Bin("+", Expr::Num(2), Expr::Num(3)), Expr::Num(4))
check_int("nc_ast1", node_count(ast1), 5)
check_int("depth_ast1", depth(ast1), 3)
check_str("pretty_ast1", pretty(ast1), "(* (+ 2 3) 4)")

// -(7) : Neg over Num -> 2 nodes, depth 2
let ast2: Expr = Expr::Neg(Expr::Num(7))
check_int("nc_ast2", node_count(ast2), 2)
check_int("depth_ast2", depth(ast2), 2)
check_str("pretty_ast2", pretty(ast2), "(- 7)")

// single number -> 1 node, depth 1
check_int("nc_num", node_count(Expr::Num(99)), 1)
check_int("depth_num", depth(Expr::Num(99)), 1)
check_str("pretty_num", pretty(Expr::Num(99)), "99")

// ---- peek (Option) proofs --------------------------------------------
let toks_peek: Array<Token> = [Token::Num(1), Token::Plus, Token::End]
let pk0: string = match peek(toks_peek, 0) {
  Some(t) => token_name(t)
  None => "none"
}
check_str("peek0", pk0, "num(1)")
let pk1: string = match peek(toks_peek, 1) {
  Some(t) => token_name(t)
  None => "none"
}
check_str("peek1", pk1, "+")
let pk_oob: string = match peek(toks_peek, 9) {
  Some(t) => token_name(t)
  None => "none"
}
check_str("peek_oob", pk_oob, "none")

// ---- end-to-end parse + eval proofs ----------------------------------
// 1 + 2 * 3 = 7  (precedence: * binds tighter)
let p1: Array<Token> = [Token::Num(1), Token::Plus, Token::Num(2), Token::Star, Token::Num(3), Token::End]
check_str("run_prec", show(run(p1)), "ok:7")

// (1 + 2) * 3 = 9
let p2: Array<Token> = [Token::LParen, Token::Num(1), Token::Plus, Token::Num(2), Token::RParen, Token::Star, Token::Num(3), Token::End]
check_str("run_paren", show(run(p2)), "ok:9")

// 2 * 3 + 4 * 5 = 26
let p3: Array<Token> = [Token::Num(2), Token::Star, Token::Num(3), Token::Plus, Token::Num(4), Token::Star, Token::Num(5), Token::End]
check_str("run_two_terms", show(run(p3)), "ok:26")

// 100 / 5 / 2 = 10  (left-assoc division: (100/5)/2)
let p4: Array<Token> = [Token::Num(100), Token::Slash, Token::Num(5), Token::Slash, Token::Num(2), Token::End]
check_str("run_left_assoc", show(run(p4)), "ok:10")

// 10 - 3 - 2 = 5  (left-assoc subtraction: (10-3)-2)
let p5: Array<Token> = [Token::Num(10), Token::Minus, Token::Num(3), Token::Minus, Token::Num(2), Token::End]
check_str("run_left_sub", show(run(p5)), "ok:5")

// -3 + 10 = 7   (unary minus on factor)
let p6: Array<Token> = [Token::Minus, Token::Num(3), Token::Plus, Token::Num(10), Token::End]
check_str("run_unary", show(run(p6)), "ok:7")

// -(2 + 3) * 2 = -10
let p7: Array<Token> = [Token::Minus, Token::LParen, Token::Num(2), Token::Plus, Token::Num(3), Token::RParen, Token::Star, Token::Num(2), Token::End]
check_str("run_unary_paren", show(run(p7)), "ok:-10")

// 6 / 0 -> division by zero
let p8: Array<Token> = [Token::Num(6), Token::Slash, Token::Num(0), Token::End]
check_str("run_div0", show(run(p8)), "err:division by zero")

// 8 / (3 - 3) -> division by zero, error surfaces through parse+eval
let p9: Array<Token> = [Token::Num(8), Token::Slash, Token::LParen, Token::Num(3), Token::Minus, Token::Num(3), Token::RParen, Token::End]
check_str("run_div0_paren", show(run(p9)), "err:division by zero")

// missing closing paren -> parse error
let p10: Array<Token> = [Token::LParen, Token::Num(1), Token::Plus, Token::Num(2), Token::End]
check_str("run_unbalanced", show(run(p10)), "err:expected closing parenthesis")

// leading operator (no primary) -> parse error
let p11: Array<Token> = [Token::Star, Token::Num(2), Token::End]
check_str("run_lead_op", show(run(p11)), "err:unexpected token * in primary")

// trailing token after a complete expr -> trailing-token error
let p12: Array<Token> = [Token::Num(1), Token::Num(2), Token::End]
check_str("run_trailing", show(run(p12)), "err:trailing token num(2)")

// single number -> itself
let p13: Array<Token> = [Token::Num(123), Token::End]
check_str("run_single", show(run(p13)), "ok:123")

// deep nesting: ((1+2)*(3+4)) = 21
let p14: Array<Token> = [
  Token::LParen,
    Token::LParen, Token::Num(1), Token::Plus, Token::Num(2), Token::RParen,
    Token::Star,
    Token::LParen, Token::Num(3), Token::Plus, Token::Num(4), Token::RParen,
  Token::RParen,
  Token::End
]
check_str("run_deep", show(run(p14)), "ok:21")

// ---- parse-then-pretty (round-trip structure proof) ------------------
// 1 + 2 * 3  parses to  (+ 1 (* 2 3))
let pr_ast: Expr = match parse(p1) {
  Ok(a) => a
  Err(_) => Expr::Num(0)
}
check_str("parse_pretty_prec", pretty(pr_ast), "(+ 1 (* 2 3))")
check_int("parse_nodes_prec", node_count(pr_ast), 5)

// (1 + 2) * 3 parses to (* (+ 1 2) 3)
let pr_ast2: Expr = match parse(p2) {
  Ok(a) => a
  Err(_) => Expr::Num(0)
}
check_str("parse_pretty_paren", pretty(pr_ast2), "(* (+ 1 2) 3)")

// ---- union-type (type-based matching) demo ---------------------------
// Exactly the book's "Type-Based Matching" form: one type-pattern arm per
// member, binding interpolated into an f-string (book normalize()).
fn classify(value: int | string) -> string {
  match value {
    n: int => f"int:{n}"
    s: string => f"str:{s}"
  }
}
check_str("classify_pos", classify(8), "int:8")
check_str("classify_neg", classify(-5), "int:-5")
check_str("classify_str", classify("hey"), "str:hey")

// ---- batch driver: run many expressions, tally ok vs err -------------
fn count_ok(streams: Array<Array<Token>>) -> int {
  let mut i: int = 0
  let mut oks: int = 0
  while i < streams.len() {
    match run(streams[i]) {
      Ok(_) => { oks = oks + 1 }
      Err(_) => {}
    }
    i = i + 1
  }
  oks
}
let batch: Array<Array<Token>> = [p1, p2, p3, p8, p10]
// p1 ok, p2 ok, p3 ok, p8 err(div0), p10 err(paren) -> 3 ok
check_int("batch_oks", count_ok(batch), 3)

// =====================================================================
// SECTION 2 -- RPN (postfix) evaluator over a token stack
// Exercises Option<int> (Some/None on stack pop), enum match on Token,
// literal match on operator strings, Result error handling.
// =====================================================================

// Pop helper: returns Option<int>, matched at the call site (book Some/None).
fn stack_pop(stack: Array<int>) -> Option<int> {
  match stack.len() {
    0 => None
    _ => stack.pop()
  }
}

// Evaluate a postfix token stream. A binary op pops two operands.
// Returns Result<int,string>; underflow / div-by-zero / leftover are errors.
fn eval_rpn(tokens: Array<Token>) -> Result<int, string> {
  let mut stack: Array<int> = []
  let mut i: int = 0
  let mut err: string = ""
  let mut halted: bool = false
  // Loop-termination uses a boolean guard (`&& !halted`); the error path sets
  // `halted` from inside a nested match arm.
  while i < tokens.len() && !halted {
    let tok: Token = tokens[i]
    match tok {
      Token::Num(n) => { stack.push(n) }
      Token::End => {}
      _ => {
        // binary operator: pop right then left
        match stack_pop(stack) {
          None => { err = "stack underflow"; halted = true }
          Some(rhs) => match stack_pop(stack) {
            None => { err = "stack underflow"; halted = true }
            Some(lhs) => {
              match apply_op(tok, lhs, rhs) {
                Ok(v) => { stack.push(v) }
                Err(e) => { err = e; halted = true }
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  // Resolve outcome via match on the accumulated error + final stack shape.
  match halted {
    true => Err(err)
    false => match stack.len() {
      1 => Ok(stack[0])
      0 => Err("empty expression")
      _ => Err("leftover operands")
    }
  }
}

// Apply a binary operator token to two ints (enum match + div0 guard).
fn apply_op(op: Token, a: int, b: int) -> Result<int, string> {
  match op {
    Token::Plus => Ok(a + b)
    Token::Minus => Ok(a - b)
    Token::Star => Ok(a * b)
    Token::Slash => match b {
      0 => Err("division by zero")
      _ => Ok(a / b)
    }
    _ => Err(f"not a binary operator: {token_name(op)}")
  }
}

fn show_rpn(tokens: Array<Token>) -> string {
  show(eval_rpn(tokens))
}

// 3 4 + = 7
let r1: Array<Token> = [Token::Num(3), Token::Num(4), Token::Plus, Token::End]
check_str("rpn_add", show_rpn(r1), "ok:7")
// 5 1 2 + 4 * + 3 - = 14   ( 5 + ((1+2)*4) - 3 )
let r2: Array<Token> = [
  Token::Num(5), Token::Num(1), Token::Num(2), Token::Plus,
  Token::Num(4), Token::Star, Token::Plus, Token::Num(3), Token::Minus, Token::End
]
check_str("rpn_complex", show_rpn(r2), "ok:14")
// 10 2 / = 5
let r3: Array<Token> = [Token::Num(10), Token::Num(2), Token::Slash, Token::End]
check_str("rpn_div", show_rpn(r3), "ok:5")
// 7 0 / -> div by zero
let r4: Array<Token> = [Token::Num(7), Token::Num(0), Token::Slash, Token::End]
check_str("rpn_div0", show_rpn(r4), "err:division by zero")
// 3 + -> underflow (only one operand)
let r5: Array<Token> = [Token::Num(3), Token::Plus, Token::End]
check_str("rpn_underflow", show_rpn(r5), "err:stack underflow")
// 1 2 3 -> leftover operands
let r6: Array<Token> = [Token::Num(1), Token::Num(2), Token::Num(3), Token::End]
check_str("rpn_leftover", show_rpn(r6), "err:leftover operands")
// empty -> empty expression
let r7: Array<Token> = [Token::End]
check_str("rpn_empty", show_rpn(r7), "err:empty expression")
// 8 2 - 3 * = 18   ( (8-2)*3 )
let r8: Array<Token> = [Token::Num(8), Token::Num(2), Token::Minus, Token::Num(3), Token::Star, Token::End]
check_str("rpn_chain", show_rpn(r8), "ok:18")

// =====================================================================
// SECTION 3 -- constant-folding optimizer (recursive AST rewrite via match)
// Folds Bin/Neg over literal sub-trees into a single Num when it can be
// evaluated without error; otherwise leaves the structure intact.
// =====================================================================
fn is_num(e: Expr) -> bool {
  match e {
    Expr::Num(_) => true
    _ => false
  }
}

fn num_val(e: Expr) -> int {
  match e {
    Expr::Num(n) => n
    _ => 0
  }
}

fn fold(e: Expr) -> Expr {
  match e {
    Expr::Num(n) => Expr::Num(n)
    Expr::Neg(x) => {
      let fx: Expr = fold(x)
      match is_num(fx) {
        true => Expr::Num(-num_val(fx))
        false => Expr::Neg(fx)
      }
    }
    Expr::Bin(op, a, b) => {
      let fa: Expr = fold(a)
      let fb: Expr = fold(b)
      match is_num(fa) {
        false => Expr::Bin(op, fa, fb)
        true => match is_num(fb) {
          false => Expr::Bin(op, fa, fb)
          true => {
            // both folded to numbers: try to evaluate
            match eval(Expr::Bin(op, fa, fb)) {
              Ok(v) => Expr::Num(v)
              Err(_) => Expr::Bin(op, fa, fb)
            }
          }
        }
      }
    }
  }
}

// (2 + 3) * 4 folds to 20  (single Num node)
let f1: Expr = fold(Expr::Bin("*", Expr::Bin("+", Expr::Num(2), Expr::Num(3)), Expr::Num(4)))
check_str("fold_full", pretty(f1), "20")
check_int("fold_full_nodes", node_count(f1), 1)
// -(2 + 3) folds to -5
let f2: Expr = fold(Expr::Neg(Expr::Bin("+", Expr::Num(2), Expr::Num(3))))
check_str("fold_neg", pretty(f2), "-5")
// x / 0 does NOT fold (eval errors) -> structure preserved
let f3: Expr = fold(Expr::Bin("/", Expr::Num(8), Expr::Num(0)))
check_str("fold_div0_keep", pretty(f3), "(/ 8 0)")
check_int("fold_div0_nodes", node_count(f3), 3)
// nested: (1+2) * (3+4) folds to 21
let f4: Expr = fold(Expr::Bin("*",
  Expr::Bin("+", Expr::Num(1), Expr::Num(2)),
  Expr::Bin("+", Expr::Num(3), Expr::Num(4))))
check_str("fold_nested", pretty(f4), "21")
check_int("fold_nested_nodes", node_count(f4), 1)
// folding then evaluating equals direct evaluation
let big: Expr = Expr::Bin("-",
  Expr::Bin("*", Expr::Num(6), Expr::Num(7)),
  Expr::Bin("/", Expr::Num(20), Expr::Num(4)))
check_str("fold_then_eval", show(eval(fold(big))), "ok:37")
check_str("direct_eval", show(eval(big)), "ok:37")

// =====================================================================
// SECTION 4 -- boolean / comparison mini-language (more enum + guard)
// Demonstrates match on a separate enum returning bool, with guards.
// =====================================================================
enum Cmp {
  Lt(int, int),
  Eq(int, int),
  Gt(int, int),
  And(Cmp, Cmp),
  Or(Cmp, Cmp),
  Not(Cmp)
}

fn eval_cmp(c: Cmp) -> bool {
  match c {
    Cmp::Lt(a, b) => a < b
    Cmp::Eq(a, b) => a == b
    Cmp::Gt(a, b) => a > b
    Cmp::And(x, y) => eval_cmp(x) && eval_cmp(y)
    Cmp::Or(x, y) => eval_cmp(x) || eval_cmp(y)
    Cmp::Not(x) => !eval_cmp(x)
  }
}

check_bool("cmp_lt_t", eval_cmp(Cmp::Lt(1, 2)), true)
check_bool("cmp_lt_f", eval_cmp(Cmp::Lt(2, 1)), false)
check_bool("cmp_eq_t", eval_cmp(Cmp::Eq(5, 5)), true)
check_bool("cmp_gt_t", eval_cmp(Cmp::Gt(9, 3)), true)
check_bool("cmp_and", eval_cmp(Cmp::And(Cmp::Lt(1, 2), Cmp::Gt(4, 3))), true)
check_bool("cmp_and_f", eval_cmp(Cmp::And(Cmp::Lt(1, 2), Cmp::Gt(2, 3))), false)
check_bool("cmp_or", eval_cmp(Cmp::Or(Cmp::Eq(1, 2), Cmp::Eq(3, 3))), true)
check_bool("cmp_not", eval_cmp(Cmp::Not(Cmp::Lt(5, 1))), true)
// De Morgan check: Not(And(a,b)) == Or(Not a, Not b)
let dm_a: Cmp = Cmp::Lt(3, 1)
let dm_b: Cmp = Cmp::Gt(2, 9)
let lhs_dm: bool = eval_cmp(Cmp::Not(Cmp::And(dm_a, dm_b)))
let rhs_dm: bool = eval_cmp(Cmp::Or(Cmp::Not(dm_a), Cmp::Not(dm_b)))
check_bool("de_morgan", lhs_dm == rhs_dm, true)

// =====================================================================
// SECTION 5 -- aggregate statistics over a batch (match in a loop)
// =====================================================================
fn sum_oks(streams: Array<Array<Token>>) -> int {
  let mut i: int = 0
  let mut total: int = 0
  while i < streams.len() {
    match run(streams[i]) {
      Ok(v) => { total = total + v }
      Err(_) => {}
    }
    i = i + 1
  }
  total
}
// p1=7, p2=9, p3=26, p13=123 ; p8/p10 error (contribute 0)
let batch2: Array<Array<Token>> = [p1, p2, p3, p13, p8, p10]
check_int("sum_oks", sum_oks(batch2), 165)

fn count_errs(streams: Array<Array<Token>>) -> int {
  let mut i: int = 0
  let mut errs: int = 0
  while i < streams.len() {
    match run(streams[i]) {
      Ok(_) => {}
      Err(_) => { errs = errs + 1 }
    }
    i = i + 1
  }
  errs
}
check_int("count_errs", count_errs(batch2), 2)

