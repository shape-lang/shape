// small.shape — pattern-matching core, book-driven.
// Book: fundamentals/pattern-matching.mdx
// Exercises: match-as-expression, literal/where guards, type-based matching (union),
// enum matching (tuple + struct + unit payloads), constructor patterns (Some/None/Ok/Err),
// nested constructor patterns, wildcard. Every feature is taught by the chapter
// or is a direct composition of taught features (nested constructors / enum-struct payloads).

enum Token {
  Num(int),
  Op(string),
  End
}

// enum with struct-payload variant (composition of "Enum Matching")
enum Shape2 {
  Circle { radius: int },
  Rect { w: int, h: int }
}

let mut failures: int = 0
fn check(name: string, cond: bool) {
  if !cond {
    failures = failures + 1
    print(f"CHECK_FAILED: {name}")
  }
}

// Basic Match + guards + wildcard (book "Basic Match")
fn sign(n: int) -> string {
  match n {
    x: int where x < 0 => "negative"
    x: int where x == 0 => "zero"
    _ => "positive"
  }
}

// Type-Based Matching on a union (book "Type-Based Matching")
fn normalize(value: int | string) -> string {
  match value {
    n: int => f"int:{n}"
    s: string => f"str:{s}"
  }
}

// Enum Matching with tuple/unit payloads (book "Enum Matching")
fn show(t: Token) -> string {
  match t {
    Token::Num(n) => f"num({n})"
    Token::Op(o) => f"op({o})"
    Token::End => "end"
  }
}

// Enum struct-payload variant matching
fn area(s: Shape2) -> int {
  match s {
    Shape2::Circle { radius } => radius * radius * 3
    Shape2::Rect { w, h } => w * h
  }
}

// Constructor patterns: Some/None, with a nested constructor pattern (book "Constructor Patterns")
fn unwrap_or(opt: Option<int>, default: int) -> int {
  match opt {
    Some(v) => v
    None => default
  }
}

fn classify_opt(o: Option<Token>) -> string {
  match o {
    Some(Token::Num(n)) => f"some-num-{n}"
    Some(Token::Op(_)) => "some-op"
    Some(Token::End) => "some-end"
    None => "none"
  }
}

// Constructor patterns: Ok/Err on Result<string> (book "Constructor Patterns")
fn describe(result: Result<string>) -> string {
  match result {
    Ok(value) => f"success: {value}"
    Err(e) => f"failed: {e}"
  }
}

// Match Is an Expression — assign the result (book "Match Is an Expression")
fn bucket(n: int) -> int {
  match n {
    x: int where x < 10 => 0
    x: int where x < 100 => 1
    _ => 2
  }
}

check("sign neg", sign(-3) == "negative")
check("sign zero", sign(0) == "zero")
check("sign pos", sign(5) == "positive")

check("norm int", normalize(42) == "int:42")
check("norm str", normalize("hi") == "str:hi")

check("show num", show(Token::Num(42)) == "num(42)")
check("show op", show(Token::Op("+")) == "op(+)")
check("show end", show(Token::End) == "end")

check("area circle", area(Shape2::Circle { radius: 2 }) == 12)
check("area rect", area(Shape2::Rect { w: 3, h: 4 }) == 12)

check("unwrap some", unwrap_or(Some(7), 0) == 7)
check("unwrap none", unwrap_or(None, 99) == 99)

check("nested some-num", classify_opt(Some(Token::Num(9))) == "some-num-9")
check("nested some-op", classify_opt(Some(Token::Op("*"))) == "some-op")
check("nested some-end", classify_opt(Some(Token::End)) == "some-end")
check("nested none", classify_opt(None) == "none")

check("desc ok", describe(Ok("yes")) == "success: yes")
check("desc err", describe(Err("no")) == "failed: no")

let b0: int = bucket(3)
let b1: int = bucket(50)
let b2: int = bucket(500)
check("bucket 0", b0 == 0)
check("bucket 1", b1 == 1)
check("bucket 2", b2 == 2)

if failures == 0 {
  print("ALL_CHECKS_PASSED")
}
