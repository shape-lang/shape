// =====================================================================
// probe_empty_match_arm.shape — STAGE S3 (strict-flip, 2026-06-22)
// Slice: pattern-matching.  Finding #4 (empty `[]` as match-arm RESULT).
//
// Before S3: a bare `[]` literal in match-ARM-result position had no
// element type from context and lowered to the placeholder `NewArray(0)`,
// which SURFACEd `op_new_array(0)` NotImplemented at runtime (V3-S5 ckpt-5).
//
// After S3: the match's RESULT element kind is threaded into the empty arm
// from (1) the enclosing `let xs: Array<T> =` / `Array<T>` return
// annotation, or (2) a sibling arm whose body is a non-empty array literal.
// The empty arm then constructs a valid typed empty `TypedArray<T>`.
// A genuinely-unprovable empty match-arm is a CLEAN compile-error, never a
// mid-program runtime SURFACE.
// =====================================================================

let mut failures: int = 0

// (1) element type from the enclosing `let xs: Array<int>` annotation.
let a: int = 2
let xs: Array<int> = match a { 1 => [1, 2], _ => [] }
if xs.length() != 0 { failures = failures + 1 }

let ys: Array<int> = match a { 2 => [9, 8, 7], _ => [] }
if ys.length() != 3 { failures = failures + 1 }

// (2) element type from an enclosing `Array<int>` return annotation, with a
//     sibling non-empty arm also proving int.
fn pick(c: int) -> Array<int> {
  match c { 1 => [10, 20], _ => [] }
}
if pick(9).length() != 0 { failures = failures + 1 }
if pick(1).length() != 2 { failures = failures + 1 }

// (3) number element kind threaded through the empty arm.
let zs: Array<number> = match a { 1 => [1.5], _ => [] }
if zs.length() != 0 { failures = failures + 1 }

if failures == 0 {
  print("ALL_CHECKS_PASSED")
} else {
  print(f"FAILURES={failures}")
}
