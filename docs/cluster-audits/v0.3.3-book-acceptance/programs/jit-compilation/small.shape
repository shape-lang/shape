// small.shape — JIT Compilation slice (book: advanced/jit-compilation.mdx)
//
// Book thesis exercised here:
//   * "Tier-up promotion is preserved on hot functions per the T1@100 / T2@10k
//      thresholds" (mdx §--mode jit semantics). A function called far past 100
//      times MUST return the same value whether it ran interpreted (Tier 0),
//      baseline-JIT (Tier 1), or optimizing-JIT (Tier 2).
//   * "VM and JIT should produce identical stdout for any program that runs
//      without runtime error in either mode" (mdx §Verifying fall-through).
//   * JIT-compatible ops = arithmetic, comparisons, local var access, direct
//      calls, control flow (mdx §Scoped Per-Function JIT).
//
// Strategy: a compute-heavy deterministic integer kernel (Collatz step count)
// is a pure function of its argument. We call it for every n in 1..400 (399
// calls — past the T1=100 boundary) and accumulate. The total is a fixed
// number derived from Collatz semantics (independently computed), asserted
// below. If a tier transition ever changed a result, the running total would
// diverge from the expected.

fn collatz_steps(n: int) -> int {
  var x = n
  var steps = 0
  while x != 1 {
    if x % 2 == 0 {
      x = x / 2
    } else {
      x = 3 * x + 1
    }
    steps = steps + 1
  }
  steps
}

// Hand-verified anchors (Collatz step counts to reach 1):
//   1 -> 0   (already 1)
//   2 -> 1   (2->1)
//   3 -> 7   (3->10->5->16->8->4->2->1)
//   6 -> 8   (6->3->...; one more than 3)
//   27 -> 111 (classic long Collatz chain)
fn check(label: string, got: int, want: int) {
  if got != want {
    print(f"CHECK_FAILED: {label} expected={want} got={got}")
  }
}

check("collatz(1)", collatz_steps(1), 0)
check("collatz(2)", collatz_steps(2), 1)
check("collatz(3)", collatz_steps(3), 7)
check("collatz(6)", collatz_steps(6), 8)
check("collatz(27)", collatz_steps(27), 111)

// Hot accumulation: 399 calls past T1=100. Sum of step counts for n in 1..400.
// Expected total computed independently (sum over n=1..399 of collatz_steps(n)
// = 20114, verified by an external oracle, NOT back-filled from Shape output).
var total = 0
for n in 1..400 {
  total = total + collatz_steps(n)
}
check("collatz_sum_1_399", total, 20114)

print("ALL_CHECKS_PASSED")
