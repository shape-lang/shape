// inferred reference mode (read-only param)
fn total(items) {
    var sum = 0
    for item in items { sum = sum + item }
    return sum
}

// index borrow at call site &arr[0]
fn id(&x) { return x }

let nums = [10, 20, 30]
print(total(nums))

let mut arr = [5, 6, 7]
let g = id(&arr[1])
print(g)

// move expression
let a = [1, 2, 3]
let b = move a
print(b[0])

print("DONE")
