// large.shape — Reference-Driven Directed-Graph Analysis Engine
// =============================================================================
// Slice: fundamentals/references-borrowing.mdx
//
// A non-interactive, deterministic, machine-proofable graph engine built
// entirely around the chapter's reference model:
//   * Read-only traversals take a SHARED borrow:    fn f(&g)        (book §References as Function Parameters)
//   * In-place mutations take an EXCLUSIVE borrow:   fn f(&mut s)    (book §Reference Rules)
//   * Helpers return the dereferenced VALUE through a reference     (book §"return the VALUE through a reference")
//   * clone keeps an independent copy live                          (book §Move and Clone)
//   * let mut accumulators mutate directly, zero copy               (book §let and let mut)
//   * NLL lets a borrow end at last use before a later mutation     (book §Non-Lexical Lifetimes)
//
// GRAPH STORAGE — Compressed-Sparse-Row (CSR), two FLAT int arrays:
//   * `adj`     : every neighbor list concatenated, in node visitOrder
//   * `offsets` : offsets[i]..offsets[i+1] is the slice of `adj` for node i
//   CSR is used (instead of array-of-arrays) so the whole program stays in
//   flat `Array<int>` territory — see REPORT.md for why nested/empty arrays
//   are avoided in this WIP build. Both flat arrays are passed by SHARED
//   reference into every query; per-node work state (dist / visited / indeg)
//   lives in flat `Array<int>` mutated through &mut params.
//
// All reference parameters are EXPLICITLY typed `Array<int>` and all helpers
// carry explicit return types — required so indexing-through-a-reference yields
// a proven `int` rather than `unknown` (see REPORT.md book-gap note).
//
// Every computed result is asserted against an expected value derived BY HAND
// from the fixed graph BEFORE the first run (see GROUND TRUTH). On success
// prints ALL_CHECKS_PASSED.
// =============================================================================

// ----------------------------------------------------------------------------
// Test harness
// ----------------------------------------------------------------------------
var failures = 0
fn check_int(name: string, got: int, want: int) {
    if got != want {
        print(f"CHECK_FAILED: {name} expected={want} got={got}")
        failures = failures + 1
    }
}
fn check_bool(name: string, got: bool, want: bool) {
    if got != want {
        print(f"CHECK_FAILED: {name} expected={want} got={got}")
        failures = failures + 1
    }
}

// ----------------------------------------------------------------------------
// GROUND TRUTH — fixed directed graph (8 nodes 0..7)
// Edges (directed, listed neighbor visitOrder):
//   0 -> 1, 0 -> 2
//   1 -> 3, 1 -> 4
//   2 -> 4, 2 -> 5
//   3 -> 6
//   4 -> 6, 4 -> 7
//   5 -> 7
//   6 -> 7
//   7 -> (sink)
//
// CSR encoding (verified):
//   adj     = [1,2, 3,4, 4,5, 6, 6,7, 7, 7]   (11 entries)
//   offsets = [0, 2, 4, 6, 7, 9, 10, 11, 11]
//
// Hand-computed facts (expected values):
//   out-degree: [2,2,2,1,2,1,1,0]   sum = 11 edges
//   in-degree : [0,1,1,1,2,1,2,3]   sum = 11
//   Sources (indeg 0): {0} -> 1 ; Sinks (outdeg 0): {7} -> 1
//   BFS visitOrder from 0 (mark on enqueue, FIFO) = [0,1,2,3,4,5,6,7]
//   BFS hop distance from 0          = [0,1,1,2,2,2,3,3]
//   Reachable from 0 = 8 ; from 7 = 1 ; from 3 ({3,6,7}) = 3
//   DFS preorder from 0 (recursive, listed visitOrder) = [0,1,3,6,7,4,2,5]
//   Topological visitOrder (Kahn, smallest-ready-id) = [0,1,2,3,4,5,6,7]
//   Longest path (edges) from 0: L=[0,1,1,2,2,2,3,4]
//     L[7]=max(L[4],L[5],L[6])+1 = max(2,2,3)+1 = 4   (e.g. 0-1-3-6-7)
//   Edge (1,4)=true ; (4,1)=false ; (7,0)=false
// ----------------------------------------------------------------------------

let NODES = 8

// ---- flat-array helpers -----------------------------------------------------

fn filled(n: int, fill: int) -> Array<int> {
    var a = []
    var i = 0
    while i < n {
        a.push(fill)
        i = i + 1
    }
    return a
}

// single-level index-assign through an EXCLUSIVE borrow
fn set_at(&mut a: Array<int>, i: int, v: int) {
    a[i] = v
}

// ---- CSR read-only queries (SHARED borrows) ---------------------------------

// out-degree of node n — returns the dereferenced VALUE through &offsets
fn out_degree(&offsets: Array<int>, n: int) -> int {
    return offsets[n + 1] - offsets[n]
}

// k-th neighbor of node n
fn neighbor_at(&offsets: Array<int>, &adj: Array<int>, n: int, k: int) -> int {
    let base = offsets[n]
    return adj[base + k]
}

fn edge_count(&offsets: Array<int>) -> int {
    // last offset = total neighbor entries = edge count
    return offsets[NODES]
}

// directed edge u->v exists?
fn has_edge(&offsets: Array<int>, &adj: Array<int>, u: int, v: int) -> bool {
    let deg = out_degree(&offsets, u)
    var k = 0
    while k < deg {
        if neighbor_at(&offsets, &adj, u, k) == v { return true }
        k = k + 1
    }
    return false
}

fn in_degree(&offsets: Array<int>, &adj: Array<int>, n: int) -> int {
    var cnt = 0
    var u = 0
    while u < NODES {
        if has_edge(&offsets, &adj, u, n) { cnt = cnt + 1 }
        u = u + 1
    }
    return cnt
}

fn count_sources(&offsets: Array<int>, &adj: Array<int>) -> int {
    var cnt = 0
    var n = 0
    while n < NODES {
        if in_degree(&offsets, &adj, n) == 0 { cnt = cnt + 1 }
        n = n + 1
    }
    return cnt
}

fn count_sinks(&offsets: Array<int>) -> int {
    var cnt = 0
    var n = 0
    while n < NODES {
        if out_degree(&offsets, n) == 0 { cnt = cnt + 1 }
        n = n + 1
    }
    return cnt
}

// ---- BFS --------------------------------------------------------------------

fn bfs_order(&offsets: Array<int>, &adj: Array<int>, start: int) -> Array<int> {
    var enqueued = filled(NODES, 0)
    var visitOrder = []
    var queue = []
    queue.push(start)
    set_at(&mut enqueued, start, 1)
    var head = 0
    while head < queue.len() {
        let node = queue[head]
        head = head + 1
        visitOrder.push(node)
        let deg = out_degree(&offsets, node)
        var k = 0
        while k < deg {
            let nb = neighbor_at(&offsets, &adj, node, k)
            if enqueued[nb] == 0 {
                set_at(&mut enqueued, nb, 1)
                queue.push(nb)
            }
            k = k + 1
        }
    }
    return visitOrder
}

fn bfs_distances(&offsets: Array<int>, &adj: Array<int>, start: int) -> Array<int> {
    var dist = filled(NODES, -1)
    var queue = []
    queue.push(start)
    set_at(&mut dist, start, 0)
    var head = 0
    while head < queue.len() {
        let node = queue[head]
        head = head + 1
        let d = dist[node]
        let deg = out_degree(&offsets, node)
        var k = 0
        while k < deg {
            let nb = neighbor_at(&offsets, &adj, node, k)
            if dist[nb] == -1 {
                set_at(&mut dist, nb, d + 1)
                queue.push(nb)
            }
            k = k + 1
        }
    }
    return dist
}

fn reachable_count(&offsets: Array<int>, &adj: Array<int>, start: int) -> int {
    let dist = bfs_distances(&offsets, &adj, start)
    var cnt = 0
    var i = 0
    while i < dist.len() {
        if dist[i] != -1 { cnt = cnt + 1 }
        i = i + 1
    }
    return cnt
}

fn is_reachable(&offsets: Array<int>, &adj: Array<int>, start: int, target: int) -> bool {
    let dist = bfs_distances(&offsets, &adj, start)
    return dist[target] != -1
}

// ---- DFS preorder (iterative LIFO, neighbors pushed in reverse) -------------
fn dfs_preorder(&offsets: Array<int>, &adj: Array<int>, start: int) -> Array<int> {
    var visited = filled(NODES, 0)
    var visitOrder = []
    var stack = []
    stack.push(start)
    while stack.len() > 0 {
        let node = stack[stack.len() - 1]
        stack.pop()
        if visited[node] == 0 {
            set_at(&mut visited, node, 1)
            visitOrder.push(node)
            // push neighbors in reverse listed visitOrder so first neighbor is on top
            let deg = out_degree(&offsets, node)
            var k = deg - 1
            while k >= 0 {
                let nb = neighbor_at(&offsets, &adj, node, k)
                if visited[nb] == 0 {
                    stack.push(nb)
                }
                k = k - 1
            }
        }
    }
    return visitOrder
}

// ---- Topological sort (Kahn, smallest-ready-id first) -----------------------
fn topo_order(&offsets: Array<int>, &adj: Array<int>) -> Array<int> {
    var indeg = filled(NODES, 0)
    var u = 0
    while u < NODES {
        let deg = out_degree(&offsets, u)
        var k = 0
        while k < deg {
            let v = neighbor_at(&offsets, &adj, u, k)
            // read BEFORE the exclusive borrow (book §Reference Rules: owner
            // cannot be read while &mut is active — sequence the read first).
            let cur = indeg[v]
            set_at(&mut indeg, v, cur + 1)
            k = k + 1
        }
        u = u + 1
    }
    var visitOrder = []
    var emitted = filled(NODES, 0)
    var produced = 0
    while produced < NODES {
        var pick = -1
        var i = 0
        while i < NODES {
            if emitted[i] == 0 {
                if indeg[i] == 0 {
                    if pick == -1 {
                        pick = i
                    }
                }
            }
            i = i + 1
        }
        if pick == -1 {
            return visitOrder
        }
        set_at(&mut emitted, pick, 1)
        visitOrder.push(pick)
        produced = produced + 1
        let deg = out_degree(&offsets, pick)
        var k = 0
        while k < deg {
            let v = neighbor_at(&offsets, &adj, pick, k)
            let cur = indeg[v]
            set_at(&mut indeg, v, cur - 1)
            k = k + 1
        }
    }
    return visitOrder
}

// ---- Longest path length (edges) from start on a DAG, via topo DP -----------
fn longest_path_to(&offsets: Array<int>, &adj: Array<int>, start: int, target: int) -> int {
    let topo = topo_order(&offsets, &adj)
    var best = filled(NODES, -1)
    set_at(&mut best, start, 0)
    var t = 0
    while t < topo.len() {
        let u = topo[t]
        if best[u] != -1 {
            let deg = out_degree(&offsets, u)
            var k = 0
            while k < deg {
                let v = neighbor_at(&offsets, &adj, u, k)
                let cand = best[u] + 1
                if cand > best[v] {
                    set_at(&mut best, v, cand)
                }
                k = k + 1
            }
        }
        t = t + 1
    }
    return best[target]
}

// compare two int arrays for equality (two SHARED borrows)
fn arrays_equal(&a: Array<int>, &b: Array<int>) -> bool {
    // results from indexing/.len() through a shared-ref param need an explicit
    // type binding before use in a comparison (see REPORT.md book-gap note).
    let la: int = a.len()
    let lb: int = b.len()
    if la != lb { return false }
    var i = 0
    while i < la {
        let ai: int = a[i]
        let bi: int = b[i]
        if ai != bi { return false }
        i = i + 1
    }
    return true
}

// =============================================================================
// MAIN — build the CSR graph once, run every query through references, assert.
// =============================================================================

let offsets = [0, 2, 4, 6, 7, 9, 10, 11, 11]
let adj = [1, 2, 3, 4, 4, 5, 6, 6, 7, 7, 7]

// --- structural facts ---
check_int("num_nodes", NODES, 8)
check_int("edge_count", edge_count(&offsets), 11)

// out-degrees: [2,2,2,1,2,1,1,0]
check_int("outdeg_0", out_degree(&offsets, 0), 2)
check_int("outdeg_1", out_degree(&offsets, 1), 2)
check_int("outdeg_2", out_degree(&offsets, 2), 2)
check_int("outdeg_3", out_degree(&offsets, 3), 1)
check_int("outdeg_4", out_degree(&offsets, 4), 2)
check_int("outdeg_5", out_degree(&offsets, 5), 1)
check_int("outdeg_6", out_degree(&offsets, 6), 1)
check_int("outdeg_7", out_degree(&offsets, 7), 0)

// in-degrees: [0,1,1,1,2,1,2,3]
check_int("indeg_0", in_degree(&offsets, &adj, 0), 0)
check_int("indeg_1", in_degree(&offsets, &adj, 1), 1)
check_int("indeg_2", in_degree(&offsets, &adj, 2), 1)
check_int("indeg_3", in_degree(&offsets, &adj, 3), 1)
check_int("indeg_4", in_degree(&offsets, &adj, 4), 2)
check_int("indeg_5", in_degree(&offsets, &adj, 5), 1)
check_int("indeg_6", in_degree(&offsets, &adj, 6), 2)
check_int("indeg_7", in_degree(&offsets, &adj, 7), 3)

// edge existence
check_bool("edge_1_4", has_edge(&offsets, &adj, 1, 4), true)
check_bool("edge_4_1", has_edge(&offsets, &adj, 4, 1), false)
check_bool("edge_7_0", has_edge(&offsets, &adj, 7, 0), false)
check_bool("edge_0_1", has_edge(&offsets, &adj, 0, 1), true)
check_bool("edge_6_7", has_edge(&offsets, &adj, 6, 7), true)

// sources / sinks
check_int("num_sources", count_sources(&offsets, &adj), 1)
check_int("num_sinks", count_sinks(&offsets), 1)

// --- BFS visitOrder from 0 = [0,1,2,3,4,5,6,7] ---
let bfs = bfs_order(&offsets, &adj, 0)
let bfs_expected = [0, 1, 2, 3, 4, 5, 6, 7]
check_bool("bfs_order", arrays_equal(&bfs, &bfs_expected), true)
check_int("bfs_len", bfs.len(), 8)

// --- BFS distances from 0 = [0,1,1,2,2,2,3,3] ---
let dist = bfs_distances(&offsets, &adj, 0)
let dist_expected = [0, 1, 1, 2, 2, 2, 3, 3]
check_bool("bfs_distances", arrays_equal(&dist, &dist_expected), true)
check_int("dist_to_7", dist[7], 3)
check_int("dist_to_6", dist[6], 3)
check_int("dist_to_3", dist[3], 2)

// --- reachability ---
check_int("reachable_from_0", reachable_count(&offsets, &adj, 0), 8)
check_bool("reach_0_to_7", is_reachable(&offsets, &adj, 0, 7), true)
check_int("reachable_from_7", reachable_count(&offsets, &adj, 7), 1)
check_bool("reach_7_to_0", is_reachable(&offsets, &adj, 7, 0), false)
check_int("reachable_from_3", reachable_count(&offsets, &adj, 3), 3)
check_bool("reach_3_to_7", is_reachable(&offsets, &adj, 3, 7), true)
check_bool("reach_3_to_0", is_reachable(&offsets, &adj, 3, 0), false)

// --- DFS preorder from 0 = [0,1,3,6,7,4,2,5] ---
let dfs = dfs_preorder(&offsets, &adj, 0)
let dfs_expected = [0, 1, 3, 6, 7, 4, 2, 5]
check_bool("dfs_preorder", arrays_equal(&dfs, &dfs_expected), true)
check_int("dfs_len", dfs.len(), 8)
check_int("dfs_first", dfs[0], 0)
check_int("dfs_last", dfs[7], 5)

// --- topological visitOrder = [0,1,2,3,4,5,6,7] ---
let topo = topo_order(&offsets, &adj)
let topo_expected = [0, 1, 2, 3, 4, 5, 6, 7]
check_bool("topo_order", arrays_equal(&topo, &topo_expected), true)
check_int("topo_len", topo.len(), 8)
check_int("topo_first", topo[0], 0)
check_int("topo_last", topo[7], 7)

// --- longest path lengths (edges) on the DAG ---
check_int("longest_0_to_7", longest_path_to(&offsets, &adj, 0, 7), 4)
check_int("longest_0_to_6", longest_path_to(&offsets, &adj, 0, 6), 3)
check_int("longest_0_to_4", longest_path_to(&offsets, &adj, 0, 4), 2)
check_int("longest_0_to_1", longest_path_to(&offsets, &adj, 0, 1), 1)
check_int("longest_0_to_0", longest_path_to(&offsets, &adj, 0, 0), 0)
check_int("longest_7_to_0", longest_path_to(&offsets, &adj, 7, 0), -1)

// --- ownership: clone gives an independent copy; original stays usable -------
let original = bfs_order(&offsets, &adj, 0)
let copy = clone original
check_int("clone_len_orig", original.len(), 8)
check_int("clone_len_copy", copy.len(), 8)
check_bool("clone_equal", arrays_equal(&original, &copy), true)

// --- let mut accumulator: direct mutation, single owner ----------------------
let mut deg_sum = 0
var node = 0
while node < NODES {
    deg_sum = deg_sum + out_degree(&offsets, node)
    node = node + 1
}
check_int("degree_sum_equals_edges", deg_sum, 11)

// --- &mut mutation visible to caller -----------------------------------------
var counters = filled(8, 0)
fn bump_all(&mut a: Array<int>) {
    var i = 0
    while i < a.len() {
        a[i] = a[i] + 1
        i = i + 1
    }
}
bump_all(&mut counters)
bump_all(&mut counters)
check_int("counters_0", counters[0], 2)
check_int("counters_7", counters[7], 2)

// --- NLL: a shared read ends, then we mutate the owner -----------------------
var live = filled(3, 5)
let snap0 = live[0]
check_int("nll_snap0", snap0, 5)
live.push(9)
check_int("nll_after_push", live.len(), 4)
check_int("nll_pushed", live[3], 9)

// --- final tally -------------------------------------------------------------
if failures == 0 {
    print("ALL_CHECKS_PASSED")
}
