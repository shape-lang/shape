// small.shape — Ownership, References, and Borrowing (book: fundamentals/references-borrowing)
// Exercises the chapter's CORE teaching: explicit &/&mut reference parameters
// (book §"References as Function Parameters" — "the most common use of
// references"), plus binding forms, move, clone, inferred shared refs, NLL,
// and the read_val (return-value-through-shared-ref) idiom.
//
// Expected values are derived from book semantics BEFORE running:
//  - read_first(&arr) borrows shared, returns arr[0] (book §"References as Function Parameters").
//  - append(&mut arr, v) borrows exclusive, mutates in place (same section).
//  - read_val(&x) returns the DEREFERENCED value, not the reference (book §"return the VALUE through a reference").
//  - add_one(&mut n) mutates a scalar through the deref.
//  - `clone` keeps the source valid (book §"Move and Clone").
//  - Inferred reference params: a param only read => shared borrow (book §"Inferred Reference Mode").
//  - Multiple shared borrows coexist; NLL lets a &mut follow after their last use (book §"NLL").

// --- Explicit reference function params (book §"References as Function Parameters") ---
fn read_first(&arr) {
    return arr[0]
}

fn append(&mut arr, value) {
    arr.push(value)
}

// --- Return the dereferenced VALUE through a shared ref (book §References...Limits) ---
fn read_val(&x) {
    return x
}

// --- Mutate a scalar through an exclusive reference (assign to the deref) ---
fn add_one(&mut n) {
    n = n + 1
}

// --- Inferred shared-reference parameter: only read => &items ---
fn total(items) {
    var sum = 0
    for item in items { sum = sum + item }
    return sum
}

var FAILS = 0
fn check(name, expected, got) {
    if got != expected {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
        FAILS = FAILS + 1
    }
}

// 1. Shared borrow for a read via explicit &.
let mut nums = [1, 2, 3]
check("read_first", 1, read_first(&nums))

// 2. Exclusive borrow that mutates the collection in place via explicit &mut.
append(&mut nums, 4)
check("append_len", 4, nums.len())            // auto-ref (&nums).len()
check("append_first_still_1", 1, read_first(&nums))

// 3. clone keeps the source valid (book §Move and Clone).
let original = [4, 5, 6]
let copy = clone original
check("clone_src_sum", 15, total(original))   // source still valid
check("clone_dst_sum", 15, total(copy))

// 4. Return the dereferenced value through a shared reference.
let v = 99
check("read_val", 99, read_val(&v))

// 5. Mutate a scalar through &mut.
let mut k = 5
add_one(&mut k)
check("add_one", 6, k)

// 6. Inferred shared-reference mode (read-only param).
check("total", 25, total([3, 7, 2, 9, 4]))

// 7. Multiple shared borrows coexist; NLL lets a &mut follow (book §NLL).
let mut x = 10
let r1 = &x
let r2 = &x
check("shared_r1", 10, r1)
check("shared_r2", 10, r2)
let m = &mut x                                 // OK: shared borrows ended (NLL)
check("nll_mut", 10, m)

// 8. Copy scalars are implicitly copied; explicit move still yields the value.
let a = 10
let b = a                                      // int is Copy: a stays valid
check("copy_int", 20, a + b)
let mv = move a
check("move_int", 10, mv)

if FAILS == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"FAILS={FAILS}")
}
