// Probe: binding forms, clone, references at call site
fn read_first(&arr) {
    return arr[0]
}

fn append(&mut arr, value) {
    arr.push(value)
}

fn read_val(&x) {
    return x
}

let mut data = [1, 2, 3]
let first = read_first(&data)
print(first)
append(&mut data, 4)
print(data[3])

let c = [4, 5, 6]
let d = clone c
print(c[0])
print(d[0])

let v = read_val(&first)
print(v)
print("DONE")
