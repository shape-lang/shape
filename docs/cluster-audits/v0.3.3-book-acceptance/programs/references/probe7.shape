type Point { x: int, y: int }

fn read_x(&p) {
    return p.x
}

fn bump_x(&mut p, by: int) {
    p.x = p.x + by
}

let mut pt = Point { x: 1, y: 2 }
print(read_x(&pt))
bump_x(&mut pt, 10)
print(pt.x)
print(pt.y)

// disjoint field assignment
let mut q = Point { x: 5, y: 6 }
q.x = 50
q.y = 60
print(q.x)
print(q.y)

print("DONE")
