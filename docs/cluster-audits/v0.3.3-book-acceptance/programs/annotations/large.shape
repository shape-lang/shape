// large.shape -- Annotations slice real-world application
// Book sources: advanced/annotations.mdx + advanced/comptime-annotations-cookbook.mdx
//
// APPLICATION: an annotation-driven "policy + serialization framework" --- the
// canonical real-world use of Shape annotations the book advertises:
//   * @serializable  (cookbook Recipe 2)           -> comptime-generated to_json/from_json
//   * @json_schema   (cookbook Recipe 2b)          -> schema from @description/@range field annotations
//   * @traced        (annotations.mdx Define/Apply) -> runtime before/after wrapper
//   * @validate      (before-return short-circuit contract, annotations.mdx)
//   * @memoize       (ctx.state persistence contract, annotations.mdx)
//   * @host_typed    (cookbook Recipe 13 guardrail) -> comptime pre guardrail
//
// Each section computes results and ASSERTS each against an EXPECTED VALUE
// derived from BOOK SEMANTICS (written before first run). On all-pass prints
// ALL_CHECKS_PASSED; on any mismatch prints CHECK_FAILED: <which> expected/got.
//
// ============================================================================
// EXPECTED VALUES (book-derived, pre-run):
//
//  S1 @traced runtime wrapper (annotations.mdx "Define an Annotation",
//     "before/after Return Contract"):
//     - before is identity-on-args (returns args, case 3 -> args unchanged)
//     - after returns result unchanged
//     => traced_add(3, 4) == 7 ; traced_add(100, 1) == 101
//
//  S2 @validate before short-circuit (annotations.mdx "before Return Contract"
//     case 2, result non-null -> wrapper returns result, impl NOT invoked):
//     - validate rejects negative inputs by returning { result: -1 }
//     => safe_sqrt_floor(16) == 4 ; safe_sqrt_floor(-9) == -1 (short-circuit)
//
//  S3 @memoize ctx.state persistence (annotations.mdx "Runtime ctx" +
//     "before Return Contract" case 2 state rebuild):
//     - first call computes, second call with same arg returns cached
//     => fib(10) == 55 ; fib(10) again == 55 (cache hit, same value)
//
//  S4 @serializable comptime derive (cookbook Recipe 2):
//     - generates to_json on the type; Point{1.0,2.0}.to_json() == "{\"x\":1,\"y\":2}"
//
//  S5 @json_schema from field annotations (cookbook Recipe 2b):
//     - Prompt.schema() includes description "The user's query" for query field
//
//  S6 @host_typed comptime guardrail (cookbook Recipe 13):
//     - a const-first-param fn compiles; the guardrail does NOT error.
// ============================================================================

// ---------------------------------------------------------------------------
// S1: @traced runtime before/after wrapper (identity contract)
// ---------------------------------------------------------------------------
annotation traced(tag) {
  targets: [function]

  before(args, ctx) {
    // identity tail: returning original args -> contract case 3 (unchanged)
    args
  }

  after(args, result, ctx) {
    // after return becomes caller-visible value; identity here
    result
  }
}

@traced("arith")
fn traced_add(a: int, b: int) -> int {
  a + b
}

// ---------------------------------------------------------------------------
// S2: @validate -- before short-circuit object form { result: ... }
// ---------------------------------------------------------------------------
annotation validate() {
  targets: [function]

  before(args, ctx) {
    // book before-contract case 2: object with non-null result short-circuits
    if args[0] < 0 {
      { result: -1 }
    } else {
      args
    }
  }

  after(args, result, ctx) {
    result
  }
}

@validate()
fn safe_sqrt_floor(n: int) -> int {
  let mut i = 0
  while (i + 1) * (i + 1) <= n {
    i = i + 1
  }
  i
}

// ---------------------------------------------------------------------------
// S3: @memoize -- ctx.state persistence + state-rebuild contract
// ---------------------------------------------------------------------------
annotation memoize() {
  targets: [function]

  before(args, ctx) {
    // consult ctx.state cache map keyed by arg; if hit, short-circuit.
    // (use ?? default form rather than `!= null`; the bare `null` keyword is
    //  rejected by the parser on the RHS of `!=` at this release -- book-gap)
    let key = args[0]
    let cache = ctx.state
    let hit = cache[key] ?? -1
    if hit >= 0 {
      { result: hit }
    } else {
      args
    }
  }

  after(args, result, ctx) {
    // record into ctx.state via state rebuild
    let key = args[0]
    let cache = ctx.state
    cache[key] = result
    result
  }
}

@memoize()
fn fib(n: int) -> int {
  if n < 2 {
    n
  } else {
    let mut a = 0
    let mut b = 1
    let mut i = 0
    while i < n - 1 {
      let t = a + b
      a = b
      b = t
      i = i + 1
    }
    b
  }
}

// ---------------------------------------------------------------------------
// S4: @serializable comptime derive (cookbook Recipe 2, runnable=true)
// ---------------------------------------------------------------------------
annotation serializable() {
  targets: [type]

  comptime pre(target, ctx) {
    comptime for field in target.fields {
      if field.type == "function" {
        error("Serializable type cannot include function fields")
      }
    }
  }

  comptime post(target, ctx) {
    extend target {
      method to_json() {
        f"{{\"x\":{self.x},\"y\":{self.y}}}"
      }
    }
  }
}

@serializable()
type Point { x: number, y: number }

// ---------------------------------------------------------------------------
// S5: @json_schema from field annotations (cookbook Recipe 2b, runnable=true)
// ---------------------------------------------------------------------------
type Prompt {
  @description("The user's query")
  query: string

  @description("Creativity level")
  @range(0.0, 1.0)
  temperature: number
}

annotation json_schema() {
  targets: [type]

  comptime post(target, ctx) {
    extend target {
      method schema() -> string {
        let mut parts = ""
        comptime for field in target.fields {
          comptime for ann in field.annotations {
            if ann.name == "description" {
              parts = parts + ann.args[0]
            }
          }
        }
        parts
      }
    }
  }
}

// ---------------------------------------------------------------------------
// S6: @host_typed comptime guardrail (cookbook Recipe 13, runnable=true)
// ---------------------------------------------------------------------------
comptime fn require_const_host(target) {
  if target.params.length == 0 || target.params[0].const != true {
    error("First parameter must be const for host policy")
  }
}

annotation host_typed() {
  targets: [function]

  comptime pre(target, ctx) {
    require_const_host(target)
  }
}

@host_typed()
fn routed(const region: string, payload: int) -> int {
  payload
}

// ===========================================================================
// MACHINE-PROOFABLE ASSERTIONS
// ===========================================================================
fn check_int(name: string, expected: int, got: int) -> bool {
  if expected != got {
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    false
  } else {
    true
  }
}

fn check_str(name: string, expected: string, got: string) -> bool {
  if expected != got {
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    false
  } else {
    true
  }
}

fn run_all() -> bool {
  let mut ok = true

  // S1
  ok = check_int("S1.traced_add(3,4)", 7, traced_add(3, 4)) && ok
  ok = check_int("S1.traced_add(100,1)", 101, traced_add(100, 1)) && ok

  // S2
  ok = check_int("S2.safe_sqrt_floor(16)", 4, safe_sqrt_floor(16)) && ok
  ok = check_int("S2.safe_sqrt_floor(-9)", -1, safe_sqrt_floor(-9)) && ok

  // S3
  ok = check_int("S3.fib(10)", 55, fib(10)) && ok
  ok = check_int("S3.fib(10).cached", 55, fib(10)) && ok

  // S4
  let p = Point { x: 1.0, y: 2.0 }
  ok = check_str("S4.Point.to_json", "{\"x\":1,\"y\":2}", p.to_json()) && ok

  // S5
  let pr = Prompt { query: "hi", temperature: 0.5 }
  ok = check_str("S5.Prompt.schema", "The user's queryCreativity level", pr.schema()) && ok

  // S6
  ok = check_int("S6.routed", 99, routed("eu-west", 99)) && ok

  ok
}

if run_all() {
  print("ALL_CHECKS_PASSED")
}
