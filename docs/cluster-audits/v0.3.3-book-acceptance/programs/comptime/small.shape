// small.shape -- comptime slice (book: advanced/comptime.mdx)
// Exercises: comptime expression block, comptime fn helpers (composition),
// top-level side-effect form, build_config(), comptime fields on types.
// Determinism: every comptime value is baked at compile time (pure).

// --- comptime fn helpers (book: "comptime fn Helpers") ---
comptime fn double(n: int) -> int { n * 2 }
comptime fn quad(n: int) -> int { double(double(n)) }

comptime fn factorial(n: int) -> int {
  let mut acc = 1
  let mut i = 1
  while i <= n {
    acc = acc * i
    i = i + 1
  }
  acc
}

comptime fn normalize_uri(uri: string) -> string {
  uri.trim()
}

// --- top-level side-effect form (book: "Top-level side-effect form") ---
// warning(...) is accepted in v0.3.3 (emits no diagnostic per the v0.4 preview note).
comptime {
  warning("compiling small comptime demo")
}

// --- comptime expression blocks: evaluate now, embed literal (book: "Comptime Blocks") ---
let BUILD_TAG = comptime { "dev" }
let QUAD3 = comptime { quad(3) }          // double(double(3)) = 12
let FACT5 = comptime { factorial(5) }     // 120
let URI = comptime { normalize_uri("  duckdb://analytics.db  ") }

// arithmetic inside a comptime block with its own locals (book: "Comptime Scope Rules")
let CALC = comptime {
  let a = 3
  let b = 4
  a * b + 5                                // 17
}

// build_config() is live in v0.3.3 (book: "Comptime Builtins")
let DEBUG_FLAG = comptime { build_config().debug }   // release binary -> false

// --- comptime fields on types (book: "Comptime Fields on Types") ---
type Unit {
  comptime symbol: string = "m"
  comptime precision: int = 2
}
type Celsius = Unit { symbol: "°C" }

// --- self-checking (book teaches no assert; use explicit checks) ---
fn check(name: string, cond: bool) {
  if !cond {
    print(f"CHECK_FAILED: {name}")
  }
}

check("BUILD_TAG", BUILD_TAG == "dev")
check("QUAD3", QUAD3 == 12)
check("FACT5", FACT5 == 120)
check("URI", URI == "duckdb://analytics.db")
check("CALC", CALC == 17)
check("DEBUG_FLAG", DEBUG_FLAG == false)

print(f"BUILD_TAG={BUILD_TAG}")
print(f"QUAD3={QUAD3}")
print(f"FACT5={FACT5}")
print(f"URI={URI}")
print(f"CALC={CALC}")
print("ALL_CHECKS_PASSED")
