// small.shape — comptime slice core exercise.
// Book: advanced/comptime.mdx
//   - "Comptime Blocks" expression form: evaluate now, embed literal result
//   - "comptime fn Helpers": reusable compile-time helpers at module scope
//   - "Comptime Builtins": build_config() -> { debug, version, target_os, target_arch }
//   - "Comptime Fields on Types": comptime fields are compile-time-only metadata
//
// Strategy: PURE. Every asserted value is a comptime-evaluated constant baked
// at compile time. Expected values are derived from book semantics BEFORE running.

// --- comptime fn helpers (book: "comptime fn Helpers") ---
comptime fn square(n: int) -> int { n * n }

comptime fn factorial(n: int) -> int {
  let mut r = 1
  let mut i = 2
  while i <= n { r = r * i; i = i + 1 }
  r
}

comptime fn normalize_uri(uri: string) -> string { uri.trim() }

// --- type with comptime metadata fields (book: "Comptime Fields on Types") ---
type Sample {
  comptime symbol: string = "m"
  comptime precision: int = 2
  value: number
}

// --- comptime block expression form (book: "Comptime Blocks") ---
let arith = comptime { 2 + 3 * 4 }            // precedence: * before + -> 14
let sq = comptime { square(9) }               // 81
let fact = comptime { factorial(6) }          // 720
let triangle = comptime {                     // sum 1..=10 = 55
  let mut s = 0
  for i in 1..=10 { s = s + i }
  s
}
let cond = comptime { if 7 > 3 { "yes" } else { "no" } }   // "yes"
let trimmed = comptime { normalize_uri("  duckdb://db  ") } // "duckdb://db"

// --- build_config builtin (book: "Comptime Builtins") ---
// build_config().target_os is the host build target; this binary reports "linux".
let os = comptime { build_config().target_os }

// runtime field of a type that also carries comptime metadata fields
let smp = Sample { value: 5.0 }

// --- self-checking assertions (expected values derived from book semantics) ---
let mut ok = true

if arith != 14 { print("CHECK_FAILED: arith expected=14 got=" + arith.to_string()); ok = false }
if sq != 81 { print("CHECK_FAILED: sq expected=81 got=" + sq.to_string()); ok = false }
if fact != 720 { print("CHECK_FAILED: fact expected=720 got=" + fact.to_string()); ok = false }
if triangle != 55 { print("CHECK_FAILED: triangle expected=55 got=" + triangle.to_string()); ok = false }
if cond != "yes" { print("CHECK_FAILED: cond expected=yes got=" + cond); ok = false }
if trimmed != "duckdb://db" { print("CHECK_FAILED: trimmed expected=duckdb://db got=" + trimmed); ok = false }
if os != "linux" { print("CHECK_FAILED: os expected=linux got=" + os); ok = false }
if smp.value != 5.0 { print("CHECK_FAILED: smp.value expected=5 got=" + smp.value.to_string()); ok = false }

if ok { print("ALL_CHECKS_PASSED") }
