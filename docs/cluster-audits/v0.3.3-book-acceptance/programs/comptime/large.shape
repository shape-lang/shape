// large.shape — Compile-Time Numeric Kernel & Lookup-Table Generator
// ============================================================================
// Slice: comptime (book: advanced/comptime.mdx)
// Determinism strategy: PURE. Every asserted value is a COMPTIME-EVALUATED
// constant baked at compile time by `comptime { ... }` over `comptime fn`
// helpers (book sections "Comptime Blocks" and "comptime fn Helpers").
//
// Real-world framing: a library author often wants numeric lookup tables and
// derived constants computed once, at build time, so the runtime ships with
// the answers already baked in. This program is that build-time computation:
//   number theory (gcd/lcm/primes/totient), combinatorics (factorial/nCr),
//   integer math (pow/isqrt/digit ops/base conversion), fixed-point helpers,
//   a tiny deterministic checksum, and a Collatz analyzer — all evaluated in
//   `comptime`, then asserted against expected values written from book
//   semantics + hand math BEFORE the first run.
//
// NOTE ON SCOPE (verified against this binary):
//   - comptime supports: integer arithmetic, while/for loops, if/else,
//     `return`, nested `comptime fn` calls, bool/int/string scalar results.
//   - Arrays that ESCAPE a comptime block currently fail (W17 / ADR-006
//     §2.7.24 carrier gap). So every table is consumed AS SCALARS: we compute
//     an aggregate (sum/xor/specific index) inside comptime and bake the
//     scalar out. This keeps the program in the clean, defect-free surface.
// ============================================================================


// ----------------------------------------------------------------------------
// SECTION 1 — Number theory comptime fn helpers
// ----------------------------------------------------------------------------

comptime fn gcd(a: int, b: int) -> int {
  let mut x = a
  let mut y = b
  if x < 0 { x = 0 - x }
  if y < 0 { y = 0 - y }
  while y != 0 {
    let t = y
    y = x % y
    x = t
  }
  x
}

comptime fn lcm(a: int, b: int) -> int {
  if a == 0 { return 0 }
  if b == 0 { return 0 }
  let g = gcd(a, b)
  let mut prod = a * b
  if prod < 0 { prod = 0 - prod }
  prod / g
}

comptime fn is_prime(n: int) -> bool {
  if n < 2 { return false }
  if n == 2 { return true }
  if n % 2 == 0 { return false }
  let mut i = 3
  while i * i <= n {
    if n % i == 0 { return false }
    i = i + 2
  }
  true
}

comptime fn nth_prime(k: int) -> int {
  // 1-indexed: nth_prime(1) == 2
  let mut found = 0
  let mut candidate = 1
  while found < k {
    candidate = candidate + 1
    if is_prime(candidate) { found = found + 1 }
  }
  candidate
}

comptime fn count_primes_below(limit: int) -> int {
  // primes strictly below `limit`
  let mut c = 0
  let mut k = 2
  while k < limit {
    if is_prime(k) { c = c + 1 }
    k = k + 1
  }
  c
}

comptime fn sum_primes_below(limit: int) -> int {
  let mut s = 0
  let mut k = 2
  while k < limit {
    if is_prime(k) { s = s + k }
    k = k + 1
  }
  s
}

comptime fn euler_totient(n: int) -> int {
  // Euler's phi via the product formula computed with integer math.
  if n <= 0 { return 0 }
  let mut result = n
  let mut m = n
  let mut p = 2
  while p * p <= m {
    if m % p == 0 {
      while m % p == 0 { m = m / p }
      result = result - (result / p)
    }
    p = p + 1
  }
  if m > 1 { result = result - (result / m) }
  result
}

comptime fn count_divisors(n: int) -> int {
  if n <= 0 { return 0 }
  let mut c = 0
  let mut i = 1
  while i * i <= n {
    if n % i == 0 {
      if i * i == n { c = c + 1 } else { c = c + 2 }
    }
    i = i + 1
  }
  c
}

comptime fn sum_divisors(n: int) -> int {
  if n <= 0 { return 0 }
  let mut s = 0
  let mut i = 1
  while i <= n {
    if n % i == 0 { s = s + i }
    i = i + 1
  }
  s
}

comptime fn is_perfect(n: int) -> bool {
  // perfect number == sum of proper divisors equals n
  sum_divisors(n) - n == n
}


// ----------------------------------------------------------------------------
// SECTION 2 — Combinatorics comptime fn helpers
// ----------------------------------------------------------------------------

comptime fn factorial(n: int) -> int {
  let mut r = 1
  let mut i = 2
  while i <= n { r = r * i; i = i + 1 }
  r
}

comptime fn choose(n: int, k: int) -> int {
  // n choose k via multiplicative formula (avoids large factorial overflow)
  if k < 0 { return 0 }
  if k > n { return 0 }
  let mut kk = k
  if kk > n - kk { kk = n - kk }
  let mut num = 1
  let mut den = 1
  let mut i = 0
  while i < kk {
    num = num * (n - i)
    den = den * (i + 1)
    i = i + 1
  }
  num / den
}

comptime fn catalan(n: int) -> int {
  // Catalan number C_n = choose(2n, n) / (n + 1)
  choose(2 * n, n) / (n + 1)
}

comptime fn fib(n: int) -> int {
  let mut a = 0
  let mut b = 1
  let mut i = 0
  while i < n {
    let t = a + b
    a = b
    b = t
    i = i + 1
  }
  a
}

comptime fn sum_fib(count: int) -> int {
  // sum of fib(0)..fib(count-1)
  let mut s = 0
  let mut i = 0
  while i < count { s = s + fib(i); i = i + 1 }
  s
}


// ----------------------------------------------------------------------------
// SECTION 3 — Integer math comptime fn helpers
// ----------------------------------------------------------------------------

comptime fn ipow(base: int, exp: int) -> int {
  let mut r = 1
  let mut e = exp
  while e > 0 { r = r * base; e = e - 1 }
  r
}

comptime fn isqrt(n: int) -> int {
  // floor(sqrt(n)) by linear search (n kept small in tests)
  if n < 0 { return 0 }
  let mut r = 0
  while (r + 1) * (r + 1) <= n { r = r + 1 }
  r
}

comptime fn digit_sum(n: int) -> int {
  let mut m = n
  if m < 0 { m = 0 - m }
  let mut s = 0
  while m > 0 { s = s + (m % 10); m = m / 10 }
  s
}

comptime fn digit_count(n: int) -> int {
  let mut m = n
  if m < 0 { m = 0 - m }
  if m == 0 { return 1 }
  let mut c = 0
  while m > 0 { c = c + 1; m = m / 10 }
  c
}

comptime fn reverse_int(n: int) -> int {
  let mut m = n
  let mut neg = false
  if m < 0 { neg = true; m = 0 - m }
  let mut r = 0
  while m > 0 { r = r * 10 + (m % 10); m = m / 10 }
  if neg { 0 - r } else { r }
}

comptime fn is_palindrome_int(n: int) -> bool {
  n == reverse_int(n)
}

comptime fn count_bits(n: int) -> int {
  // popcount via repeated division by 2 (n >= 0)
  let mut m = n
  let mut c = 0
  while m > 0 { c = c + (m % 2); m = m / 2 }
  c
}

comptime fn to_base_value(n: int, base: int) -> int {
  // interpret the base-10 digits of n as base-`base` digits, producing the
  // integer value. Exercises positional weighting with comptime arithmetic.
  let mut m = n
  let mut weight = 1
  let mut acc = 0
  while m > 0 {
    let d = m % 10
    acc = acc + d * weight
    weight = weight * base
    m = m / 10
  }
  acc
}


// ----------------------------------------------------------------------------
// SECTION 4 — Deterministic checksum & sequence analyzers
// ----------------------------------------------------------------------------

comptime fn xor_int(a: int, b: int) -> int {
  // bitwise xor on non-negative ints implemented with integer arithmetic.
  let mut x = a
  let mut y = b
  let mut bit = 1
  let mut result = 0
  while x > 0 {
    let ax = x % 2
    let by = y % 2
    if ax != by { result = result + bit }
    x = x / 2
    y = y / 2
    bit = bit * 2
  }
  while y > 0 {
    let by = y % 2
    if by == 1 { result = result + bit }
    y = y / 2
    bit = bit * 2
  }
  result
}

comptime fn xor_fold(limit: int) -> int {
  // xor of (i*i mod 251) for i in 1..=limit.
  let mut acc = 0
  let mut i = 1
  while i <= limit {
    let v = (i * i) % 251
    acc = xor_int(acc, v)
    i = i + 1
  }
  acc
}

comptime fn collatz_steps(n: int) -> int {
  // number of steps to reach 1 under the Collatz map
  let mut m = n
  let mut steps = 0
  while m != 1 {
    if m % 2 == 0 { m = m / 2 } else { m = 3 * m + 1 }
    steps = steps + 1
  }
  steps
}

comptime fn collatz_max(n: int) -> int {
  // maximum value reached during the Collatz trajectory from n
  let mut m = n
  let mut peak = n
  while m != 1 {
    if m % 2 == 0 { m = m / 2 } else { m = 3 * m + 1 }
    if m > peak { peak = m }
  }
  peak
}

comptime fn polygonal(sides: int, n: int) -> int {
  // n-th s-gonal number. s=3 triangular, s=4 squares, s=5 pentagonal.
  ((sides - 2) * n * n - (sides - 4) * n) / 2
}

comptime fn ackermann_capped(m: int, n: int) -> int {
  // Ackermann is heavy; we only test small (m<=2) inputs where it stays cheap.
  if m == 0 { return n + 1 }
  if n == 0 { return ackermann_capped(m - 1, 1) }
  ackermann_capped(m - 1, ackermann_capped(m, n - 1))
}


// ----------------------------------------------------------------------------
// SECTION 5 — String classification comptime fn helpers
// ----------------------------------------------------------------------------

comptime fn classify_count(n: int) -> string {
  if n < 0 { return "negative" }
  if n == 0 { return "zero" }
  if n < 10 { return "small" }
  if n < 100 { return "medium" }
  "large"
}

comptime fn parity_word(n: int) -> string {
  if n % 2 == 0 { "even" } else { "odd" }
}


