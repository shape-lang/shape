// SECTION 5 -- BAKE compile-time constants (book: "Comptime Blocks")
// Each `comptime { ... }` is evaluated during compilation and embedded.
// ============================================================================

// number theory
let K_FACT_5  = comptime { ct_factorial(5) }            // 120
let K_FACT_10 = comptime { ct_factorial(10) }           // 3628800
let K_FIB_10  = comptime { ct_fib(10) }                 // 55
let K_FIB_20  = comptime { ct_fib(20) }                 // 6765
