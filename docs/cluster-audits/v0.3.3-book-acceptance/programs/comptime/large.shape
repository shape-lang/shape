// build metadata (book: "Comptime Builtins", build_config live in v0.3.3)
let K_DEBUG   = comptime { build_config().debug }       // release binary -> false (NOTE: false-bake defect)
let K_VERSION = comptime { build_config().version }     // host: "0.3.2"
let K_OS      = comptime { build_config().target_os }   // host: "linux"

// ============================================================================
// SECTION 6 -- RUNTIME recomputation (independent witnesses)
// These mirror the comptime fns as ordinary runtime fns. If comptime evaluation
// is faithful, comptime constant == runtime recomputation for every quantity.
// ============================================================================

fn rt_factorial(n: int) -> int {
  let mut acc = 1
  let mut i = 1
  while i <= n {
    acc = acc * i
    i = i + 1
  }
  acc
}

fn rt_fib(n: int) -> int {
  let mut a = 0
  let mut b = 1
  let mut i = 0
  while i < n {
    let t = a + b
    a = b
    b = t
    i = i + 1
  }
  a
}

fn rt_gcd(a: int, b: int) -> int {
  let mut x = a
  let mut y = b
  while y != 0 {
    let t = y
    y = x % y
    x = t
  }
  x
}

fn rt_lcm(a: int, b: int) -> int {
  a / rt_gcd(a, b) * b
}

fn rt_digit_sum(n: int) -> int {
  let mut x = n
  let mut s = 0
  while x > 0 {
    s = s + x % 10
    x = x / 10
  }
  s
}

fn rt_collatz_len(n: int) -> int {
  let mut x = n
  let mut steps = 0
  while x > 1 {
    if x % 2 == 0 {
      x = x / 2
    } else {
      x = 3 * x + 1
    }
    steps = steps + 1
  }
  steps
}

fn rt_count_primes_below(limit: int) -> int {
  let mut count = 0
  let mut k = 2
  while k < limit {
    let mut prime = true
    let mut d = 2
    while d * d <= k {
      if k % d == 0 {
        prime = false
      }
      d = d + 1
    }
    if prime {
      count = count + 1
    }
    k = k + 1
  }
  count
}

fn rt_pow_int(base: int, exp: int) -> int {
  let mut acc = 1
  let mut i = 0
  while i < exp {
    acc = acc * base
    i = i + 1
  }
  acc
}

fn rt_sum_range(lo: int, hi: int) -> int {
  let mut s = 0
  let mut i = lo
  while i <= hi {
    s = s + i
    i = i + 1
  }
  s
}

fn rt_c_to_f(c: number) -> number { c * 1.8 + 32.0 }
fn rt_c_to_k(c: number) -> number { c + 273.15 }
fn rt_km_to_mi(km: number) -> number { km * 0.621371 }
fn rt_kg_to_lb(kg: number) -> number { kg * 2.2046226218 }
fn rt_circle_area(r: number) -> number { 3.141592653589793 * r * r }
fn rt_hypot(a: number, b: number) -> number { sqrt(a * a + b * b) }

fn rt_normalize_uri(uri: string) -> string { uri.trim() }
fn rt_upper_len(s: string) -> int { s.toUpperCase().length() }
fn rt_field_count(csv: string) -> int { csv.split(",").length() }

fn rt_len_hash(s: string) -> int {
  let n = s.length()
  let mut h = 2166136261
  let mut i = 0
  while i < n {
    h = (h * 16777619 + i + 7) % 1000000007
    i = i + 1
  }
  h
}

// ============================================================================
// SECTION 7 -- check harness
// ============================================================================

let mut g_failures = 0

fn check_int(name: string, got: int, expected: int) {
  if got != expected {
    g_failures = g_failures + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}

fn check_num(name: string, got: number, expected: number) {
  // exact equality is fine: all constants are deterministic IEEE-754 results of
  // the identical comptime vs runtime expression.
  if got != expected {
    g_failures = g_failures + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}

fn check_str(name: string, got: string, expected: string) {
  if got != expected {
    g_failures = g_failures + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}

fn check_bool(name: string, got: bool, expected: bool) {
  if got != expected {
    g_failures = g_failures + 1
    print(f"CHECK_FAILED: {name} expected={expected} got={got}")
  }
}

