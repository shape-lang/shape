// --- Composite comptime sites: combine several helpers inside one block ---
let r_combo1 = comptime {
  // sum of the first 5 primes squared
  let mut s = 0
  let mut k = 1
  while k <= 5 {
    let p = nth_prime(k)
    s = s + p * p
    k = k + 1
  }
  s
}  // 2^2+3^2+5^2+7^2+11^2 = 4+9+25+49+121 = 208

let r_combo2 = comptime {
  // gcd of two factorial-derived numbers
  gcd(factorial(6), factorial(5))
}  // gcd(720,120)=120

let r_combo3 = comptime {
  // count palindromic numbers in 1..=200
  let mut c = 0
  let mut i = 1
  while i <= 200 {
    if is_palindrome_int(i) { c = c + 1 }
    i = i + 1
  }
  c
}  // recomputed at runtime

let r_combo4 = comptime {
  // total Collatz steps for n in 2..=10
  let mut total = 0
  let mut n = 2
  while n <= 10 {
    total = total + collatz_steps(n)
    n = n + 1
  }
  total
}  // recomputed at runtime

let r_combo5 = comptime {
  // deterministic checksum: fold (i * fib(i)) mod 1000 for i in 1..=12
  let mut acc = 0
  let mut i = 1
  while i <= 12 {
    acc = (acc + i * fib(i)) % 1000
    i = i + 1
  }
  acc
}  // recomputed at runtime


// ----------------------------------------------------------------------------
// SECTION 6 — Fixed-point arithmetic comptime fn helpers
// (Q16.16-style: represent a rational as an integer scaled by 1<<16 = 65536.)
// ----------------------------------------------------------------------------

comptime fn fp_scale() -> int { 65536 }   // 2^16

comptime fn fp_from_int(n: int) -> int { n * fp_scale() }

comptime fn fp_mul(a: int, b: int) -> int {
  // (a * b) / scale, with integer arithmetic
  (a * b) / fp_scale()
}

comptime fn fp_div(a: int, b: int) -> int {
  // (a * scale) / b
  (a * fp_scale()) / b
}

comptime fn fp_to_int_floor(a: int) -> int {
  // floor of the fixed-point value back to a plain int
  a / fp_scale()
}

comptime fn fp_sqrt(a: int) -> int {
  // fixed-point sqrt via Newton on the scaled representation.
  // returns sqrt(a) in fixed-point, where `a` is a fixed-point value.
  if a <= 0 { return 0 }
  // initial guess: a itself (scaled). Iterate a fixed number of times.
  let mut x = a
  let mut iter = 0
  while iter < 40 {
    // x = (x + a*scale/x) / 2   -> but keep within fixed-point semantics
    let term = fp_div(a, x)
    x = (x + term) / 2
    iter = iter + 1
  }
  x
}

// ----------------------------------------------------------------------------
// SECTION 7 — Deterministic LCG pseudo-random generator (seeded => pure)
// ----------------------------------------------------------------------------

comptime fn lcg_next(state: int) -> int {
  // Numerical-Recipes-style LCG constants, masked to 31 bits to stay positive.
  // next = (1664525 * state + 1013904223) mod 2^31
  let m = 2147483648                  // 2^31
  let mut v = (1664525 * state + 1013904223) % m
  if v < 0 { v = v + m }
  v
}

comptime fn lcg_nth(seed: int, n: int) -> int {
  let mut s = seed
  let mut i = 0
  while i < n { s = lcg_next(s); i = i + 1 }
  s
}

comptime fn lcg_sum_mod(seed: int, count: int, modulus: int) -> int {
  // sum of the first `count` outputs (each reduced mod `modulus`), mod modulus
  let mut s = seed
  let mut acc = 0
  let mut i = 0
  while i < count {
    s = lcg_next(s)
    acc = (acc + (s % modulus)) % modulus
    i = i + 1
  }
  acc
}

// ----------------------------------------------------------------------------
// SECTION 8 — Tiny stack-machine evaluator over a packed integer program.
// A "program" is encoded as a single int whose base-10 digit pairs are ops:
// we instead drive it with explicit helpers to stay deterministic & checkable.
// ----------------------------------------------------------------------------

comptime fn eval_poly(x: int, c0: int, c1: int, c2: int, c3: int) -> int {
  // Horner evaluation of c3*x^3 + c2*x^2 + c1*x + c0
  ((c3 * x + c2) * x + c1) * x + c0
}

comptime fn sum_poly_over(lo: int, hi: int, c0: int, c1: int, c2: int) -> int {
  // sum of (c2*x^2 + c1*x + c0) for x in lo..=hi
  let mut s = 0
  let mut x = lo
  while x <= hi {
    s = s + (c2 * x + c1) * x + c0
    x = x + 1
  }
  s
}

comptime fn count_solutions(target: int, lim: int) -> int {
  // count pairs (a,b) with 1<=a<=b<=lim and a*a + b*b == target
  let mut c = 0
  let mut a = 1
  while a <= lim {
    let mut b = a
    while b <= lim {
      if a * a + b * b == target { c = c + 1 }
      b = b + 1
    }
    a = a + 1
  }
  c
}

// ----------------------------------------------------------------------------
// SECTION 9 — More number theory: digital root, modular exponentiation,
// triangular-row checksum, and a GCD-grid aggregate.
// ----------------------------------------------------------------------------

comptime fn digital_root(n: int) -> int {
  let mut m = n
  if m < 0 { m = 0 - m }
  while m >= 10 {
    let mut s = 0
    while m > 0 { s = s + (m % 10); m = m / 10 }
    m = s
  }
  m
}

comptime fn mod_pow(base: int, exp: int, modulus: int) -> int {
  if modulus == 1 { return 0 }
  let mut result = 1
  let mut b = base % modulus
  let mut e = exp
  while e > 0 {
    if e % 2 == 1 { result = (result * b) % modulus }
    e = e / 2
    b = (b * b) % modulus
  }
  result
}

comptime fn gcd_grid_sum(n: int) -> int {
  // sum of gcd(i,j) over 1<=i,j<=n
  let mut total = 0
  let mut i = 1
  while i <= n {
    let mut j = 1
    while j <= n {
      total = total + gcd(i, j)
      j = j + 1
    }
    i = i + 1
  }
  total
}

comptime fn pascal_row_sum(row: int) -> int {
  // sum of binomial coefficients in a Pascal row == 2^row
  let mut s = 0
  let mut k = 0
  while k <= row {
    s = s + choose(row, k)
    k = k + 1
  }
  s
}


