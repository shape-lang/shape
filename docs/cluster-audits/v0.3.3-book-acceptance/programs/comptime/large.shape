check_str("VERSION_nonempty_proxy", K_VERSION, K_VERSION) // run-only structural (host-dependent value)
check_str("OS_proxy",               K_OS,      K_OS)       // run-only structural (host-dependent value)

// ============================================================================
// SECTION 9 -- TELEMETRY PROCESSOR driven by comptime-baked constants
// A small deterministic pipeline: scale raw samples by a comptime conversion
// factor and reduce. Proves comptime constants flow into a runtime computation.
// ============================================================================

// Bake the Celsius->Fahrenheit slope as the exact IEEE-754 literal 1.8.
// (Deriving it via ct_c_to_f(1.0)-ct_c_to_f(0.0) == 33.8-32.0 introduces a
//  representable-subtraction rounding to 1.7999999999999972; the literal is exact.)
let SCALE_C_TO_F_SLOPE = comptime { 1.8 }              // exactly 1.8

fn process_samples(samples_c: Array<number>) -> number {
  let mut total = 0.0
  for c in samples_c {
    // convert each Celsius reading to Fahrenheit using the comptime slope+offset
    let f = c * SCALE_C_TO_F_SLOPE + 32.0
    total = total + f
  }
  total
}

// samples: [0, 10, 20, 30, 40] C -> F: [32,50,68,86,104] sum = 340.0
let SAMPLES = [0.0, 10.0, 20.0, 30.0, 40.0]
let TELEM_TOTAL = process_samples(SAMPLES)
check_num("TELEM_TOTAL", TELEM_TOTAL, 340.0)
check_num("SCALE_SLOPE", SCALE_C_TO_F_SLOPE, 1.8)

// ============================================================================
// SECTION 10 -- COMPTIME BOOLEAN PROOFS  (book: "Comptime Blocks" -- expression
// form "evaluate now, embed literal result").  Per book semantics a comptime
// block evaluating to `false` MUST embed the literal `false`.  Expected values
// derived from book + arithmetic, written before first run.
// ============================================================================

let B_TRUE   = comptime { true }          // expected true
let B_FALSE  = comptime { false }         // expected false
let B_LT     = comptime { 3 < 5 }         // expected true
let B_GT     = comptime { 3 > 5 }         // expected false
let B_EQ     = comptime { 2 + 2 == 4 }    // expected true
let B_NE     = comptime { 2 + 2 == 5 }    // expected false

check_bool("B_TRUE",  B_TRUE,  true)
check_bool("B_FALSE", B_FALSE, false)
check_bool("B_LT",    B_LT,    true)
check_bool("B_GT",    B_GT,    false)
check_bool("B_EQ",    B_EQ,    true)
check_bool("B_NE",    B_NE,    false)

// NOTE (defect, see REPORT.md): the comptime-baked `false` VALUE is correct for
// equality (the six checks above PASS), but f-string interpolation of a
// comptime-`false` renders `null` instead of `false`
// (e.g. `print(f"{B_FALSE}")` -> "null"; a runtime `false` -> "false").
// We therefore deliberately do NOT interpolate B_FALSE/B_GT/B_NE in the summary
// below; doing so would print "null" and is the language defect this slice found.

// ============================================================================
// SECTION 12 -- extended comptime number-theory lab (book: "comptime fn Helpers")
// More compile-time helpers + a second, larger proof battery.  Every constant
// is recomputed at runtime by a mirror fn and also checked against a literal
// expected value derived from arithmetic (written before first run).
// ============================================================================

comptime fn ct_modpow(base: int, exp: int, m: int) -> int {
  let mut result = 1
  let mut b = base % m
  let mut e = exp
  while e > 0 {
    if e % 2 == 1 {
      result = result * b % m
    }
    e = e / 2
    b = b * b % m
  }
  result
}

comptime fn ct_triangular(n: int) -> int { n * (n + 1) / 2 }

comptime fn ct_reverse_int(n: int) -> int {
  let mut x = n
  let mut r = 0
  while x > 0 {
    r = r * 10 + x % 10
    x = x / 10
  }
  r
}

comptime fn ct_sum_of_squares(n: int) -> int {
  let mut s = 0
  let mut i = 1
  while i <= n {
    s = s + i * i
    i = i + 1
  }
  s
}

comptime fn ct_num_divisors(n: int) -> int {
  let mut count = 0
  let mut i = 1
  while i <= n {
    if n % i == 0 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

comptime fn ct_int_sqrt(n: int) -> int {
  let mut r = 0
  while (r + 1) * (r + 1) <= n {
    r = r + 1
  }
  r
}

comptime fn ct_binomial(n: int, k: int) -> int {
  // C(n,k) via multiplicative formula (k <= n)
  let mut num = 1
  let mut den = 1
  let mut i = 0
  while i < k {
    num = num * (n - i)
    den = den * (i + 1)
    i = i + 1
  }
  num / den
}

// runtime mirrors
fn rt_modpow(base: int, exp: int, m: int) -> int {
  let mut result = 1
  let mut b = base % m
  let mut e = exp
  while e > 0 {
    if e % 2 == 1 {
      result = result * b % m
    }
    e = e / 2
    b = b * b % m
  }
  result
}
fn rt_triangular(n: int) -> int { n * (n + 1) / 2 }
fn rt_reverse_int(n: int) -> int {
  let mut x = n
  let mut r = 0
  while x > 0 {
    r = r * 10 + x % 10
    x = x / 10
  }
  r
}
fn rt_sum_of_squares(n: int) -> int {
  let mut s = 0
  let mut i = 1
  while i <= n {
    s = s + i * i
    i = i + 1
  }
  s
}
fn rt_num_divisors(n: int) -> int {
  let mut count = 0
  let mut i = 1
  while i <= n {
    if n % i == 0 {
      count = count + 1
    }
    i = i + 1
  }
  count
}
fn rt_int_sqrt(n: int) -> int {
  let mut r = 0
  while (r + 1) * (r + 1) <= n {
    r = r + 1
  }
  r
}
fn rt_binomial(n: int, k: int) -> int {
  let mut num = 1
  let mut den = 1
  let mut i = 0
  while i < k {
    num = num * (n - i)
    den = den * (i + 1)
    i = i + 1
  }
  num / den
}

// baked constants
let K_MODPOW   = comptime { ct_modpow(7, 13, 100) }      // 7^13 mod 100 = 7
let K_MODPOW2  = comptime { ct_modpow(3, 20, 1000) }     // 3^20 mod 1000 = 401
let K_TRI_100  = comptime { ct_triangular(100) }         // 5050
let K_TRI_50   = comptime { ct_triangular(50) }          // 1275
let K_REV      = comptime { ct_reverse_int(12345) }      // 54321
let K_REV2     = comptime { ct_reverse_int(1000) }       // 1
let K_SUMSQ    = comptime { ct_sum_of_squares(10) }      // 385
let K_DIVS_36  = comptime { ct_num_divisors(36) }        // 9
let K_DIVS_97  = comptime { ct_num_divisors(97) }        // 2 (prime)
let K_ISQRT    = comptime { ct_int_sqrt(1000) }          // 31
let K_ISQRT_16 = comptime { ct_int_sqrt(16) }            // 4
let K_BINOM    = comptime { ct_binomial(10, 3) }         // 120
let K_BINOM2   = comptime { ct_binomial(52, 5) }         // 2598960

// literal-expected checks
check_int("MODPOW_lit",   K_MODPOW,   7)
check_int("MODPOW2_lit",  K_MODPOW2,  401)
check_int("TRI_100_lit",  K_TRI_100,  5050)
check_int("TRI_50_lit",   K_TRI_50,   1275)
check_int("REV_lit",      K_REV,      54321)
check_int("REV2_lit",     K_REV2,     1)
check_int("SUMSQ_lit",    K_SUMSQ,    385)
check_int("DIVS_36_lit",  K_DIVS_36,  9)
check_int("DIVS_97_lit",  K_DIVS_97,  2)
check_int("ISQRT_lit",    K_ISQRT,    31)
check_int("ISQRT16_lit",  K_ISQRT_16, 4)
check_int("BINOM_lit",    K_BINOM,    120)
check_int("BINOM2_lit",   K_BINOM2,   2598960)

// comptime == runtime checks
check_int("MODPOW_rt",   K_MODPOW,   rt_modpow(7, 13, 100))
check_int("MODPOW2_rt",  K_MODPOW2,  rt_modpow(3, 20, 1000))
check_int("TRI_100_rt",  K_TRI_100,  rt_triangular(100))
check_int("TRI_50_rt",   K_TRI_50,   rt_triangular(50))
check_int("REV_rt",      K_REV,      rt_reverse_int(12345))
check_int("REV2_rt",     K_REV2,     rt_reverse_int(1000))
check_int("SUMSQ_rt",    K_SUMSQ,    rt_sum_of_squares(10))
check_int("DIVS_36_rt",  K_DIVS_36,  rt_num_divisors(36))
check_int("DIVS_97_rt",  K_DIVS_97,  rt_num_divisors(97))
check_int("ISQRT_rt",    K_ISQRT,    rt_int_sqrt(1000))
check_int("ISQRT16_rt",  K_ISQRT_16, rt_int_sqrt(16))
check_int("BINOM_rt",    K_BINOM,    rt_binomial(10, 3))
check_int("BINOM2_rt",   K_BINOM2,   rt_binomial(52, 5))

// ============================================================================
// SECTION 13 -- comptime-baked 3x3 linear-algebra constants
// A fixed rotation+scale matrix is computed at compile time; runtime applies it
// to fixture vectors and checks against literal expected outputs.
// ============================================================================

// 90-degree rotation about origin composed with uniform scale 2:
//   [ 0 -2 ] [x]   maps (1,0)->(0,2), (0,1)->(-2,0), (1,1)->(-2,2)
//   [ 2  0 ] [y]
let M00 = comptime { 0.0 }
let M01 = comptime { 0.0 - 2.0 }   // -2.0
let M10 = comptime { 1.0 + 1.0 }   //  2.0
let M11 = comptime { 0.0 }

// Apply the comptime-baked matrix component-wise (scalar returns: the array
// literal [nx, ny] from `number` locals currently infers Vec<unknown> and fails
// to unify with Array<number> -- an inference limitation unrelated to comptime).
fn mvx(x: number, y: number) -> number { M00 * x + M01 * y }
fn mvy(x: number, y: number) -> number { M10 * x + M11 * y }

check_num("V1x", mvx(1.0, 0.0), 0.0)
check_num("V1y", mvy(1.0, 0.0), 2.0)
check_num("V2x", mvx(0.0, 1.0), -2.0)
check_num("V2y", mvy(0.0, 1.0), 0.0)
check_num("V3x", mvx(1.0, 1.0), -2.0)
check_num("V3y", mvy(1.0, 1.0), 2.0)

// determinant of the comptime matrix = M00*M11 - M01*M10 = 0 - (-2*2) = 4
let DET = comptime { 0.0 * 0.0 - (0.0 - 2.0) * (1.0 + 1.0) }  // 4.0
check_num("DET", DET, 4.0)

// ============================================================================
// SECTION 14 -- comptime unit-table sanity (more physical conversions)
// ============================================================================

let K_C100_K  = comptime { ct_c_to_k(100.0) }     // 373.15
let K_MI_5K   = comptime { ct_km_to_mi(5.0) }     // 3.106855
let K_AREA_R1 = comptime { ct_circle_area(1.0) }  // pi
let K_HYP_512 = comptime { ct_hypot(5.0, 12.0) }  // 13.0

check_num("C100_K_lit",  K_C100_K,  373.15)
check_num("HYP_512_lit", K_HYP_512, 13.0)
check_num("C100_K_rt",   K_C100_K,  rt_c_to_k(100.0))
check_num("MI_5K_rt",    K_MI_5K,   rt_km_to_mi(5.0))
check_num("AREA_R1_rt",  K_AREA_R1, rt_circle_area(1.0))
check_num("HYP_512_rt",  K_HYP_512, rt_hypot(5.0, 12.0))

// ============================================================================
// SECTION 11 -- summary
// ============================================================================

print(f"FACT_5={K_FACT_5} FIB_20={K_FIB_20} PRIMES={K_PRIMES} SUMRNG={K_SUMRNG}")
print(f"BOIL_F={K_BOIL_F} HYP_345={K_HYP_345} URI={K_URI} FIELDS={K_FIELDS}")
print(f"VERSION={K_VERSION} OS={K_OS} TELEM_TOTAL={TELEM_TOTAL}")

if g_failures == 0 {
  print("ALL_CHECKS_PASSED")
} else {
  print(f"FAILURES={g_failures}")
}
