let K_LCM     = comptime { ct_lcm(4, 6) }               // 12
let K_DIGSUM  = comptime { ct_digit_sum(987654321) }    // 45
let K_COLLATZ = comptime { ct_collatz_len(27) }         // 111
let K_PRIMES  = comptime { ct_count_primes_below(100) } // 25
let K_POW     = comptime { ct_pow_int(2, 10) }          // 1024
