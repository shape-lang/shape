// ----------------------------------------------------------------------------
// SECTION 10 — Prime gaps, harmonic-style integer sums, and a rolling checksum.
// ----------------------------------------------------------------------------

comptime fn max_prime_gap_below(limit: int) -> int {
  // largest gap between consecutive primes p,q with q < limit
  let mut prev = 2
  let mut best = 0
  let mut k = 3
  while k < limit {
    if is_prime(k) {
      let gap = k - prev
      if gap > best { best = gap }
      prev = k
    }
    k = k + 1
  }
  best
}

comptime fn twin_prime_count_below(limit: int) -> int {
  // count primes p with p and p+2 both prime and p+2 < limit
  let mut c = 0
  let mut k = 3
  while k + 2 < limit {
    if is_prime(k) {
      if is_prime(k + 2) { c = c + 1 }
    }
    k = k + 1
  }
  c
}

comptime fn floor_sum_div(n: int) -> int {
  // sum over k=1..n of floor(n/k) == sum of number-of-divisors d(1..n)
  let mut s = 0
  let mut k = 1
  while k <= n { s = s + (n / k); k = k + 1 }
  s
}

comptime fn rolling_checksum(seed: int, rounds: int) -> int {
  // mix integer ops deterministically: a tiny non-cryptographic hash
  let mut h = seed
  let mut i = 1
  while i <= rounds {
    h = (h * 31 + i) % 1000003
    h = xor_int(h, (i * i) % 257)
    i = i + 1
  }
  h
}

// --- Section 10 comptime sites ---
let r_maxgap_100      = comptime { max_prime_gap_below(100) }   // recomputed at runtime
let r_twins_100       = comptime { twin_prime_count_below(100) } // recomputed at runtime
let r_floorsum_10     = comptime { floor_sum_div(10) }          // recomputed at runtime
let r_checksum        = comptime { rolling_checksum(7, 40) }    // recomputed at runtime


// ============================================================================
// RUNTIME RECOMPUTATION HELPERS — ordinary fn (not comptime). These re-derive
// the same values at runtime so we can assert comptime-baked == straightforward
// evaluation for the long sequences (instead of hand-tabulating them).
// ============================================================================

fn rt_is_palindrome(n: int) -> bool {
  let mut m = n
  let mut r = 0
  while m > 0 { r = r * 10 + (m % 10); m = m / 10 }
  n == r
}
fn rt_collatz_steps(n: int) -> int {
  let mut m = n
  let mut steps = 0
  while m != 1 {
    if m % 2 == 0 { m = m / 2 } else { m = 3 * m + 1 }
    steps = steps + 1
  }
  steps
}
fn rt_fib(n: int) -> int {
  let mut a = 0
  let mut b = 1
  let mut i = 0
  while i < n { let t = a + b; a = b; b = t; i = i + 1 }
  a
}
fn rt_xor_int(a: int, b: int) -> int {
  let mut x = a
  let mut y = b
  let mut bit = 1
  let mut result = 0
  while x > 0 {
    let ax = x % 2
    let by = y % 2
    if ax != by { result = result + bit }
    x = x / 2
    y = y / 2
    bit = bit * 2
  }
  while y > 0 {
    if y % 2 == 1 { result = result + bit }
    y = y / 2
    bit = bit * 2
  }
  result
}
fn rt_lcg_next(state: int) -> int {
  let m = 2147483648
  let mut v = (1664525 * state + 1013904223) % m
  if v < 0 { v = v + m }
  v
}
fn rt_lcg_nth(seed: int, n: int) -> int {
  let mut s = seed
  let mut i = 0
  while i < n { s = rt_lcg_next(s); i = i + 1 }
  s
}
fn rt_lcg_sum_mod(seed: int, count: int, modulus: int) -> int {
  let mut s = seed
  let mut acc = 0
  let mut i = 0
  while i < count {
    s = rt_lcg_next(s)
    acc = (acc + (s % modulus)) % modulus
    i = i + 1
  }
  acc
}
fn rt_mod_pow(base: int, exp: int, modulus: int) -> int {
  if modulus == 1 { return 0 }
  let mut result = 1
  let mut b = base % modulus
  let mut e = exp
  while e > 0 {
    if e % 2 == 1 { result = (result * b) % modulus }
    e = e / 2
    b = (b * b) % modulus
  }
  result
}
fn rt_gcd(a: int, b: int) -> int {
  let mut x = a
  let mut y = b
  if x < 0 { x = 0 - x }
  if y < 0 { y = 0 - y }
  while y != 0 { let t = y; y = x % y; x = t }
  x
}
fn rt_gcd_grid_sum(n: int) -> int {
  let mut total = 0
  let mut i = 1
  while i <= n {
    let mut j = 1
    while j <= n { total = total + rt_gcd(i, j); j = j + 1 }
    i = i + 1
  }
  total
}
fn rt_is_prime(n: int) -> bool {
  if n < 2 { return false }
  if n == 2 { return true }
  if n % 2 == 0 { return false }
  let mut i = 3
  while i * i <= n {
    if n % i == 0 { return false }
    i = i + 2
  }
  true
}
fn rt_max_prime_gap_below(limit: int) -> int {
  let mut prev = 2
  let mut best = 0
  let mut k = 3
  while k < limit {
    if rt_is_prime(k) {
      let gap = k - prev
      if gap > best { best = gap }
      prev = k
    }
    k = k + 1
  }
  best
}
fn rt_twin_prime_count_below(limit: int) -> int {
  let mut c = 0
  let mut k = 3
  while k + 2 < limit {
    if rt_is_prime(k) {
      if rt_is_prime(k + 2) { c = c + 1 }
    }
    k = k + 1
  }
  c
}
fn rt_floor_sum_div(n: int) -> int {
  let mut s = 0
  let mut k = 1
  while k <= n { s = s + (n / k); k = k + 1 }
  s
}
