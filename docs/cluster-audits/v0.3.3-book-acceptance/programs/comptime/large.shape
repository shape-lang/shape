// large.shape -- Compile-Time Engineering Toolkit & Telemetry Processor
// Slice: comptime  (book: advanced/comptime.mdx)
//
// REAL-WORLD APP: a non-interactive engineering toolkit whose lookup tables,
// physical constants, conversion factors, and configuration are all computed
// AT COMPILE TIME via `comptime { ... }` blocks and `comptime fn` helpers, then
// consumed by a runtime engine that INDEPENDENTLY RECOMPUTES each value at run
// time and proves the compile-time-baked literal equals the runtime result.
//
// MACHINE-PROOF STRATEGY:
//   For every comptime constant C, a runtime function rt_*() recomputes the same
//   quantity. The harness checks  C == rt_*()  AND  C == <literal expected>.
//   Every <literal expected> below is derived from BOOK SEMANTICS + standard
//   mathematics and was written BEFORE the first run (never back-filled).
//
// Book sections exercised:
//   - "Comptime Blocks" (expression form: evaluate now, embed literal result)
//   - "comptime fn Helpers" (module-scope compile-time helpers, composition)
//   - "Comptime Scope Rules" (comptime owns its compile-time environment)
//   - "Comptime Builtins" (build_config() live in v0.3.3)
//   - "Comptime Fields on Types"
//   - "Top-level side-effect form" (warning())
//
// Determinism: PURE. No I/O, no time, no random, no network. Every value is a
// compile-time constant or a deterministic recomputation of one.

// ============================================================================
// SECTION 0 -- top-level comptime side effect (book: "Top-level side-effect form")
// ============================================================================
comptime {
  warning("building Compile-Time Engineering Toolkit")
}

// ============================================================================
// SECTION 1 -- comptime number-theory helpers (book: "comptime fn Helpers")
// ============================================================================

comptime fn ct_factorial(n: int) -> int {
  let mut acc = 1
  let mut i = 1
  while i <= n {
    acc = acc * i
    i = i + 1
  }
  acc
}

comptime fn ct_fib(n: int) -> int {
  let mut a = 0
  let mut b = 1
  let mut i = 0
  while i < n {
    let t = a + b
    a = b
    b = t
    i = i + 1
  }
  a
}

comptime fn ct_gcd(a: int, b: int) -> int {
  let mut x = a
  let mut y = b
  while y != 0 {
    let t = y
    y = x % y
    x = t
  }
  x
}

comptime fn ct_lcm(a: int, b: int) -> int {
  a / ct_gcd(a, b) * b
}

comptime fn ct_digit_sum(n: int) -> int {
  let mut x = n
  let mut s = 0
  while x > 0 {
    s = s + x % 10
    x = x / 10
  }
  s
}

comptime fn ct_collatz_len(n: int) -> int {
  let mut x = n
  let mut steps = 0
  while x > 1 {
    if x % 2 == 0 {
      x = x / 2
    } else {
      x = 3 * x + 1
    }
    steps = steps + 1
  }
  steps
}

comptime fn ct_count_primes_below(limit: int) -> int {
  let mut count = 0
  let mut k = 2
  while k < limit {
    // fall-through bool only; mutate a flag (avoids comptime-fn return paths)
    let mut prime = true
    let mut d = 2
    while d * d <= k {
      if k % d == 0 {
        prime = false
      }
      d = d + 1
    }
    if prime {
      count = count + 1
    }
    k = k + 1
  }
  count
}

comptime fn ct_pow_int(base: int, exp: int) -> int {
  let mut acc = 1
  let mut i = 0
  while i < exp {
    acc = acc * base
    i = i + 1
  }
  acc
}

comptime fn ct_sum_range(lo: int, hi: int) -> int {
  let mut s = 0
  let mut i = lo
  while i <= hi {
    s = s + i
    i = i + 1
  }
  s
}

// ============================================================================
// SECTION 2 -- comptime physical / unit constants (book: "comptime fn Helpers")
// ============================================================================

comptime fn ct_c_to_f(c: number) -> number { c * 1.8 + 32.0 }
comptime fn ct_c_to_k(c: number) -> number { c + 273.15 }
comptime fn ct_km_to_mi(km: number) -> number { km * 0.621371 }
comptime fn ct_kg_to_lb(kg: number) -> number { kg * 2.2046226218 }
comptime fn ct_circle_area(r: number) -> number { 3.141592653589793 * r * r }
comptime fn ct_hypot(a: number, b: number) -> number { sqrt(a * a + b * b) }

// ============================================================================
// SECTION 3 -- comptime string normalization (book: "comptime fn Helpers")
// ============================================================================

comptime fn ct_normalize_uri(uri: string) -> string { uri.trim() }

comptime fn ct_upper_len(s: string) -> int { s.toUpperCase().length() }

comptime fn ct_field_count(csv: string) -> int { csv.split(",").length() }

// polynomial hash over string length and a fixed seed walk (deterministic, no
// char access methods needed -- charCodeAt/toInt are absent in v0.3.3)
comptime fn ct_len_hash(s: string) -> int {
  let n = s.length()
  let mut h = 2166136261
  let mut i = 0
  while i < n {
    h = (h * 16777619 + i + 7) % 1000000007
    i = i + 1
  }
  h
}

// ============================================================================
// SECTION 4 -- comptime fields on types (book: "Comptime Fields on Types")
// ============================================================================

type Unit {
  comptime symbol: string = "m"
  comptime precision: int = 2
  value: number
}

type Celsius = Unit { symbol: "degC" }

