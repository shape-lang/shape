// DateTime slice — small program. Exercises construction, component access,
// day-info, formatting, timezone conversion, arithmetic, comparisons.
// Deterministic: all inputs are fixed (no now()/utc()/to_local()).
from std::core::intrinsics use { DateTime }

fn check_int(name: string, got: int, expected: int) {
    if got != expected {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}
fn check_str(name: string, got: string, expected: string) {
    if got != expected {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}
fn check_bool(name: string, got: bool, expected: bool) {
    if got != expected {
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}

// --- Construction + component access (book: Component Access table) ---
let dt = DateTime.parse("2024-06-15T14:30:45+00:00")
check_int("year", dt.year(), 2024)
check_int("month", dt.month(), 6)
check_int("day", dt.day(), 15)
check_int("hour", dt.hour(), 14)
check_int("minute", dt.minute(), 30)
check_int("second", dt.second(), 45)

// --- from_epoch (book: From Epoch, 1705314600000 -> 2024-01-15T10:30:00) ---
let e = DateTime.from_epoch(1705314600000)
check_str("from_epoch.iso", e.iso8601(), "2024-01-15T10:30:00+00:00")

// --- Day info (book: Day Information, 2024-01-06 is Saturday) ---
let sat = DateTime.parse("2024-01-06T12:00:00+00:00")
check_int("day_of_week", sat.day_of_week(), 5)
check_bool("is_weekend", sat.is_weekend(), true)
check_bool("is_weekday", sat.is_weekday(), false)
check_int("day_of_year", sat.day_of_year(), 6)
check_int("week_of_year", sat.week_of_year(), 1)

// --- Formatting (book: Formatting section) ---
check_str("fmt.slash", dt.format("%Y/%m/%d %H:%M"), "2024/06/15 14:30")
check_str("fmt.month", dt.format("%B %d, %Y"), "June 15, 2024")
check_str("fmt.weekday", dt.format("%A"), "Saturday")
check_str("iso8601", dt.iso8601(), "2024-06-15T14:30:45+00:00")
check_int("unix_ts", dt.unix_timestamp(), 1718461845)

// --- Timezone (book: Converting Between Timezones) ---
let nyc = dt.to_timezone("America/New_York")
check_int("nyc.hour", nyc.hour(), 10)    // 14:30 UTC -> 10:30 EDT (UTC-4)
check_int("back.hour", nyc.to_utc().hour(), 14)
let ist = DateTime.parse("2024-01-15T10:00:00+05:30")
check_str("timezone", ist.timezone(), "UTC+5:30")
check_str("offset", ist.offset(), "+05:30")

// --- Arithmetic (book: add_* methods + month clamping) ---
let base = DateTime.parse("2024-01-30T12:00:00+00:00")
check_int("add_days", base.add_days(1).day(), 31)
check_int("add_hours", base.add_hours(5).hour(), 17)
let jan31 = DateTime.parse("2024-01-31T00:00:00+00:00")
check_int("add_months.clamp", jan31.add_months(1).day(), 29)  // 2024 leap year

// --- Operator arithmetic + literals (book: Operator Arithmetic) ---
let a = DateTime.parse("2024-06-15T12:00:00+00:00")
check_int("plus3d", (a + 3d).day(), 18)
check_int("minus1w", (a - 1w).day(), 8)
let future = @"2024-06-15" + 30d - 1w
check_str("lit.arith", future.format("%Y-%m-%d"), "2024-07-08")

// --- Comparisons (book: Comparisons) ---
let morning = DateTime.parse("2024-03-15T08:00:00+00:00")
let evening = DateTime.parse("2024-03-15T22:30:00+00:00")
check_bool("is_before", morning.is_before(evening), true)
check_bool("is_after", evening.is_after(morning), true)
check_bool("is_same_day", morning.is_same_day(evening), true)

print("ALL_CHECKS_PASSED")
