from std::core::intrinsics use { DateTime }

// Literal
let date = @"2024-01-15"
print(date.year())

// from_epoch
let ep = DateTime.from_epoch(1705314600000)
print(ep.iso8601())

// day info on a Saturday 2024-01-06
let sat = DateTime.parse("2024-01-06T12:00:00+00:00")
print(sat.day_of_week())
print(sat.is_weekend())
print(sat.is_weekday())
print(sat.day_of_year())
print(sat.week_of_year())

// arithmetic add_*
let dt = DateTime.parse("2024-01-30T12:00:00+00:00")
print(dt.add_days(1).day())
print(dt.add_hours(5).hour())
print(dt.add_minutes(45).minute())
print(dt.add_seconds(30).second())

// add_months clamp
let jan31 = DateTime.parse("2024-01-31T00:00:00+00:00")
print(jan31.add_months(1).day())

// timezone
let utc_time = DateTime.parse("2024-06-15T12:00:00+00:00")
let nyc = utc_time.to_timezone("America/New_York")
print(nyc.hour())
print(nyc.to_utc().hour())

// timezone inspect
let off = DateTime.parse("2024-01-15T10:00:00+05:30")
print(off.timezone())
print(off.offset())

// comparisons
let morning = DateTime.parse("2024-03-15T08:00:00+00:00")
let evening = DateTime.parse("2024-03-15T22:30:00+00:00")
print(morning.is_before(evening))
print(evening.is_after(morning))
print(morning.is_same_day(evening))
