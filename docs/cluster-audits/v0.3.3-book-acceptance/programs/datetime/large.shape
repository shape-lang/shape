calendar_tests()
recurring_tests()
sla_tests()
tz_tests()
timesheet_tests()
formatting_tests()
months_tests()
comparison_tests()
fiscal_tests()
holiday_tests()
conflict_tests()
standup_report_tests()
payroll_tests()
elapsed_tests()

print(f"TOTAL_CHECKS={total}")
if failed == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"FAILURES={failed}")
}
