// =============================================================================
// large.shape — Calendar & Scheduling Engine (DateTime slice)
//
// A non-interactive, deterministic, machine-proofable application that exercises
// the DateTime chapter end-to-end: construction (parse / from_epoch / literals),
// component access, day-info, formatting, timezone conversion, arithmetic
// (add_* + operator + duration), and comparisons.
//
// All inputs are FIXED datetimes — no now()/utc()/to_local(). Every computed
// result is asserted against an EXPECTED value derived from book semantics
// (written BEFORE first run). On all-pass: "ALL_CHECKS_PASSED".
//
// NOTE (verified BOOK-GAP, not a defect): under this strict-typing build an
// array literal whose elements are `DateTime` values fails element-type
// inference — `let a: Array<DateTime> = [dt]` errors with "cannot infer the
// element type of this array literal" even WITH the annotation. The book never
// claims DateTime arrays work (its Date-Range example collects Array<string>),
// so this is a documentation gap, not a contradiction. The engine therefore
// stores schedule entries as epoch-millisecond `int`s and formatted `string`s
// — reconstructing DateTimes on demand via `DateTime.from_epoch`. (Scalar int
// methods like unix_timestamp() on DateTime PARAMS propagate fine — verified.)
// =============================================================================
from std::core::intrinsics use { DateTime }

// ----------------------------------------------------------------------------
// Assertion helpers — print CHECK_FAILED on mismatch, track a global failure.
// ----------------------------------------------------------------------------
let mut FAILS: int = 0

fn ck_int(name: string, got: int, expected: int) {
    if got != expected {
        FAILS = FAILS + 1
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}
fn ck_str(name: string, got: string, expected: string) {
    if got != expected {
        FAILS = FAILS + 1
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}
fn ck_bool(name: string, got: bool, expected: bool) {
    if got != expected {
        FAILS = FAILS + 1
        print(f"CHECK_FAILED: {name} expected={expected} got={got}")
    }
}

// ----------------------------------------------------------------------------
// Domain helpers
// ----------------------------------------------------------------------------

// Next business day strictly AFTER `d` (skips Sat/Sun). Book: is_weekend, add_days.
fn next_business_day(d: DateTime) -> DateTime {
    let mut cur = d.add_days(1)
    while cur.is_weekend() {
        cur = cur.add_days(1)
    }
    cur
}

// Count weekdays in the inclusive range [start, end]. Book: is_weekday, add_days,
// is_before / is_same_day (Date Range Iteration example).
fn count_weekdays(start: DateTime, end: DateTime) -> int {
    let mut current = start
    let mut n = 0
    while current.is_before(end) or current.is_same_day(end) {
        if current.is_weekday() {
            n = n + 1
        }
        current = current.add_days(1)
    }
    n
}

// Whole days between two DateTimes via their unix_timestamp seconds.
// Book: unix_timestamp() returns int seconds since epoch.
fn days_between(a: DateTime, b: DateTime) -> int {
    (b.unix_timestamp() - a.unix_timestamp()) / 86400
}

// Add N business days to a date (skips weekends), returning the landing date.
fn add_business_days(d: DateTime, n: int) -> DateTime {
    let mut cur = d
    let mut left = n
    while left > 0 {
        cur = next_business_day(cur)
        left = left - 1
    }
    cur
}

// Reconstruct a DateTime from stored epoch milliseconds. Book: from_epoch.
fn at(ms: int) -> DateTime {
    DateTime.from_epoch(ms)
}

// ============================================================================
// SECTION 1 — Construction & component access
// ============================================================================
fn section_construction() {
    let dt = DateTime.parse("2024-06-15T14:30:45+00:00")
    ck_int("ctor.year", dt.year(), 2024)
    ck_int("ctor.month", dt.month(), 6)
    ck_int("ctor.day", dt.day(), 15)
    ck_int("ctor.hour", dt.hour(), 14)
    ck_int("ctor.minute", dt.minute(), 30)
    ck_int("ctor.second", dt.second(), 45)
    ck_int("ctor.ms", dt.millisecond(), 0)
    ck_int("ctor.us", dt.microsecond(), 0)

    // Parse variants (book: Parsing Strings table). No-tz defaults to UTC.
    let a = DateTime.parse("2024-01-15 10:30:00")
    ck_int("parse.dt.year", a.year(), 2024)
    ck_int("parse.dt.hour", a.hour(), 10)
    ck_int("parse.dt.minute", a.minute(), 30)
    let b = DateTime.parse("2024-01-15")
    ck_int("parse.dateonly.day", b.day(), 15)
    ck_int("parse.dateonly.hour", b.hour(), 0)

    // from_epoch (book: 1705314600000 -> 2024-01-15T10:30:00+00:00)
    let e = at(1705314600000)
    ck_str("epoch.iso", e.iso8601(), "2024-01-15T10:30:00+00:00")
    ck_int("epoch.unix", e.unix_timestamp(), 1705314600)

    // DateTime literal (book: DateTime Literals)
    let lit = @"2024-01-15"
    ck_str("literal.fmt", lit.format("%Y-%m-%d"), "2024-01-15")
}

// ============================================================================
// SECTION 2 — Day information across a full known week
//   2024-01-01 is a Monday (verified). dow: 0=Mon..6=Sun.
// ============================================================================
fn section_dayinfo() {
    // Expected dow for Jan 1..7 2024: Mon..Sun -> 0,1,2,3,4,5,6
    let monday = DateTime.parse("2024-01-01T12:00:00+00:00")
    ck_int("dow.mon", monday.day_of_week(), 0)
    ck_bool("wend.mon", monday.is_weekend(), false)
    ck_bool("wday.mon", monday.is_weekday(), true)
    ck_int("doy.jan1", monday.day_of_year(), 1)

    let sat = DateTime.parse("2024-01-06T12:00:00+00:00")
    ck_int("dow.sat", sat.day_of_week(), 5)
    ck_bool("wend.sat", sat.is_weekend(), true)
    ck_bool("wday.sat", sat.is_weekday(), false)
    ck_int("doy.jan6", sat.day_of_year(), 6)
    ck_int("woy.jan6", sat.week_of_year(), 1)

    let sun = DateTime.parse("2024-01-07T12:00:00+00:00")
    ck_int("dow.sun", sun.day_of_week(), 6)
    ck_bool("wend.sun", sun.is_weekend(), true)

    // Leap-year day-of-year: 2024-12-31 is the 366th day.
    let last = DateTime.parse("2024-12-31T00:00:00+00:00")
    ck_int("doy.dec31.leap", last.day_of_year(), 366)
}

// ============================================================================
// SECTION 3 — Formatting
// ============================================================================
fn section_formatting() {
    let dt = DateTime.parse("2024-06-15T14:30:45+00:00")
    ck_str("fmt.slash", dt.format("%Y/%m/%d %H:%M"), "2024/06/15 14:30")
    ck_str("fmt.long", dt.format("%B %d, %Y"), "June 15, 2024")
    ck_str("fmt.weekday", dt.format("%A"), "Saturday")
    ck_str("fmt.combo", dt.format("%B %d, %Y at %H:%M"), "June 15, 2024 at 14:30")
    ck_str("fmt.tz", dt.format("%Z"), "UTC")
    ck_str("fmt.offset", dt.format("%z"), "+0000")
    ck_str("iso8601", dt.iso8601(), "2024-06-15T14:30:45+00:00")
    ck_str("rfc2822", dt.rfc2822(), "Sat, 15 Jun 2024 14:30:45 +0000")
    ck_int("unix", dt.unix_timestamp(), 1718461845)

    // A January date: %A is Monday for 2024-01-15.
    let jan = DateTime.parse("2024-01-15T10:30:00+00:00")
    ck_str("fmt.jan.weekday", jan.format("%A"), "Monday")
    ck_str("fmt.jan.month", jan.format("%B"), "January")
}

// ============================================================================
// SECTION 4 — Timezone conversion
//   Book: 2024-06-15T12:00 UTC -> NYC 08:00 (EDT, UTC-4); 09:00 ET -> Tokyo 22:00.
// ============================================================================
fn section_timezone() {
    let utc_noon = DateTime.parse("2024-06-15T12:00:00+00:00")
    let nyc = utc_noon.to_timezone("America/New_York")
    ck_int("tz.nyc.hour", nyc.hour(), 8)          // UTC-4 in June (EDT)
    ck_int("tz.nyc.back", nyc.to_utc().hour(), 12)

    let tokyo = utc_noon.to_timezone("Asia/Tokyo")
    ck_int("tz.tokyo.hour", tokyo.hour(), 21)     // UTC+9

    // Book business-hours example: 09:00-04:00 -> Tokyo 22:00.
    let et_open = DateTime.parse("2024-06-15T09:00:00-04:00")
    ck_str("tz.office.tokyo", et_open.to_timezone("Asia/Tokyo").format("%H:%M"), "22:00")

    // timezone() / offset() (book: Inspecting Timezone Info)
    let ist = DateTime.parse("2024-01-15T10:00:00+05:30")
    ck_str("tz.name", ist.timezone(), "UTC+5:30")
    ck_str("tz.offset", ist.offset(), "+05:30")

    let utc_dt = DateTime.parse("2024-06-15T12:00:00+00:00")
    ck_str("tz.utc.name", utc_dt.timezone(), "UTC")
    ck_str("tz.utc.offset", utc_dt.offset(), "+00:00")

    // is_same_day differs across tz at same instant (book example):
    // 23:00 EST -> 04:00 UTC next day.
    let est = DateTime.parse("2024-03-15T23:00:00-05:00")
    ck_bool("tz.sameday.cross", est.is_same_day(est.to_utc()), false)
}

// ============================================================================
// SECTION 5 — Arithmetic (add_* + month clamping + operators + duration)
// ============================================================================
fn section_arithmetic() {
    let base = DateTime.parse("2024-01-30T12:00:00+00:00")
    ck_int("add.days", base.add_days(1).day(), 31)
    ck_int("add.hours", base.add_hours(5).hour(), 17)
    ck_int("add.minutes", base.add_minutes(45).minute(), 45)  // base minute=0 (12:00:00) + 45 -> 45
    ck_int("add.seconds", base.add_seconds(30).second(), 30)

    // Negative shifts move backward.
    ck_str("add.days.neg", DateTime.parse("2024-03-01T00:00:00+00:00").add_days(-1).format("%Y-%m-%d"), "2024-02-29")

    // Month clamping (book: Jan 31 + 1 month -> Feb 29 in leap year).
    let jan31 = DateTime.parse("2024-01-31T00:00:00+00:00")
    let feb = jan31.add_months(1)
    ck_int("add.months.clamp", feb.day(), 29)
    ck_int("add.months.clamp2", feb.add_months(1).day(), 29)  // -> Mar 29

    // Month add crossing year boundary, with clamp: Nov 30 + 3 -> Feb 28 2025.
    let nov = DateTime.parse("2024-11-30T00:00:00+00:00")
    ck_str("add.months.year", nov.add_months(3).format("%Y-%m-%d"), "2025-02-28")

    // Operator arithmetic with duration suffixes (book: Operator Arithmetic).
    let a = DateTime.parse("2024-06-15T12:00:00+00:00")
    ck_int("op.plus3d", (a + 3d).day(), 18)
    ck_int("op.minus1w", (a - 1w).day(), 8)

    // Literal arithmetic chain: 2024-06-15 + 30d - 1w = 2024-07-08.
    let chain = @"2024-06-15" + 30d - 1w
    ck_str("op.literal.chain", chain.format("%Y-%m-%d"), "2024-07-08")

    // DateTime - DateTime -> Duration; ISO-8601 string form PT<seconds>S.
    let d1 = DateTime.parse("2024-06-10T12:00:00+00:00")
    let d2 = DateTime.parse("2024-06-15T12:00:00+00:00")
    let diff = d2 - d1
    ck_str("op.duration", f"{diff}", "PT432000S")  // 5 days = 432000 s
}

// ============================================================================
// SECTION 6 — Comparisons
// ============================================================================
fn section_comparisons() {
    let morning = DateTime.parse("2024-03-15T08:00:00+00:00")
    let evening = DateTime.parse("2024-03-15T22:30:00+00:00")
    ck_bool("cmp.before", morning.is_before(evening), true)
    ck_bool("cmp.after", evening.is_after(morning), true)
    ck_bool("cmp.sameday", morning.is_same_day(evening), true)
    ck_bool("cmp.notbefore", evening.is_before(morning), false)

    let next = DateTime.parse("2024-03-16T08:00:00+00:00")
    ck_bool("cmp.diffday", morning.is_same_day(next), false)
    ck_bool("cmp.before.day", morning.is_before(next), true)
}

// ============================================================================
// SECTION 7 — Business-day calculator (helpers above)
// ============================================================================
fn section_business_days() {
    // 2024-06-14 is Friday -> next business day = Monday 2024-06-17.
    let fri = DateTime.parse("2024-06-14T00:00:00+00:00")
    ck_str("biz.nextfri", next_business_day(fri).format("%Y-%m-%d"), "2024-06-17")

    // Mon -> Tue.
    let mon = DateTime.parse("2024-06-17T00:00:00+00:00")
    ck_str("biz.nextmon", next_business_day(mon).format("%Y-%m-%d"), "2024-06-18")

    // Add 5 business days to Mon 2024-06-17 -> Mon 2024-06-24 (skips Sat/Sun).
    ck_str("biz.add5", add_business_days(mon, 5).format("%Y-%m-%d"), "2024-06-24")

    // Add 1 business day to Friday 2024-06-14 -> Monday 2024-06-17.
    ck_str("biz.add1fri", add_business_days(fri, 1).format("%Y-%m-%d"), "2024-06-17")

    // Weekdays in January 2024 (inclusive 01-01..01-31) = 23 (verified).
    let jstart = DateTime.parse("2024-01-01T00:00:00+00:00")
    let jend = DateTime.parse("2024-01-31T00:00:00+00:00")
    ck_int("biz.jan.weekdays", count_weekdays(jstart, jend), 23)

    // Weekdays in a single Mon-Fri week (06-17..06-21) = 5.
    let wkstart = DateTime.parse("2024-06-17T00:00:00+00:00")
    let wkend = DateTime.parse("2024-06-21T00:00:00+00:00")
    ck_int("biz.week.weekdays", count_weekdays(wkstart, wkend), 5)

    // days_between: 2024-06-10 .. 2024-06-15 = 5 days.
    let d_a = DateTime.parse("2024-06-10T12:00:00+00:00")
    let d_b = DateTime.parse("2024-06-15T12:00:00+00:00")
    ck_int("biz.daysbetween", days_between(d_a, d_b), 5)
}

// ============================================================================
// SECTION 8 — Recurring-meeting schedule expansion (weekly standup)
//   Generate a weekly Monday 09:00 UTC standup for 6 occurrences starting
//   2024-06-03 (a Monday). Store ISO strings (string array) and verify each.
//   Expected Mondays: 06-03, 06-10, 06-17, 06-24, 07-01, 07-08.
// ============================================================================
fn section_recurrence() {
    let mut occ: Array<string> = []
    let mut cur = DateTime.parse("2024-06-03T09:00:00+00:00")
    let mut i = 0
    while i < 6 {
        occ = occ + [cur.format("%Y-%m-%d")]
        cur = cur.add_days(7)
        i = i + 1
    }
    ck_int("rec.count", occ.length(), 6)
    ck_str("rec.0", occ[0], "2024-06-03")
    ck_str("rec.1", occ[1], "2024-06-10")
    ck_str("rec.2", occ[2], "2024-06-17")
    ck_str("rec.3", occ[3], "2024-06-24")
    ck_str("rec.4", occ[4], "2024-07-01")
    ck_str("rec.5", occ[5], "2024-07-08")

    // Verify all generated occurrences are Mondays (dow 0).
    let mut chk = DateTime.parse("2024-06-03T09:00:00+00:00")
    let mut j = 0
    let mut allmon = true
    while j < 6 {
        if chk.day_of_week() != 0 {
            allmon = false
        }
        chk = chk.add_days(7)
        j = j + 1
    }
    ck_bool("rec.allmondays", allmon, true)

    // Monthly recurrence via add_months from Jan 31 — clamp behavior chain.
    // Jan31 -> Feb29 -> Mar29 -> Apr29 -> May29.
    let mut m = DateTime.parse("2024-01-31T00:00:00+00:00")
    let mut mdays: Array<int> = []
    let mut mi = 0
    while mi < 4 {
        m = m.add_months(1)
        mdays = mdays + [m.day()]
        mi = mi + 1
    }
    ck_int("rec.month.0", mdays[0], 29)  // Feb 29
    ck_int("rec.month.1", mdays[1], 29)  // Mar 29
    ck_int("rec.month.2", mdays[2], 29)  // Apr 29
    ck_int("rec.month.3", mdays[3], 29)  // May 29
}

// ============================================================================
// SECTION 9 — Multi-timezone meeting board
//   A 2024-06-15 12:00 UTC meeting shown in three IANA zones.
//   NY (EDT, UTC-4) = 08:00 ; London (BST, UTC+1) = 13:00 ; Tokyo (UTC+9)=21:00.
//   Store "zone=HH:MM" strings and assert.
// ============================================================================
fn section_tz_board() {
    let meeting = DateTime.parse("2024-06-15T12:00:00+00:00")
    let ny = meeting.to_timezone("America/New_York").format("%H:%M")
    let lon = meeting.to_timezone("Europe/London").format("%H:%M")
    let tky = meeting.to_timezone("Asia/Tokyo").format("%H:%M")
    ck_str("board.ny", ny, "08:00")
    ck_str("board.lon", lon, "13:00")
    ck_str("board.tky", tky, "21:00")

    // Build a single report string and verify it (string interpolation).
    let report = f"NY {ny} | London {lon} | Tokyo {tky}"
    ck_str("board.report", report, "NY 08:00 | London 13:00 | Tokyo 21:00")

    // Round-trip: convert to Tokyo then back to UTC keeps the instant.
    let rt = meeting.to_timezone("Asia/Tokyo").to_utc()
    ck_int("board.rt.hour", rt.hour(), 12)
    ck_int("board.rt.day", rt.day(), 15)
}

// ============================================================================
// SECTION 10 — Timesheet aggregator
//   Three work sessions on 2024-06-17 (Mon). Each is (start_iso, end_iso).
//   Sum durations via unix_timestamp seconds. Expected total = 8h = 28800s.
//   Sessions: 09:00-12:00 (3h), 13:00-17:00 (4h), 17:00-18:00 (1h).
// ============================================================================
fn section_timesheet() {
    let s1 = DateTime.parse("2024-06-17T09:00:00+00:00").unix_timestamp()
    let e1 = DateTime.parse("2024-06-17T12:00:00+00:00").unix_timestamp()
    let s2 = DateTime.parse("2024-06-17T13:00:00+00:00").unix_timestamp()
    let e2 = DateTime.parse("2024-06-17T17:00:00+00:00").unix_timestamp()
    let s3 = DateTime.parse("2024-06-17T17:00:00+00:00").unix_timestamp()
    let e3 = DateTime.parse("2024-06-17T18:00:00+00:00").unix_timestamp()

    let total = (e1 - s1) + (e2 - s2) + (e3 - s3)
    ck_int("ts.total.secs", total, 28800)
    ck_int("ts.total.hours", total / 3600, 8)
    ck_int("ts.seg1", (e1 - s1) / 3600, 3)
    ck_int("ts.seg2", (e2 - s2) / 3600, 4)
    ck_int("ts.seg3", (e3 - s3) / 3600, 1)

    // Store per-segment seconds in an int array and re-sum to cross-check.
    let mut segs: Array<int> = []
    segs = segs + [e1 - s1]
    segs = segs + [e2 - s2]
    segs = segs + [e3 - s3]
    let mut acc = 0
    let mut i = 0
    while i < segs.length() {
        acc = acc + segs[i]
        i = i + 1
    }
    ck_int("ts.resum", acc, 28800)

    // The work day is a weekday (Monday).
    let day = DateTime.parse("2024-06-17T09:00:00+00:00")
    ck_bool("ts.isweekday", day.is_weekday(), true)
    ck_int("ts.dow", day.day_of_week(), 0)
}

// ============================================================================
// SECTION 11 — Epoch round-trip ledger
//   Store events as epoch-ms ints (array), reconstruct via from_epoch, verify
//   ordering and formatting. This validates the array-storage workaround for
//   the DateTime-as-element constraint.
// ============================================================================
fn section_epoch_ledger() {
    // 2024-01-15T10:30:00Z = 1705314600000 ms (book value). One day later:
    // +86400000 ms. Two days later: +172800000 ms.
    let mut ledger: Array<int> = []
    ledger = ledger + [1705314600000]
    ledger = ledger + [1705314600000 + 86400000]
    ledger = ledger + [1705314600000 + 172800000]

    ck_int("ledger.len", ledger.length(), 3)
    ck_str("ledger.0.iso", at(ledger[0]).iso8601(), "2024-01-15T10:30:00+00:00")
    ck_str("ledger.1.iso", at(ledger[1]).iso8601(), "2024-01-16T10:30:00+00:00")
    ck_str("ledger.2.iso", at(ledger[2]).iso8601(), "2024-01-17T10:30:00+00:00")

    // Verify each successive event is_after the previous (chronological order).
    let mut ordered = true
    let mut i = 1
    while i < ledger.length() {
        let prev = at(ledger[i - 1])
        let cur = at(ledger[i])
        if cur.is_after(prev) == false {
            ordered = false
        }
        i = i + 1
    }
    ck_bool("ledger.ordered", ordered, true)

    // Day-of-week walk: 2024-01-15 is Monday(0), 16 Tue(1), 17 Wed(2).
    ck_int("ledger.0.dow", at(ledger[0]).day_of_week(), 0)
    ck_int("ledger.1.dow", at(ledger[1]).day_of_week(), 1)
    ck_int("ledger.2.dow", at(ledger[2]).day_of_week(), 2)
}

// ============================================================================
// SECTION 12 — ISO week & quarter report
// ============================================================================
fn section_week_quarter() {
    // 2024-01-06 (Sat) is ISO week 1.
    ck_int("wk.jan6", DateTime.parse("2024-01-06T00:00:00+00:00").week_of_year(), 1)
    // 2024-12-30 (Mon) is ISO week 1 of 2025 in ISO-8601 numbering... but chrono
    // week_of_year here returns the ISO week. We assert a mid-year stable value:
    // 2024-07-01 (Mon) is ISO week 27.
    ck_int("wk.jul1", DateTime.parse("2024-07-01T00:00:00+00:00").week_of_year(), 27)

    // Quarter derivation from month (pure int math on month()).
    let q2 = DateTime.parse("2024-05-20T00:00:00+00:00")
    ck_int("q.may", (q2.month() - 1) / 3 + 1, 2)
    let q4 = DateTime.parse("2024-11-20T00:00:00+00:00")
    ck_int("q.nov", (q4.month() - 1) / 3 + 1, 4)
    let q1 = DateTime.parse("2024-02-10T00:00:00+00:00")
    ck_int("q.feb", (q1.month() - 1) / 3 + 1, 1)
}

// ============================================================================
// SECTION 13 — Parse-format-variants matrix
//   Each book-accepted input format (Parsing Strings table) is parsed and its
//   normalized iso8601() is asserted. No-timezone inputs default to UTC.
// ============================================================================
fn section_parse_matrix() {
    // RFC 3339 with offset, normalized to UTC offset string form.
    ck_str("pm.rfc3339",
        DateTime.parse("2024-01-15T10:30:00+00:00").iso8601(),
        "2024-01-15T10:30:00+00:00")
    // ISO with negative offset preserves its offset in iso8601().
    ck_str("pm.iso.neg",
        DateTime.parse("2024-01-15T10:30:00-05:00").iso8601(),
        "2024-01-15T10:30:00-05:00")
    // Date + time, no tz -> assumes UTC.
    ck_str("pm.datetime.notz",
        DateTime.parse("2024-01-15 10:30:00").iso8601(),
        "2024-01-15T10:30:00+00:00")
    // Date + hours:minutes -> seconds zero.
    ck_int("pm.hm.second",
        DateTime.parse("2024-01-15 10:30").second(), 0)
    ck_int("pm.hm.minute",
        DateTime.parse("2024-01-15 10:30").minute(), 30)
    // Date only -> midnight UTC.
    let donly = DateTime.parse("2024-01-15")
    ck_int("pm.dateonly.hour", donly.hour(), 0)
    ck_int("pm.dateonly.minute", donly.minute(), 0)
    ck_int("pm.dateonly.day", donly.day(), 15)
    // Component checks across the negative-offset value (local wall-clock).
    let neg = DateTime.parse("2024-01-15T10:30:00-05:00")
    ck_int("pm.neg.hour", neg.hour(), 10)        // wall-clock hour preserved
    ck_int("pm.neg.utc.hour", neg.to_utc().hour(), 15)  // 10:30-05:00 -> 15:30 UTC
    ck_str("pm.neg.offset", neg.offset(), "-05:00")
}

// ============================================================================
// SECTION 14 — Full-month weekday/weekend census for June 2024
//   June 1 2024 is a Saturday. June has 30 days. Expected:
//   weekdays = 20, weekend days = 10. We walk the month day-by-day.
// ============================================================================
fn section_month_census() {
    let mut cur = DateTime.parse("2024-06-01T00:00:00+00:00")
    let endd = DateTime.parse("2024-06-30T00:00:00+00:00")
    let mut weekdays = 0
    let mut weekends = 0
    let mut total = 0
    while cur.is_before(endd) or cur.is_same_day(endd) {
        if cur.is_weekday() {
            weekdays = weekdays + 1
        } else {
            weekends = weekends + 1
        }
        total = total + 1
        cur = cur.add_days(1)
    }
    ck_int("census.total", total, 30)
    ck_int("census.weekdays", weekdays, 20)
    ck_int("census.weekends", weekends, 10)
    // June 1 2024 is Saturday (dow 5).
    ck_int("census.jun1.dow", DateTime.parse("2024-06-01T00:00:00+00:00").day_of_week(), 5)
    // June 30 2024 is Sunday (dow 6).
    ck_int("census.jun30.dow", DateTime.parse("2024-06-30T00:00:00+00:00").day_of_week(), 6)
}

// ============================================================================
// SECTION 15 — SLA / deadline tracker
//   A ticket opened 2024-06-14T16:00:00Z (Friday) has a 2-business-day SLA.
//   Adding 2 business days lands on 2024-06-18 (Tue). The resolution at
//   2024-06-18T10:00:00Z is BEFORE the deadline end-of-day; assert ordering.
// ============================================================================
fn section_sla() {
    let opened = DateTime.parse("2024-06-14T16:00:00+00:00")
    ck_int("sla.opened.dow", opened.day_of_week(), 4)  // Friday
    let deadline_day = add_business_days(opened, 2)     // Fri -> Mon -> Tue
    ck_str("sla.deadline.date", deadline_day.format("%Y-%m-%d"), "2024-06-18")
    ck_int("sla.deadline.dow", deadline_day.day_of_week(), 1)  // Tuesday

    // Resolution well inside the window.
    let resolved = DateTime.parse("2024-06-18T10:00:00+00:00")
    let deadline_eod = DateTime.parse("2024-06-18T23:59:59+00:00")
    ck_bool("sla.met", resolved.is_before(deadline_eod), true)
    ck_bool("sla.after.open", resolved.is_after(opened), true)

    // Elapsed business handling: open Fri 16:00 to resolved Tue 10:00.
    // Whole-day delta via timestamps (book: unix_timestamp seconds).
    ck_int("sla.elapsed.days", days_between(opened, resolved), 3)  // Fri16->Tue10 ~3.75d floor 3
}

// ============================================================================
// SECTION 16 — Duration ledger (DateTime - DateTime arithmetic)
//   Book: DateTime - DateTime -> Duration; string form PT<seconds>S.
//   We compute a set of known deltas and assert their ISO-duration strings
//   and their second-counts (via unix_timestamp).
// ============================================================================
fn section_duration_ledger() {
    let t0 = DateTime.parse("2024-06-15T00:00:00+00:00")
    let t1 = DateTime.parse("2024-06-15T01:00:00+00:00")   // +1h
    let t2 = DateTime.parse("2024-06-16T00:00:00+00:00")   // +1d
    let t3 = DateTime.parse("2024-06-22T00:00:00+00:00")   // +1w

    ck_str("dur.1h", f"{t1 - t0}", "PT3600S")
    ck_str("dur.1d", f"{t2 - t0}", "PT86400S")
    ck_str("dur.1w", f"{t3 - t0}", "PT604800S")

    // Cross-check via unix_timestamp second deltas.
    ck_int("dur.1h.secs", t1.unix_timestamp() - t0.unix_timestamp(), 3600)
    ck_int("dur.1d.secs", t2.unix_timestamp() - t0.unix_timestamp(), 86400)
    ck_int("dur.1w.secs", t3.unix_timestamp() - t0.unix_timestamp(), 604800)

    // Operator add of duration literals reproduces the same instants.
    ck_int("dur.add.1h.hour", (t0 + 1h).hour(), 1)
    ck_int("dur.add.1d.day", (t0 + 1d).day(), 16)
    ck_int("dur.add.1w.day", (t0 + 1w).day(), 22)
}

// ============================================================================
// SECTION 17 — Anniversary / age calculator using add_months & add_days
//   Birthdate 2000-02-29 (leap). Adding whole years via add_months(12*n).
//   2000-02-29 + 12 months -> 2001-02-28 (clamp, non-leap).
//   + 48 months -> 2004-02-29 (leap again).
// ============================================================================
fn section_anniversary() {
    let birth = DateTime.parse("2000-02-29T00:00:00+00:00")
    ck_int("anniv.birth.day", birth.day(), 29)

    let y1 = birth.add_months(12)
    ck_str("anniv.y1", y1.format("%Y-%m-%d"), "2001-02-28")  // clamp to non-leap
    let y4 = birth.add_months(48)
    ck_str("anniv.y4", y4.format("%Y-%m-%d"), "2004-02-29")  // leap again

    // Days lived from birth to 2000-03-01 = 1 day (Feb 29 -> Mar 1).
    let nextday = DateTime.parse("2000-03-01T00:00:00+00:00")
    ck_int("anniv.daysto.mar1", days_between(birth, nextday), 1)

    // Decade later via add_days. From 2000-02-29, 10 calendar years to
    // 2010-02-28 spans 3652 days (2004 & 2008 are the leap days inside the
    // half-open interval; 2000's Feb 29 is the start point, not counted).
    // So add_days(3652) -> 2010-02-28, and add_days(3653) -> 2010-03-01.
    ck_str("anniv.decade.eve", birth.add_days(3652).format("%Y-%m-%d"), "2010-02-28")
    ck_str("anniv.decade", birth.add_days(3653).format("%Y-%m-%d"), "2010-03-01")
}

// ============================================================================
// SECTION 18 — Cross-timezone DST awareness
//   chrono-tz handles DST. 2024-01-15 12:00 UTC in New York is EST (UTC-5) =>
//   07:00. 2024-06-15 12:00 UTC in New York is EDT (UTC-4) => 08:00. Same zone
//   string, different offset by season.
// ============================================================================
fn section_dst() {
    let winter = DateTime.parse("2024-01-15T12:00:00+00:00")
    let summer = DateTime.parse("2024-06-15T12:00:00+00:00")
    ck_int("dst.ny.winter", winter.to_timezone("America/New_York").hour(), 7)  // EST UTC-5
    ck_int("dst.ny.summer", summer.to_timezone("America/New_York").hour(), 8)  // EDT UTC-4

    // London: winter GMT (UTC+0) => 12:00 ; summer BST (UTC+1) => 13:00.
    ck_int("dst.lon.winter", winter.to_timezone("Europe/London").hour(), 12)
    ck_int("dst.lon.summer", summer.to_timezone("Europe/London").hour(), 13)

    // Tokyo has no DST: both 21:00.
    ck_int("dst.tky.winter", winter.to_timezone("Asia/Tokyo").hour(), 21)
    ck_int("dst.tky.summer", summer.to_timezone("Asia/Tokyo").hour(), 21)

    // Round-trip through a DST zone preserves the instant.
    ck_int("dst.rt.hour", summer.to_timezone("America/New_York").to_utc().hour(), 12)
}

// ============================================================================
// SECTION 19 — Quarter & half-year bucketing report
//   Bucket a set of dates into quarters (pure month math) and verify counts.
//   Dates: Jan(Q1), Feb(Q1), Apr(Q2), Jul(Q3), Sep(Q3), Nov(Q4), Dec(Q4).
//   Expected counts: Q1=2, Q2=1, Q3=2, Q4=2.
// ============================================================================
fn section_quarter_buckets() {
    let mut months: Array<int> = []
    months = months + [DateTime.parse("2024-01-10T00:00:00+00:00").month()]
    months = months + [DateTime.parse("2024-02-10T00:00:00+00:00").month()]
    months = months + [DateTime.parse("2024-04-10T00:00:00+00:00").month()]
    months = months + [DateTime.parse("2024-07-10T00:00:00+00:00").month()]
    months = months + [DateTime.parse("2024-09-10T00:00:00+00:00").month()]
    months = months + [DateTime.parse("2024-11-10T00:00:00+00:00").month()]
    months = months + [DateTime.parse("2024-12-10T00:00:00+00:00").month()]

    let mut q1 = 0
    let mut q2 = 0
    let mut q3 = 0
    let mut q4 = 0
    let mut i = 0
    while i < months.length() {
        let q = (months[i] - 1) / 3 + 1
        if q == 1 { q1 = q1 + 1 }
        if q == 2 { q2 = q2 + 1 }
        if q == 3 { q3 = q3 + 1 }
        if q == 4 { q4 = q4 + 1 }
        i = i + 1
    }
    ck_int("qb.q1", q1, 2)
    ck_int("qb.q2", q2, 1)
    ck_int("qb.q3", q3, 2)
    ck_int("qb.q4", q4, 2)
    ck_int("qb.total", q1 + q2 + q3 + q4, 7)
}

// ============================================================================
// SECTION 20 — Countdown / time-to-event with formatted breakdown
//   From 2024-06-15T12:00:00Z to event 2024-06-18T15:30:00Z.
//   Delta = 3 days 3 hours 30 minutes. Verify each component via second math.
// ============================================================================
fn section_countdown() {
    let now_fixed = DateTime.parse("2024-06-15T12:00:00+00:00")
    let event = DateTime.parse("2024-06-18T15:30:00+00:00")
    let secs = event.unix_timestamp() - now_fixed.unix_timestamp()
    // 3d = 259200, 3h = 10800, 30m = 1800 -> 271800 total.
    ck_int("cd.total.secs", secs, 271800)
    let days = secs / 86400
    let rem1 = secs - days * 86400
    let hours = rem1 / 3600
    let rem2 = rem1 - hours * 3600
    let mins = rem2 / 60
    ck_int("cd.days", days, 3)
    ck_int("cd.hours", hours, 3)
    ck_int("cd.mins", mins, 30)
    let breakdown = f"{days}d {hours}h {mins}m"
    ck_str("cd.breakdown", breakdown, "3d 3h 30m")
    ck_bool("cd.future", event.is_after(now_fixed), true)
}

// ----------------------------------------------------------------------------
// Driver
// ----------------------------------------------------------------------------
section_construction()
section_dayinfo()
section_formatting()
section_timezone()
section_arithmetic()
section_comparisons()
section_business_days()
section_recurrence()
section_tz_board()
section_timesheet()
section_epoch_ledger()
section_week_quarter()
section_parse_matrix()
section_month_census()
section_sla()
section_duration_ledger()
section_anniversary()
section_dst()
section_quarter_buckets()
section_countdown()

if FAILS == 0 {
    print("ALL_CHECKS_PASSED")
} else {
    print(f"FAILURES: {FAILS}")
}
