// N10 — nested/inherited Shared recapture.
// `middle` receives `total` as a SharedCell capture parameter. Creating
// `inner` must retain that raw cell carrier rather than loading its payload.
fn answer() -> int {
  var total = 0
  let middle = || {
    let inner = || { total = total + 42 }
    inner()
  }
  middle()
  total
}
print(answer())
