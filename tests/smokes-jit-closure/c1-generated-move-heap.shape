// ADR-009 C1 slice 4: generated `move` transfers one heap-local share.
annotation add_label() on type {
  comptime post(target, ctx) {
    extend target { method label() -> string { let label = "shape"
      let worker = |; move label| label
      worker() } }
  }
}

@add_label()
type Job { id: int }

let job = Job { id: 1 }
print(job.label())
