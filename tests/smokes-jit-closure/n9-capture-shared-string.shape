// N9 — Shared capture with a refcounted payload.
// The JIT must preserve the explicit SharedCell carrier, retain each projected
// String share, release the displaced "a" share on replacement, and execute
// both the declaring frame and closure body with zero interpreter fallback.
fn answer() -> string {
  var text = "a"
  let append = || { text = text + "bb" }
  append()
  text
}
print(answer())
