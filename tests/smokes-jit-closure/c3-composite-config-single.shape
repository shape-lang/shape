// ADR-009 C3 #14 slice 3 (S3c) — the COMPOSITE-CONFIG zero-fallback smoke,
// SINGLE-carrier shape (charter item (e), primary route): a real annotation
// handler installs a polymorphic BEFORE template with an `Array<int>`
// capture on a 1-ary target (MutationCarrier::Single — deliberately OFF the
// known aggregate-carrier gap, which is S7's named-expected-fallback
// follow-up; 1-ary isolates config-JIT behavior). The S3b bake turns the
// capture into a `let mut cfg: Array<int> = [3, 4]` prologue constant
// inside the suffixed specialized handler — NO config expression, NO
// LoadModuleBinding (the S0 §4 a4d/a4e W39 JIT poison), no per-invocation
// re-eval machinery. Measured S3c 2026-07-20: the baked composite prologue
// reaches native JIT with ZERO fallback lines (the NewTypedArray*-lowering
// contingency was NOT needed).
//
// #65 FENCE: the config array literal is HOISTED to a handler local first —
// `[capture("cfg", [3, 4])]` (an array literal inline in the element
// expression of the TypedObject-element captures array) trips the
// PRE-EXISTING #65 `pending_variable_typed_array_kind` leak. #65 itself is
// pre-existing and NOT fixed in S3.
//
// Hot loop of 200 calls crosses T1@100. The annotation `comptime post`
// handler is NOT a top-level comptime block (parse-based vacuity guard).
//
// Value-distinguishing arithmetic, per call i in 0..200:
//   before: a0 = 2i + cfg[0]*10 + cfg.length() = 2i + 32
//   impl:   * 10 → 20i + 320;  sum = 20*19900 + 320*200 = 462000
// Expected stdout: 462000
//   skipped before      → sum 10i        = 199000
//   cfg[1] read as cfg[0] → bump 42      = 482000
//   length dropped      → bump 30        = 458000
fn tmpl<Args>(args: Args, cfg: Array<int>) -> Args {
  args[0] = args[0] * 2 + cfg[0] * 10 + cfg.length()
  return args
}

annotation hooked() {
  targets: [function]
  comptime post(target, ctx) {
    let cfg = [3, 4]
    install(before_hook(tmpl, [capture("cfg", cfg)]))
  }
}

@hooked()
fn calc(a: int) -> int { a * 10 }

fn run() -> int {
  let mut total = 0
  for i in 0..200 { total = total + calc(i) }
  total
}
print(run())
