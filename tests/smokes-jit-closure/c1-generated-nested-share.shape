// ADR-009 C1 slice 4 / #53: the nested closure recaptures the SAME cell.
annotation add_answer() {
  targets: [type]
  comptime post(target, ctx) {
    extend target { method answer() -> int { var total = 40
      let outer = |; share total| {
        let inner = |step: int; share total| { total = total + step
          total }
        inner(2)
        total }
      outer() } }
  }
}

@add_answer()
type Job { id: int }

let job = Job { id: 1 }
print(job.answer())
